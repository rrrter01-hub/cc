-- =========================================================================
RunService.Heartbeat:Connect(function()
    if AppState.IsRetreating then return end
    if not AppState.IsHunting or not AppState.SelectedPlayer then return end

    local myChar = GetChar(LocalPlayer)
    local myRoot = GetRoot(myChar)
    local myHum = GetHum(myChar)

    if not myChar or not myRoot or not myHum or myHum.Health <= 0 then
        StopHunt("Player Died")
        return
    end

    local currentHpPercent = (myHum.Health / math.max(1, myHum.MaxHealth)) * 100

    -- Emergency Sky Heal
    if Config.EmergencyEscape and (currentHpPercent <= Config.EmergencyHPThreshold or AppState.IsHealingInSky) then
        if currentHpPercent < Config.RecoveryHPThreshold then
            AppState.IsHealingInSky = true
            AppState.CurrentCombatStatus = string.format("EMERGENCY ESCAPE: Healing (%d%% HP)", math.floor(currentHpPercent))
            
            ApplyModernPhysics(myRoot)
            EnsureKen()
            EnsureBuso()
            
            local skyPos = Vector3.new(myRoot.Position.X, Config.MaxSkyAltitude, myRoot.Position.Z)
            local diff = skyPos - myRoot.Position
            local lv = myRoot:FindFirstChild("BountyLV")
            if lv then
                lv.VectorVelocity = diff.Magnitude > 15 and diff.Unit * Config.FlySpeed or Vector3.zero
            end
            return
        else
            AppState.IsHealingInSky = false
        end
    end

    local targetPlayer = AppState.SelectedPlayer
    local st = StatusCache[targetPlayer]

    -- ตรวจสอบว่าเป้าหมายตายหรือไม่
    if not st or not st.IsAlive or not st.Char or not st.Char.Parent then
        TriggerMaxSkyRetreat()
        return
    end

    -- SafeZone / PvP Validation
    if st.InSafeZone or not st.PvPEnabled then
        StopHunt("Disengaged: " .. (st.InSafeZone and "In SafeZone" or "PvP Disabled"))
        return
    end

    local targetRoot = st.Root
    if not targetRoot then return end

    EnsureBuso()
    EnsureKen()
    TriggerRaceSkill()
    ApplyModernPhysics(myRoot)

    local stickCFrame = targetRoot.CFrame * CFrame.new(0, Config.HeightOffset, Config.StickDistance)
    local targetPos = stickCFrame.Position
    local currentPos = myRoot.Position
    local dist = (targetPos - currentPos).Magnitude

    local lv = myRoot:FindFirstChild("BountyLV")
    local ao = myRoot:FindFirstChild("BountyAO")

    if ao then
        ao.CFrame = CFrame.lookAt(myRoot.Position, targetRoot.Position)
    end

    if dist > 3.0 then
        AppState.CurrentCombatStatus = "Rushing to Target (" .. math.floor(dist) .. "m)"
        local dir = (targetPos - currentPos).Unit
        if lv then
            lv.VectorVelocity = dir * math.min(Config.FlySpeed, math.max(60, dist * 25))
        end
    else
        if lv then lv.VectorVelocity = Vector3.zero end
        myRoot.CFrame = CFrame.lookAt(targetPos, targetRoot.Position)
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetRoot.Position)
        AppState.CurrentCombatStatus = "Executing M1 Combo Chain..."
    end
end)

