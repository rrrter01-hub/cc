-- =========================================================================
-- PHYSICS & MOVEMENT CONTROLLER
-- =========================================================================
local function ApplyPhysics(myRoot)
    if not myRoot then return end
    local bv = myRoot:FindFirstChild("BountyBV") or Instance.new("BodyVelocity")
    bv.Name = "BountyBV"
    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bv.Velocity = Vector3.zero
    bv.Parent = myRoot

    local bg = myRoot:FindFirstChild("BountyBG") or Instance.new("BodyGyro")
    bg.Name = "BountyBG"
    bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bg.P = 15000
    bg.Parent = myRoot
end

local function RemovePhysics(myRoot)
    if not myRoot then return end
    if myRoot:FindFirstChild("BountyBV") then myRoot.BountyBV:Destroy() end
    if myRoot:FindFirstChild("BountyBG") then myRoot.BountyBG:Destroy() end
end

RunService.Stepped:Connect(function()
    if AppState.IsHunting or AppState.IsHealingInSky or AppState.IsRetreating then
        local myChar = GetChar(LocalPlayer)
        if myChar then
            for _, part in ipairs(myChar:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end
end)

local function StopHunt(reason)
    AppState.IsHunting = false
    AppState.IsHealingInSky = false
    AppState.CurrentCombatStatus = reason or "Idle"
    local myChar = GetChar(LocalPlayer)
    RemovePhysics(GetRoot(myChar))
end

-- =========================================================================
-- POST-KILL RETREAT CONTROLLER
-- =========================================================================
local function TriggerSafeRetreat()
    if AppState.IsRetreating then return end
    AppState.IsHunting = false
    AppState.IsRetreating = true
    AppState.CurrentCombatStatus = "Target Eliminated! Retreating to Safe Sky..."

    task.spawn(function()
        local start = tick()
        while tick() - start < Config.PostKillRetreatDuration do
            local myChar = GetChar(LocalPlayer)
            local myRoot = GetRoot(myChar)
            if myRoot then
                ApplyPhysics(myRoot)
                local safePos = Vector3.new(myRoot.Position.X, Config.EscapeSkyAltitude, myRoot.Position.Z)
                local diff = safePos - myRoot.Position
                local bv = myRoot:FindFirstChild("BountyBV")
                if bv then
                    bv.Velocity = diff.Magnitude > 10 and diff.Unit * Config.FlySpeed or Vector3.zero
                end
            end
            task.wait(0.05)
        end

        local myChar = GetChar(LocalPlayer)
        local myRoot = GetRoot(myChar)
        local bv = myRoot and myRoot:FindFirstChild("BountyBV")
        if bv then bv.Velocity = Vector3.zero end

        AppState.IsRetreating = false
        AppState.SelectedPlayer = nil
        StopHunt("Hunt Finished (Safe)")
    end)
end

-- =========================================================================
-- MAIN ENGINE LOOP
-- =========================================================================
RunService.Heartbeat:Connect(function()
    if AppState.IsRetreating then return end
    if not AppState.IsHunting or not AppState.SelectedPlayer then return end

    local myChar = GetChar(LocalPlayer)
    local myRoot = GetRoot(myChar)
    local myHum = GetHum(myChar)

    if not myChar or not myRoot or not myHum or myHum.Health <= 0 then
        StopHunt("Player Dead")
        return
    end

    local currentHpPercent = (myHum.Health / math.max(1, myHum.MaxHealth)) * 100

    -- Emergency Sky Heal
    if Config.EmergencyEscape and (currentHpPercent <= Config.EmergencyHPThreshold or AppState.IsHealingInSky) then
        if currentHpPercent < Config.RecoveryHPThreshold then
            AppState.IsHealingInSky = true
            AppState.CurrentCombatStatus = string.format("HEALING: Sky Camp (%d%% HP)", math.floor(currentHpPercent))
            
            ApplyPhysics(myRoot)
            EnsureKen()
            
            local skyPos = Vector3.new(myRoot.Position.X, Config.EscapeSkyAltitude, myRoot.Position.Z)
            local diff = skyPos - myRoot.Position
            local bv = myRoot:FindFirstChild("BountyBV")
            if bv then
                bv.Velocity = diff.Magnitude > 10 and diff.Unit * Config.FlySpeed or Vector3.zero
            end
            return
        else
            AppState.IsHealingInSky = false
        end
    end

    local targetChar = GetChar(AppState.SelectedPlayer)
    local targetHum = GetHum(targetChar)
    local targetRoot = GetRoot(targetChar)

    -- ตรวจสอบการตายของเป้าหมาย
    if not targetChar or not targetHum or targetHum.Health <= 0 or not targetChar.Parent then
        TriggerSafeRetreat()
        return
    end

    -- ตรวจสอบ SafeZone / PvP
    local st = CheckTargetStatus(AppState.SelectedPlayer)
    if not st.CanAttack then
        StopHunt("Disengaged: " .. st.Reason)
        return
    end

    if not targetRoot then return end

    EnsureBuso()
    EnsureKen()
    TriggerRaceSkill()
    ApplyPhysics(myRoot)

    -- คำนวณตำแหน่งประกบหลัง 1.2 Studs
    local stickCFrame = targetRoot.CFrame * CFrame.new(0, Config.HeightOffset, Config.StickDistance)
    local targetPos = stickCFrame.Position
    local currentPos = myRoot.Position
    local dist = (targetPos - currentPos).Magnitude

    local bg = myRoot:FindFirstChild("BountyBG")
    if bg then
        bg.CFrame = CFrame.lookAt(myRoot.Position, targetRoot.Position)
    end

    if dist > 3.5 then
        AppState.CurrentCombatStatus = "Rushing to Target (" .. math.floor(dist) .. "m)"
        local dir = (targetPos - currentPos).Unit
        local bv = myRoot:FindFirstChild("BountyBV")
        if bv then
            bv.Velocity = dir * math.min(Config.FlySpeed, dist * 30)
        end
    else
        local bv = myRoot:FindFirstChild("BountyBV")
        if bv then bv.Velocity = Vector3.zero end
        
        myRoot.CFrame = CFrame.lookAt(targetPos, targetRoot.Position)
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetRoot.Position)
        AppState.CurrentCombatStatus = "Executing M1 Combo Chain..."
    end
end)

