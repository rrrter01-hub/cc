-- =========================================================================
-- 3. NAVIGATION & TWEEN ENGINE (ANTI-RUBBERBAND)
-- =========================================================================
local function cancelCurrentTween()
    if SeaState.ActiveTween then
        SeaState.ActiveTween:Cancel()
        SeaState.ActiveTween = nil
    end
end

local function smoothMoveTo(targetPos, speed)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    speed = speed or Settings.TweenSpeed
    local distance = (hrp.Position - targetPos).Magnitude
    if distance < 6 then return true end

    local time = distance / speed
    local tweenInfo = TweenInfo.new(time, Enum.EasingStyle.Linear)
    
    cancelCurrentTween()
    SeaState.ActiveTween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos)})
    
    hrp.Velocity = Vector3.zero
    SeaState.ActiveTween:Play()
    
    local completed = false
    local conn
    conn = SeaState.ActiveTween.Completed:Connect(function(playbackState)
        if playbackState == Enum.PlaybackState.Completed then
            completed = true
        end
        conn:Disconnect()
    end)

    while not completed and SeaState.ActiveTween do
        if Settings.AutoSeaHunt and workspace:FindFirstChild("Enemies") and workspace.Enemies:FindFirstChild("Sea Beast") then
            cancelCurrentTween()
            return true
        end
        task.wait(0.1)
    end

    if hrp then hrp.Velocity = Vector3.zero end
    return true
end

