-- =========================================================================
-- POST-KILL MAXIMUM SKY RETREAT (1,600 STUDS)
-- =========================================================================
local function TriggerSkyRetreat()
    if AppState.CurrentState == "SKY_RETREAT" then return end
    AppState.CurrentState = "SKY_RETREAT"
    AppState.StatusMessage = string.format("Kill Confirmed! Ascending to Max Sky (%dm)...", Config.MaxSkyAltitude)

    task.spawn(function()
        local start = tick()
        while (tick() - start < Config.PostKillDuration) do
            local myChar = GetChar(LocalPlayer)
            local myRoot = GetRoot(myChar)
            local myHum = GetHum(myChar)

            if myRoot and myHum and myHum.Health > 0 then
                local bv, bg = ApplyPhysics(myRoot)
                EnsureKen()
                EnsureBuso()
                
                local maxSkyPos = Vector3.new(myRoot.Position.X, Config.MaxSkyAltitude, myRoot.Position.Z)
                local diff = maxSkyPos - myRoot.Position
                if bv then
                    bv.Velocity = diff.Magnitude > 15 and diff.Unit * (Config.FlySpeed + 100) or Vector3.zero
                end
                if bg then
                    bg.CFrame = CFrame.lookAt(myRoot.Position, myRoot.Position + Vector3.new(0, 1, 0))
                end
            end
            task.wait(0.04)
        end

        local myChar = GetChar(LocalPlayer)
        local myRoot = GetRoot(myChar)
        local bv = myRoot and myRoot:FindFirstChild("TitanBV")
        if bv then bv.Velocity = Vector3.zero end

        if Config.AutoTarget then
            local nextTarget = FindBestTarget()
            if nextTarget then
                AppState.SelectedPlayer = nextTarget
                AppState.CurrentState = "TRAVEL"
            else
                StopHunt("All Targets Cleared")
            end
        else
            StopHunt("Target Eliminated")
        end
    end)
end

-- =========================================================================
-- INDEPENDENT COMBAT LOOPS (M1 & SKILL WEAVING)
-- =========================================================================
-- 1. M1 Fast Attack Loop (Always running when in COMBAT state)
task.spawn(function()
    while true do
        if AppState.CurrentState == "COMBAT" and AppState.SelectedPlayer then
            local targetChar = GetChar(AppState.SelectedPlayer)
            local myChar = GetChar(LocalPlayer)
            local targetRoot = GetRoot(targetChar)
            local myRoot = GetRoot(myChar)

            if targetChar and targetRoot and myRoot and targetChar.Parent then
                local dist = (targetRoot.Position - myRoot.Position).Magnitude
                if dist <= 35 then
                    FireFastAttack(targetChar, targetRoot)
                end
            end
        end
        task.wait(Config.M1AttackSpeed)
    end
end)

-- 2. Non-blocking Skill Weaving Loop (Z, X, C, V)
local skillKeys = { Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V }
task.spawn(function()
    while true do
        if AppState.CurrentState == "COMBAT" and AppState.SelectedPlayer and Config.EnableSkills then
            local targetChar = GetChar(AppState.SelectedPlayer)
            local targetRoot = GetRoot(targetChar)
            local targetHum = GetHum(targetChar)

            if targetChar and targetRoot and targetHum and targetHum.Health > 0 then
                for _, weaponName in ipairs(Config.WeaponOrder) do
                    if AppState.CurrentState ~= "COMBAT" then break end
                    local tool = EquipWeapon(weaponName)
                    if tool then
                        for _, key in ipairs(skillKeys) do
                            if AppState.CurrentState ~= "COMBAT" then break end
                            pcall(function()
                                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetRoot.Position)
                                VirtualInputManager:SendKeyEvent(true, key, false, game)
                                task.wait(0.04)
                                VirtualInputManager:SendKeyEvent(false, key, false, game)
                            end)
                            task.wait(Config.SkillCooldown)
                        end
                    end
                end
            end
        end
        task.wait(0.8)
    end
end)

-- =========================================================================
-- MASTER HEARTBEAT STATE CONTROLLER & KINETIC NAVIGATOR
-- =========================================================================
RunService.Heartbeat:Connect(function(dt)
    if AppState.CurrentState == "IDLE" or AppState.CurrentState == "SKY_RETREAT" then return end

    local myChar = GetChar(LocalPlayer)
    local myRoot = GetRoot(myChar)
    local myHum = GetHum(myChar)

    if not myChar or not myRoot or not myHum or myHum.Health <= 0 then
        StopHunt("Player Dead")
        return
    end

    local currentHpPercent = (myHum.Health / math.max(1, myHum.MaxHealth)) * 100

    -- 1. Emergency Sky Healing Check
    if currentHpPercent <= Config.EmergencyHPThreshold or AppState.CurrentState == "SKY_HEAL" then
        if currentHpPercent < Config.RecoveryHPThreshold then
            AppState.CurrentState = "SKY_HEAL"
            AppState.StatusMessage = string.format("EMERGENCY RETREAT: Sky Healing (%d%% HP)", math.floor(currentHpPercent))
            
            local bv, bg = ApplyPhysics(myRoot)
            EnsureKen()
            EnsureBuso()
            
            local skyPos = Vector3.new(myRoot.Position.X, Config.MaxSkyAltitude, myRoot.Position.Z)
            local diff = skyPos - myRoot.Position
            if bv then
                bv.Velocity = diff.Magnitude > 15 and diff.Unit * Config.FlySpeed or Vector3.zero
            end
            if bg then
                bg.CFrame = CFrame.lookAt(myRoot.Position, myRoot.Position + Vector3.new(0, 1, 0))
            end
            return
        else
            AppState.CurrentState = "TRAVEL"
        end
    end

    -- 2. Validate Target
    local target = AppState.SelectedPlayer
    local targetChar = GetChar(target)
    local targetHum = GetHum(targetChar)
    local targetRoot = GetRoot(targetChar)

    if not target or not targetChar or not targetHum or targetHum.Health <= 0 or not targetChar.Parent then
        TriggerSkyRetreat()
        return
    end

    local st = CheckTargetStatus(target)
    if not st.CanAttack then
        if Config.AutoTarget then
            local nextTarget = FindBestTarget()
            if nextTarget then
                AppState.SelectedPlayer = nextTarget
                AppState.CurrentState = "TRAVEL"
                return
            end
        end
        StopHunt("Target Disengaged: " .. st.Reason)
        return
    end

    if not targetRoot then return end

    -- 3. Maintain Buffs
    EnsureKen()
    EnsureBuso()
    TriggerRaceV3()
    TriggerRaceV4()

    -- 4. Calculate Precision Blindspot Anchor (1.1 studs behind target spine)
    local targetLook = targetRoot.CFrame.LookVector
    local blindspotPos = targetRoot.Position - (targetLook * Config.StickDistance) + Vector3.new(0, Config.HeightOffset, 0)
    
    local currentPos = myRoot.Position
    local distToBlindspot = (blindspotPos - currentPos).Magnitude

    local bv, bg = ApplyPhysics(myRoot)

    -- 5. State Handling: TRAVEL vs COMBAT
    if distToBlindspot > 3.0 then
        AppState.CurrentState = "TRAVEL"
        AppState.StatusMessage = string.format("Intercepting target (%dm)...", math.floor(distToBlindspot))
        
        local dir = (blindspotPos - currentPos).Unit
        if bv then
            bv.Velocity = dir * math.min(Config.FlySpeed, distToBlindspot * 35)
        end
        if bg then
            bg.CFrame = CFrame.lookAt(myRoot.Position, targetRoot.Position)
        end
    else
        AppState.CurrentState = "COMBAT"
        AppState.StatusMessage = "Titan Lock: Blindspot Stun & Shredding"
        
        if bv then
            -- Match target velocity to eliminate rubberband drifting
            local targetVel = targetRoot.AssemblyLinearVelocity or targetRoot.Velocity or Vector3.zero
            bv.Velocity = targetVel
        end
        if bg then
            bg.CFrame = CFrame.lookAt(myRoot.Position, targetRoot.Position)
        end
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetRoot.Position)
    end
end)

