-- Function to Render Player Row
local function RenderPlayerRow(player)
    local st = CheckPlayerStatus(player)
    local pBounty = GetPlayerBounty(player)

    local Row = Instance.new("Frame")
    Row.Size = UDim2.new(1, -8, 0, 42)
    Row.BackgroundColor3 = (AppState.SelectedPlayer == player) and Color3.fromRGB(40, 50, 75) or Color3.fromRGB(22, 26, 36)
    Row.Parent = ScrollList
    Instance.new("UICorner", Row).CornerRadius = UDim.new(0, 6)

    -- Status Indicators
    local pvpTag = st.InSafeZone and "<font color='#FFD700'>[SAFE ZONE]</font>" 
        or (not st.IsPvPEnabled and "<font color='#A0A0A0'>[PVP OFF]</font>") 
        or "<font color='#00FF7F'>[PVP READY]</font>"

    local Info = Instance.new("TextLabel")
    Info.Size = UDim2.new(0.65, 0, 1, 0)
    Info.Position = UDim2.new(0, 8, 0, 0)
    Info.BackgroundTransparency = 1
    Info.RichText = true
    Info.Font = Enum.Font.Gotham
    Info.TextSize = 11
    Info.TextColor3 = Color3.fromRGB(240, 240, 240)
    Info.TextXAlignment = Enum.TextXAlignment.Left
    Info.Text = string.format("<b>%s</b> %s<br/>Bounty: %s | HP: %d%% | Dist: %dm", 
        player.DisplayName, pvpTag, tostring(pBounty), math.floor((st.Health/math.max(1, st.MaxHealth))*100), st.Distance)
    Info.Parent = Row

    -- Spy Cam Button
    local CamBtn = Instance.new("TextButton")
    CamBtn.Size = UDim2.new(0, 55, 0, 26)
    CamBtn.Position = UDim2.new(0.68, 0, 0.5, -13)
    CamBtn.BackgroundColor3 = Color3.fromRGB(48, 85, 150)
    CamBtn.Text = (AppState.IsSpectating and AppState.SelectedPlayer == player) and "UNSPY" or "SPY"
    CamBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    CamBtn.Font = Enum.Font.GothamBold
    CamBtn.TextSize = 10
    CamBtn.Parent = Row
    Instance.new("UICorner", CamBtn).CornerRadius = UDim.new(0, 4)

    CamBtn.MouseButton1Click:Connect(function()
        local isSpying = ToggleSpyCam(player)
        CamBtn.Text = isSpying and "UNSPY" or "SPY"
        StatusLabel.Text = isSpying and ("Spectating: " .. player.DisplayName) or ("Target: " .. player.DisplayName)
    end)

    -- Select Target Button
    local SelectBtn = Instance.new("TextButton")
    SelectBtn.Size = UDim2.new(0, 55, 0, 26)
    SelectBtn.Position = UDim2.new(0.82, 0, 0.5, -13)
    SelectBtn.BackgroundColor3 = st.CanAttack and Color3.fromRGB(40, 167, 69) or Color3.fromRGB(70, 75, 85)
    SelectBtn.Text = "SELECT"
    SelectBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    SelectBtn.Font = Enum.Font.GothamBold
    SelectBtn.TextSize = 10
    SelectBtn.Parent = Row
    Instance.new("UICorner", SelectBtn).CornerRadius = UDim.new(0, 4)

    SelectBtn.MouseButton1Click:Connect(function()
        AppState.SelectedPlayer = player
        StatusLabel.Text = string.format("Locked on: %s (%s)", player.DisplayName, st.CanAttack and "Ready" or "Cannot Attack")
    end)
end

local function RefreshRadar()
    for _, child in ipairs(ScrollList:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            RenderPlayerRow(player)
        end
    end
    ScrollList.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 10)
end

-- Refresh Radar Every 2 Seconds
task.spawn(function()
    while true do
        RefreshRadar()
        task.wait(2)
    end
end)

