-- INSTANT NORMAL MOVEMENT RESTORE (คืนค่าการเดินปกติ 100% หลังฆ่า)
-- =========================================================================
local function RestoreNormalMovement()
    local myChar = GetChar(LocalPlayer)
    local myRoot = GetRoot(myChar)
    local myHum = GetHum(myChar)

    if myRoot then
        if myRoot:FindFirstChild("BountyBV") then myRoot.BountyBV:Destroy() end
        if myRoot:FindFirstChild("BountyBG") then myRoot.BountyBG:Destroy() end
        for _, obj in ipairs(myRoot:GetChildren()) do
            if obj:IsA("BodyVelocity") or obj:IsA("BodyGyro") or obj:IsA("BodyPosition") or obj:IsA("LinearVelocity") or obj:IsA("AlignPosition") then
                obj:Destroy()
            end
        end
    end

    if myHum then
        myHum.PlatformStand = false
        myHum.Sit = false
    end

    if not AppState.IsSpectating and myHum then
        Camera.CameraSubject = myHum
    end
end

local function StopHunt(reason)
    AppState.IsHunting = false
    AppState.IsHealingInSpace = false
    AppState.SelectedPlayer = nil
    AppState.CurrentCombatStatus = reason or "Idle (Movement 100% Free)"
    RestoreNormalMovement()
end

-- =========================================================================
-- WEAPON CONTROLLER (SMART MULTI-WEAPON EQUIPPER)
-- =========================================================================
local function EquipWeaponCategory(category)
    local char = GetChar(LocalPlayer)
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local hum = GetHum(char)
    if not char or not hum then return nil end

    local currentTool = char:FindFirstChildOfClass("Tool")
    if currentTool then
        local tType = currentTool.ToolTip ~= "" and currentTool.ToolTip or (currentTool:GetAttribute("WeaponType") or "")
        if tType:lower():find(category:lower()) or currentTool.Name:lower():find(category:lower()) then
            return currentTool
        end
    end

    if bp then
        for _, tool in ipairs(bp:GetChildren()) do
            if tool:IsA("Tool") then
                local tType = tool.ToolTip ~= "" and tool.ToolTip or (tool:GetAttribute("WeaponType") or "")
                if tType:lower():find(category:lower()) or tool.Name:lower():find(category:lower()) then
                    hum:EquipTool(tool)
                    return tool
                end
            end
        end
    end
    return currentTool
end

