-- 1. Auto Sea Beast Hunter Loop
local function setSeaState(newState)
    print(string.format("[Sea Hunter] Transition: %s ➔ %s", SeaState.Current, newState))
    SeaState.Current = newState
    SeaState.StateStartTime = os.time()
end

task.spawn(function()
    while task.wait(0.1) do
        if Settings.AutoSeaHunt then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChild("Humanoid")
                if not (hrp and hum and hum.Health > 0) then return end

                if (os.time() - SeaState.StateStartTime) > Settings.WatchdogTimeout then
                    if SeaState.Current ~= "STAGE_5_COMBAT" then
                        warn("[Watchdog] Timeout detected. Resetting to Stage 1...")
                        cancelCurrentTween()
                        setSeaState("STAGE_6_RESET")
                        return
                    end
                end

                if SeaState.Current == "STAGE_1_PREPARE" then
                    smoothMoveTo(SEA_WAYPOINTS.TikiPort + Vector3.new(0, 10, 0), 280)
                    task.wait(0.5)
                    pcall(function() CommF:InvokeServer("BuyBoat", Settings.BoatType) end)
                    task.wait(1)
                    SeaState.SailingStartTime = os.time()
                    setSeaState("STAGE_2_TRANSIT")

                elseif SeaState.Current == "STAGE_2_TRANSIT" then
                    local entity, root = scanSeaTargets()
                    if entity and root then
                        cancelCurrentTween()
                        SeaState.TargetEntity = entity
                        SeaState.TargetRootPart = root
                        setSeaState("STAGE_5_COMBAT")
                        return
                    end

                    smoothMoveTo(SEA_WAYPOINTS.Zone1_Entry, Settings.TweenSpeed)
                    smoothMoveTo(SEA_WAYPOINTS.Zone2_3, Settings.TweenSpeed)
                    smoothMoveTo(SEA_WAYPOINTS.Zone4_5, Settings.TweenSpeed)
                    smoothMoveTo(SEA_WAYPOINTS.Zone6_Apex, Settings.TweenSpeed)
                    setSeaState("STAGE_3_PATROL")

                elseif SeaState.Current == "STAGE_3_PATROL" then
                    local entity, root = scanSeaTargets()
                    if entity and root then
                        cancelCurrentTween()
                        SeaState.TargetEntity = entity
                        SeaState.TargetRootPart = root
                        setSeaState("STAGE_5_COMBAT")
                    else
                        local patrolOffset = Vector3.new(math.random(-400, 400), 0, math.random(-400, 400))
                        smoothMoveTo(SEA_WAYPOINTS.Zone6_Apex + patrolOffset, 160)
                        task.wait(1.5)
                    end

                elseif SeaState.Current == "STAGE_5_COMBAT" then
                    local target = SeaState.TargetEntity
                    local root = SeaState.TargetRootPart
                    if target and target:FindFirstChild("Humanoid") and target.Humanoid.Health > 0 and root then
                        local hoverPos = root.Position + Vector3.new(0, Settings.SafeCombatHeight, 0)
                        hrp.CFrame = CFrame.lookAt(hoverPos, root.Position)
                        hrp.Velocity = Vector3.zero
                        equipSelectedWeapon(Settings.SelectedWeapon)
                        executeAttackCombo(root)
                    else
                        local nextEnt, nextRoot = scanSeaTargets()
                        if nextEnt and nextRoot then
                            SeaState.TargetEntity = nextEnt
                            SeaState.TargetRootPart = nextRoot
                            SeaState.StateStartTime = os.time()
                        else
                            setSeaState("STAGE_6_RESET")
                        end
                    end

                elseif SeaState.Current == "STAGE_6_RESET" then
                    SeaState.TargetEntity = nil
                    SeaState.TargetRootPart = nil
                    cancelCurrentTween()
                    task.wait(2)
                    setSeaState("STAGE_1_PREPARE")
                end
            end)
        end
    end
end)

-- 2. Auto Farm Level & Quests Loop
local function getCurrentQuestInfo()
    local level = (LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Level") and LocalPlayer.Data.Level.Value) or 1
    local bestQuest = QuestDatabase[1]
    for _, q in ipairs(QuestDatabase) do
        if level >= q.Level then bestQuest = q else break end
    end
    return bestQuest
end

local function isQuestActive()
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    return pGui and pGui:FindFirstChild("Main") and pGui.Main:FindFirstChild("Quest") and pGui.Main.Quest.Visible
end

local function getActiveEnemy(mobName)
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return nil end
    for _, enemy in ipairs(enemies:GetChildren()) do
        if enemy.Name == mobName and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
            return enemy
        end
    end
    return nil
end

