-- FORCE COMBAT TAGGER: ส่ง Hit Packet บังคับติด In-Combat Timer ทันที
local function ForceCombatTag(targetChar, targetRoot)
    if not Config.EnableForceCombat or not targetChar or not targetRoot then return end
    if tick() - AppState.LastTagTick < 0.25 then return end
    AppState.LastTagTick = tick()

    if RegisterAttack then pcall(function() RegisterAttack:FireServer(0) end) end
    if RegisterHit then
        pcall(function()
            RegisterHit:FireServer(targetRoot, { { targetChar, targetRoot } })
            Stats.CombatTagsInflicted = Stats.CombatTagsInflicted + 1
        end)
    end
end

local comboCounter = 1
local function FireFastAttack()
    local myChar = GetChar(LocalPlayer)
    local myHum = GetHum(myChar)
    if not myChar or not myHum or myHum.Health <= 0 then return end

    myHum.Sit = false
    myHum.PlatformStand = false

    local targetChar = AppState.SelectedPlayer and GetChar(AppState.SelectedPlayer)
    local targetRoot = targetChar and GetRoot(targetChar)
    local targetHum = targetChar and GetHum(targetChar)

    local controller = ResolveCombatController()
    if controller then
        pcall(function()
            controller.hitboxMagnitude = Config.HitboxSize
            controller.timeToNextAttack = 0
            controller.hitAttempts = 0
            controller.attacking = false
            controller.blocking = false
            comboCounter = (comboCounter % 4) + 1
            controller.increment = comboCounter
            if controller.attack then controller:attack() end
        end)
    end

    if RegisterAttack then pcall(function() RegisterAttack:FireServer(0) end) end
    if RegisterHit and targetRoot and targetHum and targetHum.Health > 0 then
        pcall(function()
            RegisterHit:FireServer(targetRoot, { { targetChar, targetRoot } })
        end)
    end

    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(0, 0))
        VirtualUser:Button1Up(Vector2.new(0, 0))
    end)
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
    end)
end

-- สลับคอมโบสกิล Z, X, C, V
local skillKeys = { Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V }
local function ExecuteSkillCombo()
    if not Config.EnableSkillCombo then return end
    local targetChar = AppState.SelectedPlayer and GetChar(AppState.SelectedPlayer)
    local targetRoot = targetChar and GetRoot(targetChar)
    if not targetRoot then return end

    for _, weaponName in ipairs(Config.WeaponOrder) do
        local tool = EquipWeapon(weaponName)
        if tool then
            for _, key in ipairs(skillKeys) do
                if not AppState.IsHunting or AppState.IsHealingInSky or AppState.IsRetreating then break end
                pcall(function()
                    Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetRoot.Position)
                    VirtualInputManager:SendKeyEvent(true, key, false, game)
                    task.wait(0.03)
                    VirtualInputManager:SendKeyEvent(false, key, false, game)
                end)
                task.wait(Config.SkillDelay)
            end
        end
    end
end

