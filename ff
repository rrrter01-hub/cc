local function HookTargetAnimationSniffer(targetPlayer)
    if AppState.TargetAnimTrack then
        AppState.TargetAnimTrack:Disconnect()
        AppState.TargetAnimTrack = nil
    end

    local targetChar = GetChar(targetPlayer)
    local targetHum = GetHum(targetChar)
    if not targetHum then return end

    local animator = targetHum:FindFirstChildOfClass("Animator") or targetHum
    AppState.TargetAnimTrack = animator.AnimationPlayed:Connect(function(animTrack)
        if not Config.EnableAutoDodge or not AppState.IsHunting then return end
        local animName = animTrack.Animation and animTrack.Animation.Name:lower() or ""

        if animName:find("attack") or animName:find("slash") or animName:find("cast") or animName:find("skill") or animName:find("punch") or animName:find("shoot") then
            if tick() - AppState.LastDodgeTick > 0.4 then
                AppState.LastDodgeTick = tick()
                Stats.DodgedAttacks = Stats.DodgedAttacks + 1

                local myChar = GetChar(LocalPlayer)
                local myRoot = GetRoot(myChar)
                local targetRoot = GetRoot(targetChar)

                if myRoot and targetRoot then
                    local flankOffset = (targetRoot.CFrame.RightVector * (math.random() > 0.5 and 9 or -9)) + Vector3.new(0, 8, 0)
                    myRoot.CFrame = CFrame.lookAt(targetRoot.Position + flankOffset, targetRoot.Position)
                    PerformEvasiveDash()
                    EnsureKen()
                end
            end
        end
    end)
end

