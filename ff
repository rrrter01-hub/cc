-- =========================================================================
-- POST-KILL SKY RETREAT & KILL TRACKER
-- =========================================================================
local function TriggerMaxSkyRetreat()
    if AppState.IsRetreating then return end
    
    -- บันทึกประวัติการฆ่าเพื่อคำนวณ Cooldown 3/3 ครั้ง
    if AppState.SelectedPlayer then
        local victimId = AppState.SelectedPlayer.UserId
        local hist = PlayerKillHistory[victimId] or { Kills = 0, LastKillTick = 0 }
        hist.Kills = hist.Kills + 1
        hist.LastKillTick = tick()
        PlayerKillHistory[victimId] = hist
    end

    AppState.IsHunting = false
    AppState.IsRetreating = true
    AppState.CurrentCombatStatus = string.format("KILL SECURED! Ascending to Max Sky (%dm)...", Config.MaxSkyAltitude)

    task.spawn(function()
        local start = tick()
        while (tick() - start < Config.PostKillSkyDuration) do
            local myChar = GetChar(LocalPlayer)
            local myRoot = GetRoot(myChar)
            local myHum = GetHum(myChar)

            if myRoot and myHum and myHum.Health > 0 then
                ApplyModernPhysics(myRoot)
                EnsureKen()
                EnsureBuso()
                
                local lv = myRoot:FindFirstChild("BountyLV")
                local ao = myRoot:FindFirstChild("BountyAO")
                
                local maxSkyPos = Vector3.new(myRoot.Position.X, Config.MaxSkyAltitude, myRoot.Position.Z)
                local diff = maxSkyPos - myRoot.Position
                
                if lv then
                    lv.VectorVelocity = diff.Magnitude > 15 and diff.Unit * (Config.FlySpeed + 100) or Vector3.zero
                end
                if ao then
                    ao.CFrame = CFrame.lookAt(myRoot.Position, myRoot.Position + Vector3.new(0, 1, 0))
                end
            end
            task.wait(0.05)
        end

        local myChar = GetChar(LocalPlayer)
        local myRoot = GetRoot(myChar)
        RemoveModernPhysics(myRoot)

        AppState.IsRetreating = false
        AppState.SelectedPlayer = nil
        StopHunt("Ready for Next Target")
    end)
end

