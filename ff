local function PerformTacticalSkyWarp(targetRoot)
    if not Config.EnableSkyWarp or not targetRoot then return end
    local myChar = GetChar(LocalPlayer)
    local myRoot = GetRoot(myChar)
    if not myRoot then return end

    local dist = (targetRoot.Position - myRoot.Position).Magnitude
    if dist > Config.WarpDistanceThreshold and not AppState.IsWarping then
        AppState.IsWarping = true
        AppState.CurrentCombatStatus = "Sky-Warping to target sub-orbit..."
        Stats.WarpsPerformed = Stats.WarpsPerformed + 1

        -- 1. เปิดฮาคิสังเกต + ฮาคิเกราะทันทีก่อนวาร์ป
        EnsureKen()
        EnsureBuso()

        -- 2. วาร์ปเข้าสู่จุด Sky Drop (เหนือหัวเป้าหมาย 220 Studs)
        local skyDropPos = targetRoot.Position + Vector3.new(0, Config.SkyDropHeight, 0)
