    SelBtn.Text = "SELECT"
    SelBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    SelBtn.Font = Enum.Font.GothamBold
    SelBtn.TextSize = 10
    SelBtn.Parent = Row
    Instance.new("UICorner", SelBtn).CornerRadius = UDim.new(0, 4)

    SpyBtn.MouseButton1Click:Connect(function()
        if AppState.IsSpectating and AppState.SelectedPlayer == player then
            Camera.CameraSubject = GetHum(GetChar(LocalPlayer))
            AppState.IsSpectating = false
            SpyBtn.Text = "SPY"
        else
            local targetHum = GetHum(GetChar(player))
            if targetHum then
                Camera.CameraSubject = targetHum
                AppState.IsSpectating = true
                AppState.SelectedPlayer = player
                SpyBtn.Text = "UNSPY"
            end
        end
    end)

    SelBtn.MouseButton1Click:Connect(function()
        local st = StatusCache[player] or RefreshTargetStatus(player)
        if st.InSafeZone or not st.PvPEnabled then
            StatusLabel.Text = "Blocked: " .. (st.InSafeZone and "SafeZone" or "PvP Off")
            return
        end

        AppState.SelectedPlayer = player
        local bountyTxt = st.WillGiveBounty and string.format("+%dk Bounty", math.floor(st.EstBounty / 1000)) or "No Bounty"
        StatusLabel.Text = string.format("Target: %s (Lv.%d | %s)", player.DisplayName, st.Level, bountyTxt)
    end)

    RadarRows[player] = {
        Frame = Row,
        Info = Info,
        SpyBtn = SpyBtn,
        SelBtn = SelBtn
    }
    return RadarRows[player]
end

local function CleanupRadarRow(player)
    if RadarRows[player] then
        if RadarRows[player].Frame then RadarRows[player].Frame:Destroy() end
        RadarRows[player] = nil
    end
end

Players.PlayerRemoving:Connect(CleanupRadarRow)

local function UpdateRadarRows()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local row = GetOrCreateRadarRow(player)
            local st = StatusCache[player] or RefreshTargetStatus(player)
            local hpPercent = math.floor((st.Health / st.MaxHealth) * 100)

            -- แสดงสถานะการได้รับ Bounty ชัดเจน
            local bountyBadge = ""
            if st.WillGiveBounty then
                bountyBadge = string.format("<font color='#00FF7F'><b>[💰 +%dk]</b></font>", math.floor(st.EstBounty / 1000))
            else
                bountyBadge = string.format("<font color='#FF5555'>[🚫 %s]</font>", st.BountyReason)
            end

            row.Frame.BackgroundColor3 = (AppState.SelectedPlayer == player) and Color3.fromRGB(45, 65, 105) or Color3.fromRGB(19, 23, 33)
            row.Info.Text = string.format(
                "<b>%s</b> %s <font color='#00E5FF'>Lv.%d</font><br/>" ..
                "<font color='#00FF7F'>HP: %d%%</font> | <font color='#FFD700'>%dm</font> | Total: %s",
                player.DisplayName, bountyBadge, st.Level,
                hpPercent, st.Distance, tostring(st.Bounty)
            )

            row.SpyBtn.Text = (AppState.IsSpectating and AppState.SelectedPlayer == player) and "UNSPY" or "SPY"

            if st.InSafeZone or not st.PvPEnabled then
                row.SelBtn.BackgroundColor3 = Color3.fromRGB(40, 44, 52)
                row.SelBtn.Text = st.InSafeZone and "SAFE" or "NO PVP"
                row.SelBtn.TextColor3 = Color3.fromRGB(120, 125, 135)
            else
                if st.WillGiveBounty then
                    row.SelBtn.BackgroundColor3 = (AppState.SelectedPlayer == player) and Color3.fromRGB(0, 180, 100) or Color3.fromRGB(0, 140, 80)
                    row.SelBtn.Text = (AppState.SelectedPlayer == player) and "LOCKED" or "HUNT"
                else
                    row.SelBtn.BackgroundColor3 = (AppState.SelectedPlayer == player) and Color3.fromRGB(160, 100, 30) or Color3.fromRGB(100, 70, 20)
                    row.SelBtn.Text = (AppState.SelectedPlayer == player) and "LOCKED" or "FIGHT"
                end
                row.SelBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            end
        end
    end
    ScrollList.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 10)
end

task.spawn(function()
    while true do
        if not AppState.IsHunting and not AppState.IsRetreating then
            UpdateRadarRows()
        else
            StatusLabel.Text = "Status: " .. AppState.CurrentCombatStatus
        end
        task.wait(Config.RadarUpdateInterval)
    end
end)

