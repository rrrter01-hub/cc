                end
            end)

            local SelBtn = Instance.new("TextButton")
            SelBtn.Size = UDim2.new(0, IsMobile and 54 or 60, 0, 26)
            SelBtn.Position = UDim2.new(IsMobile and 0.77 or 0.80, 0, 0.5, -13)
            SelBtn.BackgroundColor3 = st.CanAttack and Color3.fromRGB(0, 160, 90) or Color3.fromRGB(70, 75, 85)
            SelBtn.Text = (AppState.SelectedPlayer == player) and "LOCKED" or "SELECT"
            SelBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            SelBtn.Font = Enum.Font.GothamBold
            SelBtn.TextSize = 10
            SelBtn.Parent = Row
            Instance.new("UICorner", SelBtn).CornerRadius = UDim.new(0, 4)

            SelBtn.MouseButton1Click:Connect(function()
                AppState.SelectedPlayer = player
                StatusLabel.Text = string.format("Target: %s (%s)", player.DisplayName, st.CanAttack and "Ready" or "Safe/Off")
                RenderRadarRows()
            end)
        end
    end
    ScrollList.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 10)
end

task.spawn(function()
    while true do
        if not AppState.IsHunting then
            RenderRadarRows()
        else
            StatusLabel.Text = "Status: " .. AppState.CurrentCombatStatus
        end
        task.wait(1.5)
    end
end)

HuntBtn.MouseButton1Click:Connect(function()
    if AppState.IsHunting then
        StopHunt()
        HuntBtn.Text = "START HUNT (ENGAGE)"
        HuntBtn.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
        StatusLabel.Text = "Status: Hunt Cancelled (Idle)"
    else
        if not AppState.SelectedPlayer then
            StatusLabel.Text = "Error: Select target first!"
            return
        end

        local st = CheckTargetStatus(AppState.SelectedPlayer)
        if not st.IsAlive then
            StatusLabel.Text = "Error: Target is dead!"
            return
        end
        if st.InSafeZone then
            StatusLabel.Text = "Alert: Target in SafeZone!"
            return
        end
        if not st.PvPEnabled then
            StatusLabel.Text = "Alert: Target PvP Disabled!"
            return
        end

        EnsureWeaponEquipped("Melee")

        AppState.IsHunting = true
        HuntBtn.Text = "STOP HUNTING"
        HuntBtn.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
        StatusLabel.Text = "Status: Flying & Engaging..."
    end
end)
