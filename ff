-- =========================================================================
-- 1. LIVE BOUNTY TRACKER ENGINE (ตรวจจับค่าหัว ได้ / เสีย)
-- =========================================================================
local function GetPlayerBounty(player)
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local bounty = leaderstats:FindFirstChild("Bounty/Honor") or leaderstats:FindFirstChild("Bounty") or leaderstats:FindFirstChild("Honor")
        if bounty then return bounty.Value end
    end
    return 0
end

Stats.StartBounty = GetPlayerBounty(LocalPlayer)
Stats.CurrentBounty = Stats.StartBounty

local function HookBountyListener(updateUiCallback)
    local leaderstats = LocalPlayer:WaitForChild("leaderstats", 10)
    if not leaderstats then return end

    local bountyStat = leaderstats:FindFirstChild("Bounty/Honor") or leaderstats:FindFirstChild("Bounty") or leaderstats:FindFirstChild("Honor")
    if bountyStat then
        bountyStat.Changed:Connect(function(newVal)
            local diff = newVal - Stats.CurrentBounty
            if diff > 0 then
                Stats.BountyGained = Stats.BountyGained + diff
                Stats.Kills = Stats.Kills + 1
            elseif diff < 0 then
                Stats.BountyLost = Stats.BountyLost + math.abs(diff)
                Stats.Deaths = Stats.Deaths + 1
            end
            Stats.CurrentBounty = newVal
            if updateUiCallback then updateUiCallback() end
        end)
    end
end

-- =========================================================================
-- 2. STATUS CHECKER (ตรวจสอบ PvP & Safe Zone & HP อย่างละเอียด)
-- =========================================================================
local function CheckPlayerStatus(player)
    local status = {
        IsPvPEnabled = true,
        InSafeZone = false,
        Health = 0,
        MaxHealth = 100,
        Distance = 0,
        IsAlive = false,
        CanAttack = false
    }

    local char = player.Character
    local myChar = LocalPlayer.Character

    if not char or not char:FindFirstChild("Humanoid") or not char:FindFirstChild("HumanoidRootPart") then
        return status
    end

    local hum = char.Humanoid
    local root = char.HumanoidRootPart
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    status.Health = math.floor(hum.Health)
    status.MaxHealth = math.floor(hum.MaxHealth)
    status.IsAlive = hum.Health > 0

    if myRoot and root then
        status.Distance = math.floor((root.Position - myRoot.Position).Magnitude)
    end

    -- 1. ตรวจสอบ Safe Zone Shield / เขตปลอดภัย
    if char:FindFirstChild("SafeZoneShield") or char:FindFirstChild("InSafeZone") then
        status.InSafeZone = true
    end

    -- 2. ตรวจสอบสถานะการเปิด/ปิด PvP (PvP Disabled Flag)
    if char:FindFirstChild("PvPDisabled") or player:GetAttribute("PvPDisabled") == true then
        status.IsPvPEnabled = false
    end

    -- สรุปว่าโจมตีได้หรือไม่
    status.CanAttack = status.IsAlive and status.IsPvPEnabled and not status.InSafeZone and (player.Team ~= LocalPlayer.Team)

    return status
end

-- =========================================================================
-- 3. SPY CAM ENGINE (กล้องส่องเป้าหมายแบบ Real-time)
-- =========================================================================
local function ToggleSpyCam(targetPlayer)
    if AppState.IsSpectating and AppState.SelectedPlayer == targetPlayer then
        -- ปิดกล้องส่อง กลับมาร่างตัวเอง
        Camera.CameraSubject = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        AppState.IsSpectating = false
        return false
    end

    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChildOfClass("Humanoid") then
        Camera.CameraSubject = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
        AppState.IsSpectating = true
        AppState.SelectedPlayer = targetPlayer
        return true
    end
    return false
end

