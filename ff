        StopHunting()
        HuntBtn.Text = "START HUNT (ENGAGE)"
        HuntBtn.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
        StatusLabel.Text = "Status: Hunt Cancelled (Idle)"
    else
        if not AppState.SelectedPlayer then
            StatusLabel.Text = "Error: Select target first!"
            return
        end

        local st = CheckTargetStatus(AppState.SelectedPlayer)
        if not st.IsAlive then
            StatusLabel.Text = "Error: Target is dead!"
            return
        end
        if st.InSafeZone then
            StatusLabel.Text = "Alert: Target in SafeZone!"
            return
        end
        if not st.PvPEnabled then
            StatusLabel.Text = "Alert: Target PvP Disabled!"
            return
        end

        AppState.IsHunting = true
        HuntBtn.Text = "STOP HUNTING"
        HuntBtn.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
        StatusLabel.Text = "Status: Flying & Attacking..."
    end
end)
