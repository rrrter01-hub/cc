-- =========================================================================
-- AUTO HAKI & COMBAT SKILLS
-- =========================================================================
local function EnsureHaki()
    local char = GetChar(LocalPlayer)
    if not char then return end

    if Config.AutoBuso and not char:FindFirstChild("HasBuso") then
        local rem = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
        if rem then rem:InvokeServer("Buso") end
    end
end

local function EquipTool(toolType)
    local bp = LocalPlayer.Backpack
    local char = GetChar(LocalPlayer)
    local hum = GetHum(char)
    if not bp or not char or not hum then return end

    for _, tool in ipairs(bp:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == toolType or tool:GetAttribute("WeaponType") == toolType) then
            hum:EquipTool(tool)
            return
        end
    end
end

local function CastSkill(key, holdTime)
    VirtualInputManager:SendKeyEvent(true, key, false, game)
    if holdTime and holdTime > 0 then
        task.wait(holdTime)
    end
    VirtualInputManager:SendKeyEvent(false, key, false, game)
end

local function FastM1(targetRoot)
    local char = GetChar(LocalPlayer)
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(0, 0))
        task.wait(0.02)
        VirtualUser:Button1Up(Vector2.new(0, 0))

        local net = ReplicatedStorage:FindFirstChild("Modules") 
            and ReplicatedStorage.Modules:FindFirstChild("Net")
            and ReplicatedStorage.Modules.Net:FindFirstChild("RegisterHit")
        if net then
            net:FireServer(targetRoot, { targetRoot })
        end
    end
end

local function RunFullCombo(targetChar)
    if AppState.IsComboRunning then return end
    AppState.IsComboRunning = true

    for _, step in ipairs(Config.ComboList) do
        if not AppState.IsHunting then break end
        local hum = GetHum(targetChar)
        if not hum or hum.Health <= 0 then break end

        EquipTool(step.Type)
        task.wait(0.04)

        local tRoot = GetRoot(targetChar)
        if tRoot then
            local predPos = tRoot.Position + (tRoot.AssemblyLinearVelocity * Config.Prediction)
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, predPos)
        end

        CastSkill(step.Key, step.Hold)
        task.wait(0.18)

        if Config.AutoAttack and tRoot then
            FastM1(tRoot)
        end
    end

    AppState.IsComboRunning = false
end

-- =========================================================================
-- FLIGHT & AIMLOCK ENGINE (CFrame Stepper + Anti-Rubberband)
-- =========================================================================
local function StopHunting()
    AppState.IsHunting = false
    if AppState.CurrentTween then
        AppState.CurrentTween:Cancel()
        AppState.CurrentTween = nil
    end
    local myChar = GetChar(LocalPlayer)
    RemovePhysicsBypass(GetRoot(myChar))
end

local function FlyAndAttackStep()
    if not AppState.IsHunting or not AppState.SelectedPlayer then return end

    local myChar = GetChar(LocalPlayer)
    local myRoot = GetRoot(myChar)
    local myHum = GetHum(myChar)

    if not myChar or not myRoot or not myHum or myHum.Health <= 0 then
        StopHunting()
        return
    end

    local st = CheckTargetStatus(AppState.SelectedPlayer)
    if not st.IsAlive or st.InSafeZone or not st.PvPEnabled then
        StopHunting()
        return
    end

    local targetChar = GetChar(AppState.SelectedPlayer)
    local targetRoot = GetRoot(targetChar)
    if not targetRoot then return end

    EnsureHaki()
    ApplyPhysicsBypass(myRoot)

    -- จุดเกาะติด: ลอยเหนือหัว 12 studs
    local targetHoverPos = targetRoot.Position + Vector3.new(0, Config.HoverDistance, 0)
    local currentPos = myRoot.Position
    local dist = (targetHoverPos - currentPos).Magnitude

    local bg = myRoot:FindFirstChild("BountyFlightBG")
    if bg then
        bg.CFrame = CFrame.new(myRoot.Position, targetRoot.Position)
    end

    if dist > 15 then
        -- กำลังบินเข้าหา
        local direction = (targetHoverPos - currentPos).Unit
        local stepSpeed = math.min(Config.FlySpeed, dist * 10)
        local bv = myRoot:FindFirstChild("BountyFlightBV")
        if bv then
            bv.Velocity = direction * stepSpeed
        end
    else
        -- เข้าถึงระยะล็อคเป้าแล้ว
        local bv = myRoot:FindFirstChild("BountyFlightBV")
        if bv then
            bv.Velocity = Vector3.zero
        end
        myRoot.CFrame = CFrame.new(targetHoverPos, targetRoot.Position)

        -- ล็อคมุมกล้อง
        local predPos = targetRoot.Position + (targetRoot.AssemblyLinearVelocity * Config.Prediction)
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, predPos)

        -- ยิงคอมโบ
        task.spawn(function()
            RunFullCombo(targetChar)
        end)
    end
end

RunService.Heartbeat:Connect(FlyAndAttackStep)

