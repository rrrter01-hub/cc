-- =========================================================================
-- BLOX FRUITS TURBO FAST-ATTACK & BURST DPS MODULE
-- Architecture: Animation Bypass + Multi-Hit Registration + Zero-Delay Weave
-- =========================================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualUser = game:GetService("VirtualUser")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- =========================================================================
-- ADVANCED COMBAT CONFIGURATION
-- =========================================================================
local CombatConfig = {
    FastAttackSpeed = 0.015,     -- ดีเลย์การตี M1 ต่อรอบ (ยิ่งน้อยยิ่งรัว)
    MultiHitsPerSwing = 4,       -- จำนวนฮิตที่ส่งเข้า Server ต่อ 1 ครั้ง
    AttackDistance = 3.5,        -- ระยะเกาะติดเป้าหมาย (ประชิดหลัง)
    CancelAnimation = true,      -- ยกเลิกอนิเมชั่นเพื่อไม่ให้ตัวละครชะงัก
    AutoSkillWeave = true,       -- รันสกิลแทรกระหว่าง M1 อัตโนมัติ
    AimPrediction = 0.14,
    
    -- ลำดับการเบิร์สดาเมจแบบ Quick-Swap
    BurstChain = {
        { Type = "Melee", Key = Enum.KeyCode.Z, Hold = 0.02 },
        { Type = "Melee", Key = Enum.KeyCode.X, Hold = 0.05 },
        { Type = "Sword", Key = Enum.KeyCode.Z, Hold = 0.02 },
        { Type = "Sword", Key = Enum.KeyCode.X, Hold = 0.08 },
        { Type = "Fruit", Key = Enum.KeyCode.V, Hold = 0.02 },
        { Type = "Fruit", Key = Enum.KeyCode.C, Hold = 0.05 },
        { Type = "Gun",   Key = Enum.KeyCode.Z, Hold = 0.02 }
    }
}

local CombatState = {
    IsAttacking = false,
    CurrentTargetChar = nil
}

-- =========================================================================
-- 1. ANIMATION CANCELER (ตัดอนิเมชั่นการเหวี่ยงอาวุธทั้งหมด)
-- =========================================================================
local function StopAttackAnimations()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local animator = hum:FindFirstChildOfClass("Animator")
    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            -- ตัดเฉพาะอนิเมชั่นการฟัน/ต่อย/สกิลที่ไม่จำเป็น เพื่อให้ตัวละครเคลื่อนไหวได้อิสระ
            local animName = track.Name:lower()
            if animName:find("slash") or animName:find("attack") or animName:find("punch") or animName:find("swing") then
                track:Stop(0)
            end
        end
    end
end

-- =========================================================================
-- 2. TURBO FAST ATTACK (M1 MULTI-PACKET ENGINE)
-- =========================================================================
local function GetAttackRemotes()
    local net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
    local registerHit = net and net:FindFirstChild("RegisterHit")
    local registerAttack = net and net:FindFirstChild("RegisterAttack")
    
    -- Fallback สำหรับ Engine รุ่นอื่นๆ ของ Blox Fruits
    local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
    
    return registerHit, registerAttack, commF
end

local function ExecuteFastAttack(targetChar)
    if not targetChar then return end
    
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso")
    local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
    if not targetRoot or not targetHum or targetHum.Health <= 0 then return end

    local myChar = LocalPlayer.Character
    local equippedTool = myChar and myChar:FindFirstChildOfClass("Tool")
    if not equippedTool then return end

    local regHit, regAttack, commF = GetAttackRemotes()

    -- 1. ส่ง Request Attack
    if regAttack then
        regAttack:FireServer(0)
    end

    -- 2. รวบรวม Hitbox หลายจุด (Head, HumanoidRootPart, Torso) เพื่อกระจายดาเมจเต็มพิกัด
    local hitParts = {}
    for _, partName in ipairs({"HumanoidRootPart", "Head", "UpperTorso", "LowerTorso", "Torso"}) do
        local p = targetChar:FindFirstChild(partName)
        if p then table.insert(hitParts, p) end
    end

    -- 3. ยิง RegisterHit ซ้ำตามจำนวน MultiHitsPerSwing
    for i = 1, CombatConfig.MultiHitsPerSwing do
        if regHit then
            regHit:FireServer(targetRoot, hitParts)
        end
    end

    -- 4. จำลองการคลิกเมาส์ซ้าย M1 ผ่าน VirtualUser
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))
    VirtualUser:Button1Up(Vector2.new(0, 0))

    -- 5. ยกเลิกอนิเมชั่นทันที
    if CombatConfig.CancelAnimation then
        StopAttackAnimations()
    end
end

-- =========================================================================
-- 3. WEAPON AUTO-EQUIP & ZERO-DELAY SKILL WEAVER
-- =========================================================================
local function FastEquipTool(toolType)
    local bp = LocalPlayer.Backpack
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not bp or not hum then return end

    -- ถืออยู่แล้ว ไม่ต้องสลับซ้ำ
    local currentTool = char:FindFirstChildOfClass("Tool")
    if currentTool and (currentTool.ToolTip == toolType or currentTool:GetAttribute("WeaponType") == toolType) then
        return
    end

    for _, tool in ipairs(bp:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == toolType or tool:GetAttribute("WeaponType") == toolType) then
            hum:EquipTool(tool)
            break
        end
    end
end

local function FastCastSkill(key, holdTime)
    VirtualInputManager:SendKeyEvent(true, key, false, game)
    if holdTime and holdTime > 0 then
        task.wait(holdTime)
    end
    VirtualInputManager:SendKeyEvent(false, key, false, game)
end

-- =========================================================================
-- 4. INTEGRATED HIGH-DPS ATTACK LOOP (M1 Turbo + Skill Weave)
-- =========================================================================
local function StartCombatLoop(targetChar)
    if CombatState.IsAttacking then return end
    CombatState.IsAttacking = true
    CombatState.CurrentTargetChar = targetChar

    -- Thread 1: รัน M1 Turbo ตีรัวไม่หยุด
    task.spawn(function()
        while CombatState.IsAttacking and targetChar and targetChar.Parent do
            local hum = targetChar:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then break end

            ExecuteFastAttack(targetChar)
            task.wait(CombatConfig.FastAttackSpeed)
        end
        CombatState.IsAttacking = false
    end)

    -- Thread 2: สลับปล่อยสกิลคอมโบแทรกไประหว่างตี M1
    if CombatConfig.AutoSkillWeave then
        task.spawn(function()
            for _, step in ipairs(CombatConfig.BurstChain) do
                if not CombatState.IsAttacking then break end
                
                local hum = targetChar:FindFirstChildOfClass("Humanoid")
                if not hum or hum.Health <= 0 then break end

                -- สลับอาวุธ
                FastEquipTool(step.Type)
                task.wait(0.03)

                -- ปรับมุมกล้องดักเป้าหมาย
                local tRoot = targetChar:FindFirstChild("HumanoidRootPart")
                if tRoot then
                    local predPos = tRoot.Position + (tRoot.AssemblyLinearVelocity * CombatConfig.AimPrediction)
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, predPos)
                end

                -- ปล่อยสกิล
                FastCastSkill(step.Key, step.Hold)
                task.wait(0.12)
            end
        end)
    end
end

local function StopCombatLoop()
    CombatState.IsAttacking = false
    CombatState.CurrentTargetChar = nil
end

-- =========================================================================
-- 5. POSITIONING CONTROLLER (ปรับตำแหน่งเกาะหลังเป้าหมาย 3.5 Studs)
-- =========================================================================
local function LockBehindTarget(targetChar, myRoot)
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso")
    if not targetRoot or not myRoot then return end

    -- ลอยอยู่ด้านหลังเป้าหมายเล็กน้อย (เลี่ยงการโดนสวนกลับและตีโดนแน่นอน 100%)
    local behindCFrame = targetRoot.CFrame * CFrame.new(0, 1.5, CombatConfig.AttackDistance)
    
    myRoot.CFrame = CFrame.new(behindCFrame.Position, targetRoot.Position)
    
    -- ล็อคมุมกล้องมองตรงเป้าหมาย
    local predPos = targetRoot.Position + (targetRoot.AssemblyLinearVelocity * CombatConfig.AimPrediction)
    Camera.CFrame = CFrame.new(Camera.CFrame.Position, predPos)
end
