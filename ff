local function UpdateStatsDisplay()
    local net = Stats.BountyGained - Stats.BountyLost
    local netColor = net >= 0 and "#00FF7F" or "#FF4D4D"
    StatText.Text = string.format(
        "<b>Bounty:</b> %s | <b>K/D:</b> <font color='#00FF7F'>%d</font>/<font color='#FF4D4D'>%d</font><br/>" ..
        "<b>Gained:</b> <font color='#00FF7F'>+%s</font> | <b>Lost:</b> <font color='#FF4D4D'>-%s</font> | <b>Net:</b> <font color='%s'>%+d</font>",
        tostring(Stats.CurrentBounty), Stats.Kills, Stats.Deaths,
        tostring(Stats.BountyGained), tostring(Stats.BountyLost),
        netColor, net
    )
end

local function SetupBountyListener()
    local ls = LocalPlayer:WaitForChild("leaderstats", 10)
    if not ls then return end
    local bStat = ls:FindFirstChild("Bounty/Honor") or ls:FindFirstChild("Bounty") or ls:FindFirstChild("Honor")
    if bStat then
        bStat.Changed:Connect(function(newVal)
            local diff = newVal - Stats.CurrentBounty
            if diff > 0 then
                Stats.BountyGained = Stats.BountyGained + diff
                Stats.Kills = Stats.Kills + 1
                TriggerSkyRetreat()
            elseif diff < 0 then
                Stats.BountyLost = Stats.BountyLost + math.abs(diff)
                Stats.Deaths = Stats.Deaths + 1
            end
            Stats.CurrentBounty = newVal
            UpdateStatsDisplay()
        end)
    end
end
SetupBountyListener()
UpdateStatsDisplay()

