-- 2. ระบบบินสมูท
local function cancelTween()
    if State.ActiveTween then
        State.ActiveTween:Cancel()
        State.ActiveTween = nil
    end
end

local function smoothFly(targetPos, speed)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    speed = speed or Config.TweenSpeed
    local distance = (hrp.Position - targetPos).Magnitude
    if distance < 6 then return true end

    local time = distance / speed
    local tweenInfo = TweenInfo.new(time, Enum.EasingStyle.Linear)
    
    cancelTween()
    State.ActiveTween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos)})
    hrp.Velocity = Vector3.zero
    State.ActiveTween:Play()
    
    local completed = false
    local conn
    conn = State.ActiveTween.Completed:Connect(function(s)
        if s == Enum.PlaybackState.Completed then completed = true end
        conn:Disconnect()
    end)

    while not completed and State.ActiveTween do
        -- เจอเจ้าทะเลระหว่างทางให้หยุดบินทันที
        if workspace:FindFirstChild("Enemies") and workspace.Enemies:FindFirstChild("Sea Beast") then
            cancelTween()
            return true
        end
        task.wait(0.1)
    end

    if hrp then hrp.Velocity = Vector3.zero end
    return true
end

-- 3. สแกนและโจมตี
local function scanSeaBoss()
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return nil, nil end

    local candidates = {}
    for _, enemy in ipairs(enemies:GetChildren()) do
        local name = string.lower(enemy.Name)
        local isSB = string.find(name, "sea")
        local isTerror = string.find(name, "terror")

        if isSB or (isTerror and Config.HuntTerrorShark) then
            local hum = enemy:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local root = enemy:FindFirstChild("Head") or enemy:FindFirstChild("HumanoidRootPart") or enemy:FindFirstChildWhichIsA("BasePart")
                if root then
                    table.insert(candidates, {
                        Entity = enemy,
                        Root = root,
                        Health = hum.Health,
                        Priority = isSB and 1 or 2
                    })
                end
            end
        end
    end

    if #candidates == 0 then return nil, nil end
    table.sort(candidates, function(a, b)
        if a.Priority == b.Priority then return a.Health < b.Health end
        return a.Priority < b.Priority
    end)
    return candidates[1].Entity, candidates[1].Root
end

local function equipWeapon()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    if not hum then return end

    local targetType = Config.SelectedWeapon
    for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            if targetType == "Melee" and tool.ToolTip == "Melee" then
                hum:EquipTool(tool)
                return
            elseif targetType == "Sword" and tool.ToolTip == "Sword" then
                hum:EquipTool(tool)
                return
            elseif targetType == "Fruit" and (tool.ToolTip == "Blox Fruit" or string.find(tool.Name, "Fruit")) then
                hum:EquipTool(tool)
                return
            end
        end
    end
end

local function attackCombo(targetRoot)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (hrp and targetRoot) then return end

    -- ล็อกหน้ามองตรงลงเป้าหมาย
    hrp.CFrame = CFrame.lookAt(hrp.Position, targetRoot.Position)
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))

    if Config.AutoSkills then
        local skillKeys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
        for _, key in ipairs(skillKeys) do
            VirtualInputManager:SendKeyEvent(true, key, false, game)
            task.wait(0.06)
            VirtualInputManager:SendKeyEvent(false, key, false, game)
            task.wait(0.12)
        end
    end
end

