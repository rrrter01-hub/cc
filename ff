-- =========================================================================
-- COMBAT: TURBO FAST ATTACK & SKILL WEAVE
-- =========================================================================
local function EnsureHaki()
    local char = GetChar(LocalPlayer)
    if not char then return end
    if Config.AutoBuso and not char:FindFirstChild("HasBuso") then
        local rem = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
        if rem then rem:InvokeServer("Buso") end
    end
end

local function StopAttackAnimations()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator")
    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            local name = track.Name:lower()
            if name:find("slash") or name:find("attack") or name:find("punch") or name:find("swing") then
                track:Stop(0)
            end
        end
    end
end

local function FastAttackHit(targetChar)
    local targetRoot = GetRoot(targetChar)
    if not targetRoot then return end

    local net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
    local regHit = net and net:FindFirstChild("RegisterHit")
    local regAttack = net and net:FindFirstChild("RegisterAttack")

    if regAttack then regAttack:FireServer(0) end

    local hitParts = {}
    for _, pName in ipairs({"HumanoidRootPart", "Head", "UpperTorso"}) do
        local p = targetChar:FindFirstChild(pName)
        if p then table.insert(hitParts, p) end
    end

    for i = 1, Config.MultiHitCount do
        if regHit then regHit:FireServer(targetRoot, hitParts) end
    end

    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))
    VirtualUser:Button1Up(Vector2.new(0, 0))

    StopAttackAnimations()
end

local function FastEquipTool(toolType)
    local bp = LocalPlayer.Backpack
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not bp or not hum then return end

    local currentTool = char:FindFirstChildOfClass("Tool")
    if currentTool and (currentTool.ToolTip == toolType or currentTool:GetAttribute("WeaponType") == toolType) then
        return
    end

    for _, tool in ipairs(bp:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == toolType or tool:GetAttribute("WeaponType") == toolType) then
            hum:EquipTool(tool)
            break
        end
    end
end

local function FastCastSkill(key, holdTime)
    VirtualInputManager:SendKeyEvent(true, key, false, game)
    if holdTime and holdTime > 0 then task.wait(holdTime) end
    VirtualInputManager:SendKeyEvent(false, key, false, game)
end

-- Continuous Combat Thread
local function StartCombatThread(targetChar)
    if AppState.IsAttacking then return end
    AppState.IsAttacking = true

    -- M1 Fast Attack Loop
    task.spawn(function()
        while AppState.IsAttacking and AppState.IsHunting do
            local hum = GetHum(targetChar)
            if not hum or hum.Health <= 0 then break end

            FastAttackHit(targetChar)
            task.wait(Config.FastAttackSpeed)
        end
        AppState.IsAttacking = false
    end)

    -- Combo Skill Weaver Loop
    task.spawn(function()
        for _, step in ipairs(Config.ComboList) do
            if not AppState.IsAttacking or not AppState.IsHunting then break end
            local hum = GetHum(targetChar)
            if not hum or hum.Health <= 0 then break end

            FastEquipTool(step.Type)
            task.wait(0.03)

            local tRoot = GetRoot(targetChar)
            if tRoot then
                local predPos = tRoot.Position + (tRoot.AssemblyLinearVelocity * Config.Prediction)
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, predPos)
            end

            FastCastSkill(step.Key, step.Hold)
            task.wait(0.12)
        end
    end)
end

-- =========================================================================
-- MAIN FLIGHT & TARGET ENGAGE ENGINE
-- =========================================================================
local function StopHunting()
    AppState.IsHunting = false
    AppState.IsAttacking = false
    local myChar = GetChar(LocalPlayer)
    RemovePhysicsBypass(GetRoot(myChar))
end

RunService.Heartbeat:Connect(function()
    if not AppState.IsHunting or not AppState.SelectedPlayer then return end

    local myChar = GetChar(LocalPlayer)
    local myRoot = GetRoot(myChar)
    local myHum = GetHum(myChar)

    if not myChar or not myRoot or not myHum or myHum.Health <= 0 then
        StopHunting()
        return
    end

    local st = CheckTargetStatus(AppState.SelectedPlayer)
    if not st.IsAlive or st.InSafeZone or not st.PvPEnabled then
        StopHunting()
        return
    end

    local targetChar = GetChar(AppState.SelectedPlayer)
    local targetRoot = GetRoot(targetChar)
    if not targetRoot then return end

    EnsureHaki()
    ApplyPhysicsBypass(myRoot)

    -- คำนวณตำแหน่งประชิดหลัง 3.5 Studs
    local behindTargetPos = (targetRoot.CFrame * CFrame.new(0, 1.2, Config.HoverDistance)).Position
    local dist = (behindTargetPos - myRoot.Position).Magnitude

    local bg = myRoot:FindFirstChild("BountyBG")
    if bg then
        bg.CFrame = CFrame.new(myRoot.Position, targetRoot.Position)
    end

    if dist > 8 then
        -- กำลังบินเข้าหาเป้าหมาย
        local dir = (behindTargetPos - myRoot.Position).Unit
        local bv = myRoot:FindFirstChild("BountyBV")
        if bv then
            bv.Velocity = dir * Config.FlySpeed
        end
    else
        -- ล็อคตำแหน่งประชิดหลังพร้อมตี
        local bv = myRoot:FindFirstChild("BountyBV")
        if bv then bv.Velocity = Vector3.zero end
        
        myRoot.CFrame = CFrame.new(behindTargetPos, targetRoot.Position)

        local predPos = targetRoot.Position + (targetRoot.AssemblyLinearVelocity * Config.Prediction)
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, predPos)

        StartCombatThread(targetChar)
    end
end)

