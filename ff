HuntBtn.TextSize = IsMobile and 10 or 11
HuntBtn.Parent = ActionCard
Instance.new("UICorner", HuntBtn).CornerRadius = UDim.new(0, 6)

local function RenderRadarRows()
    for _, child in ipairs(ScrollList:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local st = CheckTargetStatus(player)
            local hpPercent = math.floor((st.Health / math.max(1, st.MaxHealth)) * 100)

            local Row = Instance.new("Frame")
            Row.Size = UDim2.new(1, -8, 0, 48)
            Row.BackgroundColor3 = (AppState.SelectedPlayer == player) and Color3.fromRGB(45, 65, 105) or Color3.fromRGB(19, 23, 33)
            Row.Parent = ScrollList
            Instance.new("UICorner", Row).CornerRadius = UDim.new(0, 6)

            local statusTag = ""
            if st.CanAttack then
                statusTag = "<font color='#00FF7F'>[READY]</font>"
            elseif st.InSafeZone then
                statusTag = "<font color='#FFD700'>[SAFE ZONE]</font>"
            elseif not st.PvPEnabled then
                statusTag = "<font color='#FF5555'>[PVP OFF]</font>"
            elseif not st.IsAlive then
                statusTag = "<font color='#888888'>[DEAD]</font>"
            else
                statusTag = "<font color='#FF8800'>[" .. st.Reason:upper() .. "]</font>"
            end

            local Info = Instance.new("TextLabel")
            Info.Size = UDim2.new(0.60, 0, 1, 0)
            Info.Position = UDim2.new(0, 8, 0, 0)
            Info.BackgroundTransparency = 1
            Info.RichText = true
            Info.Font = Enum.Font.Gotham
            Info.TextSize = IsMobile and 10 or 11
            Info.TextColor3 = Color3.fromRGB(240, 240, 240)
            Info.TextXAlignment = Enum.TextXAlignment.Left
            
            Info.Text = string.format(
                "<b>%s</b> %s | <font color='#00E5FF'>Lv.%d</font><br/>" ..
                "<font color='#00FF7F'>HP: %d%%</font> (%d/%d) | <font color='#FFD700'>%dm</font> | B: %s",
                player.DisplayName, statusTag, st.Level,
                hpPercent, st.Health, st.MaxHealth, st.Distance, tostring(st.Bounty)
            )
            Info.Parent = Row

            local SpyBtn = Instance.new("TextButton")
            SpyBtn.Size = UDim2.new(0, IsMobile and 46 or 50, 0, 26)
            SpyBtn.Position = UDim2.new(0.62, 0, 0.5, -13)
            SpyBtn.BackgroundColor3 = Color3.fromRGB(48, 85, 150)
            SpyBtn.Text = (AppState.IsSpectating and AppState.SelectedPlayer == player) and "UNSPY" or "SPY"
            SpyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            SpyBtn.Font = Enum.Font.GothamBold
            SpyBtn.TextSize = 10
            SpyBtn.Parent = Row
            Instance.new("UICorner", SpyBtn).CornerRadius = UDim.new(0, 4)

            SpyBtn.MouseButton1Click:Connect(function()
                if AppState.IsSpectating and AppState.SelectedPlayer == player then
                    Camera.CameraSubject = GetHum(GetChar(LocalPlayer))
                    AppState.IsSpectating = false
                    SpyBtn.Text = "SPY"
                else
                    local targetHum = GetHum(GetChar(player))
                    if targetHum then
                        Camera.CameraSubject = targetHum
                        AppState.IsSpectating = true
                        AppState.SelectedPlayer = player
                        SpyBtn.Text = "UNSPY"
                    end
                end
            end)

            local SelBtn = Instance.new("TextButton")
            SelBtn.Size = UDim2.new(0, IsMobile and 54 or 62, 0, 26)
            SelBtn.Position = UDim2.new(IsMobile and 0.77 or 0.78, 0, 0.5, -13)
            
            if not st.CanAttack then
                SelBtn.BackgroundColor3 = Color3.fromRGB(40, 44, 52)
                SelBtn.Text = st.InSafeZone and "SAFE" or "NO PVP"
                SelBtn.TextColor3 = Color3.fromRGB(120, 125, 135)
            else
                SelBtn.BackgroundColor3 = (AppState.SelectedPlayer == player) and Color3.fromRGB(0, 180, 100) or Color3.fromRGB(0, 140, 80)
                SelBtn.Text = (AppState.SelectedPlayer == player) and "LOCKED" or "SELECT"
                SelBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            end
            
            SelBtn.Font = Enum.Font.GothamBold
            SelBtn.TextSize = 10
            SelBtn.Parent = Row
            Instance.new("UICorner", SelBtn).CornerRadius = UDim.new(0, 4)

            SelBtn.MouseButton1Click:Connect(function()
                if not st.CanAttack then
                    StatusLabel.Text = "Blocked: " .. st.Reason
                    return
                end

                AppState.SelectedPlayer = player
                StatusLabel.Text = string.format("Target: %s (Lv.%d | Ready)", player.DisplayName, st.Level)
                RenderRadarRows()
            end)
        end
    end
    ScrollList.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 10)
end

task.spawn(function()
    while true do
        if not AppState.IsHunting and not AppState.IsRetreating then
            RenderRadarRows()
        else
            StatusLabel.Text = "Status: " .. AppState.CurrentCombatStatus
        end
        task.wait(1.5)
    end
end)

HuntBtn.MouseButton1Click:Connect(function()
    if AppState.IsHunting or AppState.IsRetreating then
        StopHunt("Hunt Cancelled")
        HuntBtn.Text = "START HUNT (ENGAGE)"
        HuntBtn.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
        StatusLabel.Text = "Status: Hunt Cancelled (Idle)"
    else
        if not AppState.SelectedPlayer then
            StatusLabel.Text = "Error: Select target first!"
            return
        end

        local st = CheckTargetStatus(AppState.SelectedPlayer)
        if not st.CanAttack then
            StatusLabel.Text = "Cannot Hunt: " .. st.Reason
            AppState.SelectedPlayer = nil
            RenderRadarRows()
            return
        end

        EquipWeapon(Config.PrimaryWeapon)

        AppState.IsHunting = true
        HuntBtn.Text = "STOP HUNTING"
        HuntBtn.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
        StatusLabel.Text = "Status: Engaging Target..."
    end
end)
