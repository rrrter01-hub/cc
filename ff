local function StopHunt(reason)
    AppState.IsHunting = false
    AppState.IsHealingInSky = false
    AppState.CurrentCombatStatus = reason or "Idle"
    local myChar = GetChar(LocalPlayer)
    RemovePhysics(GetRoot(myChar))
    if AppState.TargetAnimTrack then
        AppState.TargetAnimTrack:Disconnect()
        AppState.TargetAnimTrack = nil
    end
end

-- =========================================================================
-- MAXIMUM SKY RETREAT
-- =========================================================================
local function TriggerMaxSkyRetreat()
    if AppState.IsRetreating then return end
    AppState.IsHunting = false
    AppState.IsRetreating = true
    AppState.CurrentCombatStatus = string.format("KILL CONFIRMED! Sky Ascend (%dm)...", Config.MaxSkyAltitude)

    task.spawn(function()
        local start = tick()
        while (tick() - start < Config.PostKillSkyDuration) do
            local myChar = GetChar(LocalPlayer)
            local myRoot = GetRoot(myChar)
            local myHum = GetHum(myChar)

            if myRoot and myHum and myHum.Health > 0 then
                ApplyPhysics(myRoot)
                EnsureKen()
                EnsureBuso()
                
                local maxSkyPos = Vector3.new(myRoot.Position.X, Config.MaxSkyAltitude, myRoot.Position.Z)
                local diff = maxSkyPos - myRoot.Position
                local bv = myRoot:FindFirstChild("BountyBV")
                if bv then
                    bv.Velocity = diff.Magnitude > 15 and diff.Unit * (Config.FlySpeed + 120) or Vector3.zero
                end
            end
            task.wait(0.04)
        end

        local myChar = GetChar(LocalPlayer)
        local myRoot = GetRoot(myChar)
        local bv = myRoot and myRoot:FindFirstChild("BountyBV")
        if bv then bv.Velocity = Vector3.zero end

        AppState.IsRetreating = false
        AppState.SelectedPlayer = nil

        if Config.AutoTarget then
            local nextTarget = FindBestTarget()
            if nextTarget then
                AppState.SelectedPlayer = nextTarget
                AppState.IsHunting = true
                HookTargetAnimationSniffer(nextTarget)
            else
                StopHunt("All Targets Cleared")
            end
        else
            StopHunt("Target Eliminated")
        end
    end)
end

-- =========================================================================
-- HEARTBEAT NAVIGATION, FORCE COMBAT & SAFE ZONE INTERCEPTION
-- =========================================================================
RunService.Heartbeat:Connect(function(dt)
    if AppState.IsRetreating then return end
    if not AppState.IsHunting or not AppState.SelectedPlayer then return end

    local myChar = GetChar(LocalPlayer)
    local myRoot = GetRoot(myChar)
    local myHum = GetHum(myChar)

    if not myChar or not myRoot or not myHum or myHum.Health <= 0 then
        StopHunt("Player Dead")
        return
    end

    local currentHpPercent = (myHum.Health / math.max(1, myHum.MaxHealth)) * 100

    -- Emergency Sky Heal
    if Config.EmergencyEscape and (currentHpPercent <= Config.EmergencyHPThreshold or AppState.IsHealingInSky) then
        if currentHpPercent < Config.RecoveryHPThreshold then
            AppState.IsHealingInSky = true
            AppState.CurrentCombatStatus = string.format("EMERGENCY ESCAPE: Sky Healing (%d%% HP)", math.floor(currentHpPercent))
            
            ApplyPhysics(myRoot)
            EnsureKen()
            EnsureBuso()
            
            local skyPos = Vector3.new(myRoot.Position.X, Config.MaxSkyAltitude, myRoot.Position.Z)
            local diff = skyPos - myRoot.Position
            local bv = myRoot:FindFirstChild("BountyBV")
            if bv then
                bv.Velocity = diff.Magnitude > 15 and diff.Unit * Config.FlySpeed or Vector3.zero
            end
            return
        else
            AppState.IsHealingInSky = false
        end
    end

    local targetChar = GetChar(AppState.SelectedPlayer)
    local targetHum = GetHum(targetChar)
    local targetRoot = GetRoot(targetChar)

    if not targetChar or not targetHum or targetHum.Health <= 0 or not targetChar.Parent then
        TriggerMaxSkyRetreat()
        return
    end

    local st = CheckTargetStatus(AppState.SelectedPlayer)
    if not st.CanAttack then
        if Config.AutoTarget then
            local nextTarget = FindBestTarget()
            if nextTarget then
                AppState.SelectedPlayer = nextTarget
                HookTargetAnimationSniffer(nextTarget)
                return
            end
        end
        StopHunt("Disengaged: " .. st.Reason)
        return
    end

    if not targetRoot then return end

    EnsureBuso()
    EnsureKen()
    TriggerRaceV3()
    TriggerRaceV4()
    ApplyPhysics(myRoot)

    -- คำนวณ Predictive Velocity Vector (ดักหน้าเวลาเป้าหมายแดช/วาร์ป)
    local targetVelocity = targetRoot.AssemblyLinearVelocity or targetRoot.Velocity or Vector3.zero
    local predictedPos = targetRoot.Position + (targetVelocity * Config.PredictionMultiplier)
    local predictedCFrame = CFrame.new(predictedPos, predictedPos + targetRoot.CFrame.LookVector)

    -- Quantum Weave 3D Dodge Offset
    local weaveX, weaveY = 0, 0
    if Config.EnableAutoDodge and Config.DodgeMode == "QuantumWeave" then
        AppState.OrbitAngle = AppState.OrbitAngle + (Config.WeaveSpeed * dt)
        weaveX = math.sin(AppState.OrbitAngle) * Config.WeaveRadius
        weaveY = math.cos(AppState.OrbitAngle * 1.5) * 0.75
    end

    -- SAFE ZONE INTERCEPTION & ANTI-ESCAPE
    local stickCFrame = predictedCFrame * CFrame.new(weaveX, Config.HeightOffset + weaveY, Config.StickDistance)
    local targetPos = stickCFrame.Position
    local currentPos = myRoot.Position
    local dist = (targetPos - currentPos).Magnitude

    -- บังคับแท็ก In-Combat ทันทีที่เข้าใกล้
    if dist <= 35 then
        ForceCombatTag(targetChar, targetRoot)
    end

    local bg = myRoot:FindFirstChild("BountyBG")
    if bg then
        bg.CFrame = CFrame.lookAt(myRoot.Position, targetRoot.Position)
    end

    if dist > 3.0 then
        AppState.CurrentCombatStatus = "Force-Locking Target (" .. math.floor(dist) .. "m)"
        local dir = (targetPos - currentPos).Unit
        local bv = myRoot:FindFirstChild("BountyBV")
        if bv then
            bv.Velocity = dir * math.min(Config.FlySpeed, dist * 38)
        end
    else
        local bv = myRoot:FindFirstChild("BountyBV")
        if bv then bv.Velocity = Vector3.zero end
        
        myRoot.CFrame = CFrame.lookAt(targetPos, targetRoot.Position)
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetRoot.Position)
        AppState.CurrentCombatStatus = "Combat Lock: Trapped & Striking..."
    end
end)

