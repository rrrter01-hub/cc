-- =========================================================================
-- UTILITY HELPERS
-- =========================================================================
local function GetChar(p) return p and p.Character end
local function GetRoot(c) return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso")) end
local function GetHum(c)  return c and c:FindFirstChildOfClass("Humanoid") end

local function GetPlayerBounty(player)
    local ls = player:FindFirstChild("leaderstats")
    if ls then
        local b = ls:FindFirstChild("Bounty/Honor") or ls:FindFirstChild("Bounty") or ls:FindFirstChild("Honor")
        if b then return b.Value end
    end
    return 0
end

local function GetPlayerLevel(player)
    if not player then return 1 end
    local data = player:FindFirstChild("Data")
    if data and data:FindFirstChild("Level") then return data.Level.Value end
    local ls = player:FindFirstChild("leaderstats")
    if ls and ls:FindFirstChild("Level") then return ls.Level.Value end
    return 1
end

Stats.StartBounty = GetPlayerBounty(LocalPlayer)
Stats.CurrentBounty = Stats.StartBounty

-- =========================================================================
-- STRICT STATUS & SAFEZONE CHECKER (MULTI-LAYER INSPECTION)
-- =========================================================================
local function CheckTargetStatus(player)
    local st = {
        IsAlive = false,
        InSafeZone = false,
        PvPEnabled = true,
        Health = 0,
        MaxHealth = 100,
        Distance = 0,
        Level = 1,
        Bounty = 0,
        CanAttack = false,
        Reason = "OK"
    }

    if not player or not player.Parent then 
        st.Reason = "Invalid Target"
        return st 
    end

    st.Level = GetPlayerLevel(player)
    st.Bounty = GetPlayerBounty(player)

    local char = GetChar(player)
    local myChar = GetChar(LocalPlayer)
    local hum = GetHum(char)
    local root = GetRoot(char)
    local myRoot = GetRoot(myChar)

    if not char or not hum or not root then 
        st.Reason = "Dead / No Character"
        return st 
    end

    st.Health = math.floor(hum.Health)
    st.MaxHealth = math.floor(hum.MaxHealth)
    st.IsAlive = hum.Health > 0

    if myRoot and root then
        st.Distance = math.floor((root.Position - myRoot.Position).Magnitude)
    end

    -- 1. Multi-Layer SafeZone Inspection
    if char:FindFirstChild("SafeZoneShield") 
        or char:FindFirstChild("InSafeZone") 
        or char:FindFirstChild("ForceField")
        or char:FindFirstChild("SafeZone")
        or player:GetAttribute("InSafeZone") == true
        or player:GetAttribute("SafeZone") == true then
        st.InSafeZone = true
    end

    -- 2. Multi-Layer PvP Status Inspection
    if char:FindFirstChild("PvPDisabled")
        or char:FindFirstChild("PVPDisabled")
        or player:FindFirstChild("PvPDisabled")
        or player:GetAttribute("PvPDisabled") == true
        or player:GetAttribute("PvP") == false then
        st.PvPEnabled = false
    end

    -- 3. Marine vs Marine Check (Marines ด้วยกันเองตีไม่ได้)
    local teamCheck = true
    if LocalPlayer.Team and player.Team then
        if LocalPlayer.Team.Name == "Marines" and player.Team.Name == "Marines" then
            teamCheck = false
            st.Reason = "Same Marine Team"
        end
    end

    -- วิเคราะห์สถานะขั้นสุดท้าย
    if not st.IsAlive then
        st.Reason = "Player is Dead"
    elseif st.InSafeZone then
        st.Reason = "In SafeZone"
    elseif not st.PvPEnabled then
        st.Reason = "PvP Disabled (Peace)"
    elseif not teamCheck then
        st.Reason = "Same Marine Team"
    else
        st.CanAttack = true
        st.Reason = "Ready for Combat"
    end

    return st
end

-- =========================================================================
-- AUTO BUFFS (KEN / BUSO / RACE)
-- =========================================================================
local function EnsureBuso()
    if not Config.AutoBuso then return end
    local char = GetChar(LocalPlayer)
    if not char then return end
    if not char:FindFirstChild("HasBuso") then
        local rem = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
        if rem then pcall(function() rem:InvokeServer("Buso") end) end
    end
end

local function EnsureKen()
    if not Config.AutoKen then return end
    local char = GetChar(LocalPlayer)
    if not char then return end
    if not char:FindFirstChild("KenHaki") and not char:FindFirstChild("Observation") then
        local remF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
        if remF then pcall(function() remF:InvokeServer("Ken", true) end) end
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(0.03)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end)
    end
end

local lastRaceSkillTick = 0
local function TriggerRaceSkill()
    if not Config.AutoRaceV3 then return end
    if tick() - lastRaceSkillTick < 15 then return end
    lastRaceSkillTick = tick()

    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.T, false, game)
        task.wait(0.04)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.T, false, game)
    end)
    pcall(function()
        local rem = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
        if rem then rem:InvokeServer("ActivateAbility") end
    end)
end

-- =========================================================================
-- WEAPON EQUATION
-- =========================================================================
local function EnsureWeaponEquipped(preferredType)
    local char = GetChar(LocalPlayer)
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local hum = GetHum(char)
    if not char or not hum then return nil end

    local equipped = char:FindFirstChildOfClass("Tool")
    if equipped then
        local currentType = equipped.ToolTip ~= "" and equipped.ToolTip or equipped:GetAttribute("WeaponType")
        if not preferredType or currentType == preferredType or equipped.Name:find(preferredType or "") then
            return equipped
        end
    end

    if bp then
        if preferredType then
            for _, tool in ipairs(bp:GetChildren()) do
                if tool:IsA("Tool") then
                    local tType = tool.ToolTip ~= "" and tool.ToolTip or tool:GetAttribute("WeaponType")
                    if tType == preferredType or tool.Name:find(preferredType) then
                        hum:EquipTool(tool)
                        return tool
                    end
                end
            end
        end

        for _, toolType in ipairs({"Melee", "Sword", "Blox Fruit", "Fruit", "Gun"}) do
            for _, tool in ipairs(bp:GetChildren()) do
                if tool:IsA("Tool") then
                    local tType = tool.ToolTip ~= "" and tool.ToolTip or tool:GetAttribute("WeaponType")
                    if tType == toolType or tool.Name:find(toolType) then
                        hum:EquipTool(tool)
                        return tool
                    end
                end
            end
        end

        local firstTool = bp:FindFirstChildOfClass("Tool")
        if firstTool then
            hum:EquipTool(firstTool)
            return firstTool
        end
    end

    return equipped
end

-- =========================================================================
-- FAST ATTACK & COMBAT HOOK
-- =========================================================================
local CombatFramework = nil
pcall(function()
    CombatFramework = require(LocalPlayer.PlayerScripts:WaitForChild("CombatFramework", 3))
end)

local function GetActiveRig()
    if CombatFramework and typeof(CombatFramework) == "table" then
        return CombatFramework.activeController
    end
    return nil
end

local function ExecuteFastAttack(targetChar)
    if not targetChar or not targetChar.Parent then return end
    local targetRoot = GetRoot(targetChar)
    local targetHum = GetHum(targetChar)
    if not targetRoot or not targetHum or targetHum.Health <= 0 then return end

    local tool = GetChar(LocalPlayer):FindFirstChildOfClass("Tool")
    if not tool then tool = EnsureWeaponEquipped() end
    if not tool then return end

    pcall(function() tool:Activate() end)

    local rig = GetActiveRig()
    if rig then
        pcall(function()
            rig.timeToNextAttack = 0
            rig.hitAttempts = 0
            rig.increment = 3
            rig.attacking = false
            rig.blocking = false
            if rig.attack then rig:attack() end
        end)
    end

    local net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
    local regHit = net and (net:FindFirstChild("RE/RegisterHit") or net:FindFirstChild("RegisterHit"))
    local regAttack = net and (net:FindFirstChild("RE/RegisterAttack") or net:FindFirstChild("RegisterAttack"))

    if regAttack then pcall(function() regAttack:FireServer(0) end) end

    if regHit then
        local hitParts = {}
        for _, name in ipairs({"HumanoidRootPart", "Head", "UpperTorso", "Torso"}) do
            local part = targetChar:FindFirstChild(name)
            if part then table.insert(hitParts, part) end
        end

        for i = 1, Config.MultiHitPackets do
            pcall(function()
                regHit:FireServer(targetRoot, hitParts)
            end)
        end
    end

    pcall(function()
        VirtualUser:Button1Down(Vector2.new(0, 0))
        VirtualUser:Button1Up(Vector2.new(0, 0))
    end)
end

-- =========================================================================
-- INDEPENDENT COMBAT LOOP
-- =========================================================================
task.spawn(function()
    while true do
        if AppState.IsHunting and AppState.SelectedPlayer and not AppState.IsHealingInSky then
            local targetChar = GetChar(AppState.SelectedPlayer)
            local myChar = GetChar(LocalPlayer)
            local targetRoot = GetRoot(targetChar)
            local myRoot = GetRoot(myChar)

            if targetChar and targetRoot and myRoot and targetChar.Parent then
                local dist = (targetRoot.Position - myRoot.Position).Magnitude
                if dist <= (Config.HoverHeight + 8) then
                    ExecuteFastAttack(targetChar)
                end
            end
        end
        task.wait(Config.AttackDelay)
    end
end)

-- =========================================================================
-- SKILL ROTATION THREAD
-- =========================================================================
local function CastSkillKey(key, holdTime)
    VirtualInputManager:SendKeyEvent(true, key, false, game)
    if holdTime and holdTime > 0 then task.wait(holdTime) end
    VirtualInputManager:SendKeyEvent(false, key, false, game)
end

local isComboActive = false
local function StartSkillRotation(targetChar)
    if isComboActive or AppState.IsHealingInSky then return end
    isComboActive = true

    task.spawn(function()
        while AppState.IsHunting and targetChar and targetChar.Parent and not AppState.IsHealingInSky do
            for _, step in ipairs(Config.SkillRotation) do
                if not AppState.IsHunting or AppState.IsHealingInSky then break end
                local hum = GetHum(targetChar)
                if not hum or hum.Health <= 0 then break end

                EnsureWeaponEquipped(step.Type)
                task.wait(0.06)

                local tRoot = GetRoot(targetChar)
                if tRoot then
                    local predPos = tRoot.Position + (tRoot.AssemblyLinearVelocity * Config.AimPrediction)
                    Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, predPos)
                end

                AppState.CurrentCombatStatus = "Cast: " .. step.Type .. " [" .. step.Key.Name .. "]"
                CastSkillKey(step.Key, step.Hold)
                task.wait(0.12)
            end
            task.wait(0.2)
        end
        isComboActive = false
    end)
end

-- =========================================================================
-- NOCLIP & FLIGHT CONTROLLER
-- =========================================================================
local function ApplyBypass(myRoot)
    local bv = myRoot:FindFirstChild("BountyBV") or Instance.new("BodyVelocity")
    bv.Name = "BountyBV"
    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bv.Velocity = Vector3.zero
    bv.Parent = myRoot

    local bg = myRoot:FindFirstChild("BountyBG") or Instance.new("BodyGyro")
    bg.Name = "BountyBG"
    bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bg.P = 12000
    bg.Parent = myRoot
end

local function RemoveBypass(myRoot)
    if not myRoot then return end
    if myRoot:FindFirstChild("BountyBV") then myRoot.BountyBV:Destroy() end
    if myRoot:FindFirstChild("BountyBG") then myRoot.BountyBG:Destroy() end
end

RunService.Stepped:Connect(function()
    if AppState.IsHunting then
        local myChar = GetChar(LocalPlayer)
        if myChar then
            for _, part in ipairs(myChar:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end
end)

local function StopHunt(reason)
    AppState.IsHunting = false
    AppState.IsHealingInSky = false
    isComboActive = false
    AppState.CurrentCombatStatus = reason or "Idle"
    local myChar = GetChar(LocalPlayer)
    RemoveBypass(GetRoot(myChar))
end

-- =========================================================================
-- MAIN ENGINE LOOP
-- =========================================================================
RunService.Heartbeat:Connect(function()
    if not AppState.IsHunting or not AppState.SelectedPlayer then return end

    local myChar = GetChar(LocalPlayer)
    local myRoot = GetRoot(myChar)
    local myHum = GetHum(myChar)

    if not myChar or not myRoot or not myHum or myHum.Health <= 0 then
        StopHunt("Player Dead")
        return
    end

    local currentHpPercent = (myHum.Health / math.max(1, myHum.MaxHealth)) * 100

    -- Emergency Sky Heal Check
    if Config.EmergencyEscape and (currentHpPercent <= Config.EmergencyHPThreshold or AppState.IsHealingInSky) then
        if currentHpPercent < Config.RecoveryHPThreshold then
            AppState.IsHealingInSky = true
            AppState.CurrentCombatStatus = string.format("HEALING: Sky Camp (%d%% HP)", math.floor(currentHpPercent))
            
            ApplyBypass(myRoot)
            EnsureKen()
            
            local skyPos = Vector3.new(myRoot.Position.X, Config.EscapeSkyAltitude, myRoot.Position.Z)
            myRoot.CFrame = CFrame.new(skyPos)
            local bv = myRoot:FindFirstChild("BountyBV")
            if bv then bv.Velocity = Vector3.new(0, 30, 0) end
            return
        else
            AppState.IsHealingInSky = false
        end
    end

    -- Real-time Target Status Check (ถ้าวิ่งเข้า SafeZone หรือปิด PvP หลุดทันที)
    local st = CheckTargetStatus(AppState.SelectedPlayer)
    if not st.CanAttack then
        StopHunt("Disengaged: " .. st.Reason)
        return
    end

    local targetChar = GetChar(AppState.SelectedPlayer)
    local targetRoot = GetRoot(targetChar)
    if not targetRoot then return end

    EnsureBuso()
    EnsureKen()
    TriggerRaceSkill()
    ApplyBypass(myRoot)

    -- Dynamic Overhead Orbit (9 Studs)
    local angle = tick() * Config.OrbitSpeed
    local offsetX = math.cos(angle) * Config.OrbitRadius
    local offsetZ = math.sin(angle) * Config.OrbitRadius
    
    local targetPos = targetRoot.Position + Vector3.new(offsetX, Config.HoverHeight, offsetZ)
    local currentPos = myRoot.Position
    local dist = (targetPos - currentPos).Magnitude

    local bg = myRoot:FindFirstChild("BountyBG")
    if bg then
        bg.CFrame = CFrame.lookAt(myRoot.Position, targetRoot.Position)
    end

    if dist > 12 then
        AppState.CurrentCombatStatus = "Flying to target (" .. math.floor(dist) .. "m)"
        local dir = (targetPos - currentPos).Unit
        local bv = myRoot:FindFirstChild("BountyBV")
        if bv then bv.Velocity = dir * Config.FlySpeed end
    else
        local bv = myRoot:FindFirstChild("BountyBV")
        if bv then bv.Velocity = Vector3.zero end
        
        myRoot.CFrame = CFrame.lookAt(targetPos, targetRoot.Position)

        local predPos = targetRoot.Position + (targetRoot.AssemblyLinearVelocity * Config.AimPrediction)
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, predPos)

        StartSkillRotation(targetChar)
    end
end)

