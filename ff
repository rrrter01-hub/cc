            Info.Text = string.format(
                "<b>%s</b> %s | <font color='#00E5FF'>Lv.%d</font><br/>" ..
                "<font color='#00FF7F'>HP: %d%%</font> (%d/%d) | <font color='#FFD700'>%dm</font> | B: %s",
