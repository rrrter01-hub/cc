local function equipSelectedWeapon(weaponType)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    if not hum then return end

    weaponType = weaponType or Settings.SelectedWeapon

    for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            if weaponType == "Melee" and item.ToolTip == "Melee" then
                hum:EquipTool(item)
                return
            elseif weaponType == "Sword" and item.ToolTip == "Sword" then
                hum:EquipTool(item)
                return
            elseif weaponType == "Fruit" and (item.ToolTip == "Blox Fruit" or string.find(item.Name, "Fruit")) then
                hum:EquipTool(item)
                return
            end
        end
    end
end

local function executeAttackCombo(targetRoot)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (hrp and targetRoot) then return end

    hrp.CFrame = CFrame.lookAt(hrp.Position, targetRoot.Position)
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))

    if Settings.AutoSkills then
        local skillKeys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
        for _, key in ipairs(skillKeys) do
            VirtualInputManager:SendKeyEvent(true, key, false, game)
            task.wait(0.06)
            VirtualInputManager:SendKeyEvent(false, key, false, game)
            task.wait(0.12)
        end
    end
end

local function scanSeaTargets()
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return nil, nil end

    local candidates = {}
    for _, enemy in ipairs(enemies:GetChildren()) do
        local nameLower = string.lower(enemy.Name)
        local isSeaBeast = string.find(nameLower, "sea")
        local isTerrorShark = string.find(nameLower, "terror")

        if (isSeaBeast and Settings.HuntSeaBeast) or (isTerrorShark and Settings.HuntTerrorShark) then
            local hum = enemy:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local root = enemy:FindFirstChild("Head") or enemy:FindFirstChild("HumanoidRootPart") or enemy:FindFirstChildWhichIsA("BasePart")
                if root then
                    table.insert(candidates, {
                        Entity = enemy,
                        Root = root,
                        Health = hum.Health,
                        Priority = isSeaBeast and 1 or 2
                    })
                end
            end
        end
    end

    if #candidates == 0 then return nil, nil end

    table.sort(candidates, function(a, b)
        if a.Priority == b.Priority then return a.Health < b.Health end
        return a.Priority < b.Priority
    end)

    return candidates[1].Entity, candidates[1].Root
end

