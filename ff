-- =========================================================================
-- STATUS CHECKER (SafeZone, PvP Status, HP, Distance)
-- =========================================================================
local function CheckTargetStatus(player)
    local st = {
        IsAlive = false,
        InSafeZone = false,
        PvPEnabled = true,
        Health = 0,
        MaxHealth = 100,
        Distance = 0,
        CanAttack = false
    }

    if not player or not player.Parent then return st end

    local char = GetChar(player)
    local myChar = GetChar(LocalPlayer)
    local hum = GetHum(char)
    local root = GetRoot(char)
    local myRoot = GetRoot(myChar)

    if not char or not hum or not root then return st end

    st.Health = math.floor(hum.Health)
    st.MaxHealth = math.floor(hum.MaxHealth)
    st.IsAlive = hum.Health > 0

    if myRoot and root then
        st.Distance = math.floor((root.Position - myRoot.Position).Magnitude)
    end

    if char:FindFirstChild("SafeZoneShield") or char:FindFirstChild("InSafeZone") then
        st.InSafeZone = true
    end

    if char:FindFirstChild("PvPDisabled") or player:GetAttribute("PvPDisabled") == true then
        st.PvPEnabled = false
    end

    st.CanAttack = st.IsAlive and st.PvPEnabled and not st.InSafeZone and (player.Team ~= LocalPlayer.Team)
    return st
end

-- =========================================================================
-- AUTO WEAPON EQUATION (แก้บั๊กมือเปล่าแล้วไม่ยอมตี)
-- =========================================================================
local function EnsureWeaponEquipped(preferredType)
    local char = GetChar(LocalPlayer)
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local hum = GetHum(char)
    if not char or not hum then return nil end

    local equipped = char:FindFirstChildOfClass("Tool")
    if equipped then
        if not preferredType or equipped.ToolTip == preferredType or equipped:GetAttribute("WeaponType") == preferredType then
            return equipped
        end
    end

    -- หาอาวุธในกระเป๋า (Melee -> Sword -> Fruit -> Gun)
    if bp then
        if preferredType then
            for _, tool in ipairs(bp:GetChildren()) do
                if tool:IsA("Tool") and (tool.ToolTip == preferredType or tool:GetAttribute("WeaponType") == preferredType) then
                    hum:EquipTool(tool)
                    return tool
                end
            end
        end

        -- ถ้าไม่มี preferred ให้หยิบอะไรก็ได้ที่มีในตัวออกมาตี
        for _, toolType in ipairs({"Melee", "Sword", "Blox Fruit", "Fruit", "Gun"}) do
            for _, tool in ipairs(bp:GetChildren()) do
                if tool:IsA("Tool") and (tool.ToolTip == toolType or tool:GetAttribute("WeaponType") == toolType or tool.Name:find(toolType)) then
                    hum:EquipTool(tool)
                    return tool
                end
            end
        end

        -- หยิบชิ้นแรกสุดในกระเป๋า
        local firstTool = bp:FindFirstChildOfClass("Tool")
        if firstTool then
            hum:EquipTool(firstTool)
            return firstTool
        end
    end

    return equipped
end

-- =========================================================================
-- AUTO BUSO HAKI (เปิดฮาคิตลอดเวลา)
-- =========================================================================
local function EnsureBuso()
    local char = GetChar(LocalPlayer)
    if not char then return end
    if Config.AutoBuso and not char:FindFirstChild("HasBuso") then
        local rem = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
        if rem then
            pcall(function() rem:InvokeServer("Buso") end)
        end
    end
end

-- =========================================================================
-- TRIPLE-METHOD FAST ATTACK ENGINE (ระบบการตีแบบ 3 ชั้น การันตีออกผล 100%)
-- =========================================================================
local CombatFrameworkModule = nil
pcall(function()
    CombatFrameworkModule = require(LocalPlayer.PlayerScripts:WaitForChild("CombatFramework", 2))
end)

local function ExecuteTripleAttack(targetChar)
    if not targetChar then return end
    local targetRoot = GetRoot(targetChar)
    local targetHum = GetHum(targetChar)
    if not targetRoot or not targetHum or targetHum.Health <= 0 then return end

    -- 1. ตรวจสอบให้แน่ใจว่ามีอาวุธอยู่ในมือ
    local currentTool = EnsureWeaponEquipped()
    if not currentTool then return end

    -- METHOD 1: Direct Tool Activation (ใช้งานได้ทุก Executor)
    pcall(function()
        currentTool:Activate()
    end)

    -- METHOD 2: CombatFramework Hook (ตีไร้คูลดาวน์สำหรับ Blox Fruits)
    if CombatFrameworkModule then
        pcall(function()
            local activeRig = CombatFrameworkModule.activeController
            if activeRig then
                activeRig.timeToNextAttack = 0
                activeRig.hitAttempts = 0
                activeRig.increment = 3
                activeRig:attack()
            end
        end)
    end

    -- METHOD 3: Multi-Packet Remote Burst
    local net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
    local regHit = net and net:FindFirstChild("RegisterHit")
    local regAttack = net and net:FindFirstChild("RegisterAttack")

    if regAttack then
        pcall(function() regAttack:FireServer(0) end)
    end

    if regHit then
        local hitParts = {}
        for _, pName in ipairs({"HumanoidRootPart", "Head", "UpperTorso"}) do
            local p = targetChar:FindFirstChild(pName)
            if p then table.insert(hitParts, p) end
        end
        for i = 1, Config.MultiHitPackets do
            pcall(function() regHit:FireServer(targetRoot, hitParts) end)
        end
    end

    -- Simulate Mouse Click Fallback
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))
    VirtualUser:Button1Up(Vector2.new(0, 0))
end

-- =========================================================================
-- COMBAT & SKILL ROTATION THREAD
-- =========================================================================
local function CastSkillKey(key, holdTime)
    VirtualInputManager:SendKeyEvent(true, key, false, game)
    if holdTime and holdTime > 0 then task.wait(holdTime) end
    VirtualInputManager:SendKeyEvent(false, key, false, game)
end

local isComboActive = false
local function StartSkillRotation(targetChar)
    if isComboActive then return end
    isComboActive = true

    task.spawn(function()
        while AppState.IsHunting and targetChar and targetChar.Parent do
            for _, step in ipairs(Config.SkillRotation) do
                if not AppState.IsHunting then break end
                local hum = GetHum(targetChar)
                if not hum or hum.Health <= 0 then break end

                -- สลับอาวุธตามชุดคอมโบ
                EnsureWeaponEquipped(step.Type)
                task.wait(0.04)

                -- ปรับกล้องล็อกหน้าเป้าหมาย
                local tRoot = GetRoot(targetChar)
                if tRoot then
                    local predPos = tRoot.Position + (tRoot.AssemblyLinearVelocity * Config.AimPrediction)
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, predPos)
                end

                -- ยิงสกิล
                AppState.CurrentCombatStatus = "Casting: " .. step.Type .. " [" .. step.Key.Name .. "]"
                CastSkillKey(step.Key, step.Hold)
                task.wait(0.12)
            end
            task.wait(0.2)
        end
        isComboActive = false
    end)
end

-- =========================================================================
-- NOCLIP & FLIGHT CONTROLLER
-- =========================================================================
local function ApplyBypass(myRoot)
    local bv = myRoot:FindFirstChild("BountyBV") or Instance.new("BodyVelocity")
    bv.Name = "BountyBV"
    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bv.Velocity = Vector3.zero
    bv.Parent = myRoot

    local bg = myRoot:FindFirstChild("BountyBG") or Instance.new("BodyGyro")
    bg.Name = "BountyBG"
    bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bg.P = 10000
    bg.Parent = myRoot
end

local function RemoveBypass(myRoot)
    if not myRoot then return end
    if myRoot:FindFirstChild("BountyBV") then myRoot.BountyBV:Destroy() end
    if myRoot:FindFirstChild("BountyBG") then myRoot.BountyBG:Destroy() end
end

RunService.Stepped:Connect(function()
    if AppState.IsHunting then
        local myChar = GetChar(LocalPlayer)
        if myChar then
            for _, part in ipairs(myChar:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end
end)

local function StopHunt()
    AppState.IsHunting = false
    isComboActive = false
    AppState.CurrentCombatStatus = "Idle"
    local myChar = GetChar(LocalPlayer)
    RemoveBypass(GetRoot(myChar))
end

-- =========================================================================
-- MAIN ENGINE LOOP (HEARTBEAT)
-- =========================================================================
RunService.Heartbeat:Connect(function()
    if not AppState.IsHunting or not AppState.SelectedPlayer then return end

    local myChar = GetChar(LocalPlayer)
    local myRoot = GetRoot(myChar)
    local myHum = GetHum(myChar)

    if not myChar or not myRoot or not myHum or myHum.Health <= 0 then
        StopHunt()
        return
    end

    local st = CheckTargetStatus(AppState.SelectedPlayer)
    if not st.IsAlive or st.InSafeZone or not st.PvPEnabled then
        StopHunt()
        return
    end

    local targetChar = GetChar(AppState.SelectedPlayer)
    local targetRoot = GetRoot(targetChar)
    if not targetRoot then return end

    EnsureBuso()
    ApplyBypass(myRoot)

    -- ตำแหน่งประชิดหน้า/หลังเป้าหมาย 2.5 Studs
    local attackCFrame = targetRoot.CFrame * CFrame.new(0, 1.0, Config.AttackDistance)
    local currentPos = myRoot.Position
    local targetPos = attackCFrame.Position
    local dist = (targetPos - currentPos).Magnitude

    local bg = myRoot:FindFirstChild("BountyBG")
    if bg then
        bg.CFrame = CFrame.new(myRoot.Position, targetRoot.Position)
    end

    if dist > 8 then
        -- กำลังบินเข้าหา
        AppState.CurrentCombatStatus = "Flying to target (" .. math.floor(dist) .. "m)"
        local dir = (targetPos - currentPos).Unit
        local bv = myRoot:FindFirstChild("BountyBV")
        if bv then
            bv.Velocity = dir * Config.FlySpeed
        end
    else
        -- ถึงระยะโจมตีแล้ว: ล็อคตำแหน่ง + หันหน้าหาศัตรู + ระดมตี M1 & สกิล
        local bv = myRoot:FindFirstChild("BountyBV")
        if bv then bv.Velocity = Vector3.zero end
        
        myRoot.CFrame = CFrame.new(targetPos, targetRoot.Position)

        local predPos = targetRoot.Position + (targetRoot.AssemblyLinearVelocity * Config.AimPrediction)
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, predPos)

        -- รัน M1 รัวแบบ Triple Attack
        ExecuteTripleAttack(targetChar)

        -- รันคอมโบสกิลคู่ขนาน
        StartSkillRotation(targetChar)
    end
end)

