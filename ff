    end

    for player, esp in pairs(ESPObjects) do
        local st = StatusCache[player]
        if st and st.Char and st.Root and st.Hum and st.IsAlive and st.Char.Parent then
            if esp.Billboard.Adornee ~= st.Root then esp.Billboard.Adornee = st.Root end
            if esp.Highlight.Adornee ~= st.Char then esp.Highlight.Adornee = st.Char end

            if not esp.Billboard.Enabled then esp.Billboard.Enabled = true end
            if not esp.Highlight.Enabled then esp.Highlight.Enabled = true end

            local hpPercent = math.floor((st.Health / st.MaxHealth) * 100)
            local statusColor = "#00FF7F"
            local highlightColor = Color3.fromRGB(0, 255, 127)
            local bountyBadge = ""

            if st.WillGiveBounty then
                bountyBadge = string.format("<font color='#FFD700'><b>[💰 +%dk BOUNTY]</b></font>", math.floor(st.EstBounty / 1000))
            else
                bountyBadge = string.format("<font color='#AAAAAA'>[❌ NO BOUNTY: %s]</font>", st.BountyReason)
            end

            local tag = "[READY]"
            if player == AppState.SelectedPlayer then
                statusColor = "#00E5FF"
                highlightColor = Color3.fromRGB(0, 229, 255)
                tag = "[🎯 LOCKED TARGET]"
            elseif st.InSafeZone then
                statusColor = "#FFD700"
                highlightColor = Color3.fromRGB(255, 215, 0)
                tag = "[SAFE ZONE]"
            elseif not st.PvPEnabled then
                statusColor = "#FF5555"
                highlightColor = Color3.fromRGB(255, 85, 85)
                tag = "[PVP OFF]"
            elseif not st.IsAlive then
                statusColor = "#888888"
                highlightColor = Color3.fromRGB(136, 136, 136)
                tag = "[DEAD]"
            end

            esp.Highlight.FillColor = highlightColor
            esp.Highlight.OutlineColor = highlightColor

            esp.Label.Text = string.format(
                "<font color='%s'><b>%s</b></font> <font color='#DDD'>Lv.%d</font><br/>" ..
                "<font color='#00FF7F'>HP: %d%%</font> | <font color='#FFD700'>%dm</font><br/>" ..
