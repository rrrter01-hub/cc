-- =========================================================================
-- WEAPON CONTROLLER
-- =========================================================================
local function EquipWeapon(weaponType)
    local char = GetChar(LocalPlayer)
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local hum = GetHum(char)
    if not char or not hum then return nil end
    local currentTool = char:FindFirstChildOfClass("Tool")
    if currentTool then
        local tType = currentTool.ToolTip ~= "" and currentTool.ToolTip or currentTool:GetAttribute("WeaponType")
        if not weaponType or tType == weaponType or currentTool.Name:lower():find(weaponType:lower()) then
            return currentTool
        end
    end
    if bp then
        for _, tool in ipairs(bp:GetChildren()) do
            if tool:IsA("Tool") then
                local tType = tool.ToolTip ~= "" and tool.ToolTip or tool:GetAttribute("WeaponType")
                if not weaponType or tType == weaponType or tool.Name:lower():find(weaponType:lower()) then
                    hum:EquipTool(tool)
                    return tool
                end
            end
        end
        local first = bp:FindFirstChildOfClass("Tool")
        if first then hum:EquipTool(first); return first end
    end
    return currentTool
end

-- =========================================================================
-- COMBAT FRAMEWORK HOOK & AGGRESSIVE M1 ENGINE
-- =========================================================================
local CombatFramework = nil
local CombatController = nil

local function ResolveCombatController()
    if CombatController and typeof(CombatController) == "table" then
        return CombatController
    end
    pcall(function()
        local ps = LocalPlayer:FindFirstChild("PlayerScripts")
        if not ps then return end
        local cfModule = ps:FindFirstChild("CombatFramework")
        if cfModule and cfModule:IsA("ModuleScript") then
            CombatFramework = require(cfModule)
            if typeof(CombatFramework) == "table" then
                if CombatFramework.activeController then
                    CombatController = CombatFramework.activeController
                elseif getupvalues then
                    local upvs = getupvalues(CombatFramework)
                    for _, val in pairs(upvs) do
                        if typeof(val) == "table" and rawget(val, "activeController") then
                            CombatController = val.activeController
                            break
                        end
                    end
                end
            end
        end
    end)
    return CombatController
end

local Net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
local RegisterAttack = Net and (Net:FindFirstChild("RE/RegisterAttack") or Net:FindFirstChild("RegisterAttack"))
local RegisterHit = Net and (Net:FindFirstChild("RE/RegisterHit") or Net:FindFirstChild("RegisterHit"))

local comboStep = 1
local function ExecuteM1Combo()
    local myChar = GetChar(LocalPlayer)
    local myHum = GetHum(myChar)
    if not myChar or not myHum or myHum.Health <= 0 then return end

    myHum.Sit = false
    myHum.PlatformStand = false

    local tool = myChar:FindFirstChildOfClass("Tool")
    if not tool or (Config.PrimaryWeapon and not tool.Name:lower():find(Config.PrimaryWeapon:lower()) and tool.ToolTip ~= Config.PrimaryWeapon) then
        tool = EquipWeapon(Config.PrimaryWeapon)
    end

    local targetChar = AppState.SelectedPlayer and GetChar(AppState.SelectedPlayer)
    local targetRoot = targetChar and GetRoot(targetChar)
    local targetHum = targetChar and GetHum(targetChar)

    -- 1. Hook Combat Controller แบบ aggressive
    local controller = ResolveCombatController()
    if controller then
        pcall(function()
            controller.hitboxMagnitude = Config.HitboxSize
            controller.timeToNextAttack = 0
            controller.hitAttempts = 0
            controller.attacking = false
            controller.blocking = false
            comboStep = (comboStep % 4) + 1
            controller.increment = comboStep
            if controller.attack then controller:attack() end
            -- reset ซ้ำเพื่อ bypass cooldown
            controller.timeToNextAttack = 0
            controller.attacking = false
        end)
    end

    -- 2. ยิง RegisterAttack หลายครั้ง (aggressive)
    if RegisterAttack then
        pcall(function() RegisterAttack:FireServer(0) end)
        pcall(function() RegisterAttack:FireServer(1) end)
    end

    -- 3. ยิง RegisterHit หลายครั้ง พร้อม hit list ขยาย
    if RegisterHit and targetRoot and targetHum and targetHum.Health > 0 then
        pcall(function()
            local hitList = { { targetChar, targetRoot } }
            RegisterHit:FireServer(targetRoot, hitList)
            RegisterHit:FireServer(targetRoot, hitList)
        end)
    end

    -- 4. Tool Activate ซ้ำ
    if tool then
        pcall(function() tool:Activate() end)
        pcall(function() tool:Activate() end)
    end

    -- 5. VirtualInput click ซ้ำ
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(0, 0))
        VirtualUser:Button1Up(Vector2.new(0, 0))
    end)
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
    end)

    -- 6. โยน FireServer CommF_ ด้วย (บาง server ต้องใช้)
    pcall(function()
        local rem = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
        if rem then rem:InvokeServer("Click") end
    end)
end

-- =========================================================================
-- ORBIT STRAFE MOVEMENT (โจมตีพร้อมเคลื่อนไหว)
-- =========================================================================
local function ComputeStrafePosition(targetRoot, myRoot)
    AppState.StrafeAngle = AppState.StrafeAngle + (math.rad(Config.StrafeSpeed) * RunService.Heartbeat:Wait() * 60)
    local offset = Vector3.new(
        math.cos(AppState.StrafeAngle) * Config.StrafeRadius,
        Config.HeightOffset,
        math.sin(AppState.StrafeAngle) * Config.StrafeRadius
    )
    return (targetRoot.CFrame * CFrame.new(offset)).Position
end

-- =========================================================================
-- PHYSICS & MOVEMENT CONTROLLER
-- =========================================================================
local function ApplyPhysics(myRoot)
    if not myRoot then return end
    local bv = myRoot:FindFirstChild("BountyBV") or Instance.new("BodyVelocity")
    bv.Name = "BountyBV"
    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bv.Velocity = Vector3.zero
    bv.Parent = myRoot
    local bg = myRoot:FindFirstChild("BountyBG") or Instance.new("BodyGyro")
    bg.Name = "BountyBG"
    bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bg.P = 15000
    bg.Parent = myRoot
end

local function RemovePhysics(myRoot)
    if not myRoot then return end
    if myRoot:FindFirstChild("BountyBV") then myRoot.BountyBV:Destroy() end
    if myRoot:FindFirstChild("BountyBG") then myRoot.BountyBG:Destroy() end
end

