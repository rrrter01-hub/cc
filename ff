-- =========================================================================
-- MAXIMUM SKY RETREAT (1,700 STUDS)
-- =========================================================================
local function TriggerMaxSkyRetreat()
    if AppState.IsRetreating then return end
    AppState.IsHunting = false
    AppState.IsComboExecuting = false
    AppState.IsRetreating = true
    AppState.CurrentCombatStatus = string.format("TARGET ELIMINATED! Max Sky Orbit (%dm)...", Config.MaxSkyAltitude)

    task.spawn(function()
        local start = tick()
        while (tick() - start < Config.PostKillSkyDuration) do
            local myChar = GetChar(LocalPlayer)
            local myRoot = GetRoot(myChar)
            local myHum = GetHum(myChar)

            if myRoot and myHum and myHum.Health > 0 then
                ApplyPhysics(myRoot)
                EnsureKen()
                EnsureBuso()
                
                local maxSkyPos = Vector3.new(myRoot.Position.X, Config.MaxSkyAltitude, myRoot.Position.Z)
                local diff = maxSkyPos - myRoot.Position
                local bv = myRoot:FindFirstChild("BountyBV")
                if bv then
                    bv.Velocity = diff.Magnitude > 15 and diff.Unit * (Config.FlySpeed + 130) or Vector3.zero
                end
            end
            task.wait(0.04)
        end

        local myChar = GetChar(LocalPlayer)
        local myRoot = GetRoot(myChar)
        local bv = myRoot and myRoot:FindFirstChild("BountyBV")
        if bv then bv.Velocity = Vector3.zero end

        AppState.IsRetreating = false
        AppState.SelectedPlayer = nil

        if Config.AutoTarget then
            local nextTarget = FindBestTarget()
            if nextTarget then
                AppState.SelectedPlayer = nextTarget
                AppState.IsHunting = true
                local nRoot = GetRoot(GetChar(nextTarget))
                if nRoot then PerformTacticalSkyWarp(nRoot) end
            else
                StopHunt("All Targets Cleared")
            end
        else
            StopHunt("Target Eliminated")
        end
    end)
end

