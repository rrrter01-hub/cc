-- =========================================================================
-- UTILITY HELPERS
-- =========================================================================
local function GetChar(p) return p and p.Character end
local function GetRoot(c) return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso")) end
local function GetHum(c)  return c and c:FindFirstChildOfClass("Humanoid") end

local function GetPlayerBounty(player)
    if not player then return 0 end
    local ls = player:FindFirstChild("leaderstats")
    if ls then
        local b = ls:FindFirstChild("Bounty/Honor") or ls:FindFirstChild("Bounty") or ls:FindFirstChild("Honor")
        if b then return b.Value end
    end
    return 0
end

local function GetPlayerLevel(player)
    if not player then return 1 end
    local data = player:FindFirstChild("Data")
    if data and data:FindFirstChild("Level") then return data.Level.Value end
    local ls = player:FindFirstChild("leaderstats")
    if ls and ls:FindFirstChild("Level") then return ls.Level.Value end
    return 1
end

Stats.StartBounty = GetPlayerBounty(LocalPlayer)
Stats.CurrentBounty = Stats.StartBounty

-- =========================================================================
-- TARGET STATUS CHECKER
-- =========================================================================
local function CheckTargetStatus(player)
    local st = {
        IsAlive = false, InSafeZone = false, PvPEnabled = true,
        Health = 0, MaxHealth = 100, Distance = 0,
        Level = 1, Bounty = 0, CanAttack = false, Reason = "OK"
    }
    if not player or not player.Parent then st.Reason = "Invalid Target"; return st end
    st.Level = GetPlayerLevel(player)
    st.Bounty = GetPlayerBounty(player)
    local char = GetChar(player)
    local myChar = GetChar(LocalPlayer)
    local hum = GetHum(char)
    local root = GetRoot(char)
    local myRoot = GetRoot(myChar)
    if not char or not hum or not root then st.Reason = "Dead / No Character"; return st end
    st.Health = math.floor(hum.Health)
    st.MaxHealth = math.floor(hum.MaxHealth)
    st.IsAlive = hum.Health > 0
    if myRoot and root then
        st.Distance = math.floor((root.Position - myRoot.Position).Magnitude)
    end
    if char:FindFirstChild("SafeZoneShield") or char:FindFirstChild("InSafeZone")
        or char:FindFirstChild("ForceField") or char:FindFirstChild("SafeZone")
        or player:GetAttribute("InSafeZone") == true or player:GetAttribute("SafeZone") == true then
        st.InSafeZone = true
    end
    if char:FindFirstChild("PvPDisabled") or char:FindFirstChild("PVPDisabled")
        or player:FindFirstChild("PvPDisabled")
        or player:GetAttribute("PvPDisabled") == true or player:GetAttribute("PvP") == false then
        st.PvPEnabled = false
    end
    local teamCheck = true
    if LocalPlayer.Team and player.Team then
        if LocalPlayer.Team.Name == "Marines" and player.Team.Name == "Marines" then
            teamCheck = false; st.Reason = "Same Marine Team"
        end
    end
    if not st.IsAlive then st.Reason = "Player is Dead"
    elseif st.InSafeZone then st.Reason = "In SafeZone"
    elseif not st.PvPEnabled then st.Reason = "PvP Disabled (Peace)"
    elseif not teamCheck then st.Reason = "Same Marine Team"
    else st.CanAttack = true; st.Reason = "Ready for Combat" end
    return st
end

-- =========================================================================
-- 3D ESP SYSTEM
-- =========================================================================
local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "BountyGod_ESP"
ESPFolder.Parent = (gethui and gethui()) or CoreGui
local ESPObjects = {}

local function CreateESP(player)
    if player == LocalPlayer then return end
    if ESPObjects[player] then return end
    local bill = Instance.new("BillboardGui")
    bill.Name = "ESP_" .. player.Name
    bill.AlwaysOnTop = true
    bill.Size = UDim2.new(0, 180, 0, 50)
    bill.StudsOffset = Vector3.new(0, 3, 0)
    bill.Enabled = Config.EnableESP
    bill.Parent = ESPFolder
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = Config.ESPTextSize
    label.RichText = true
    label.Text = ""
    label.Parent = bill
    local highlight = Instance.new("Highlight")
    highlight.Name = "Highlight_" .. player.Name
    highlight.FillTransparency = 0.65
    highlight.OutlineTransparency = 0.1
    highlight.Enabled = Config.EnableESP
    highlight.Parent = ESPFolder
    ESPObjects[player] = { Billboard = bill, Label = label, Highlight = highlight }
end

local function RemoveESP(player)
    if ESPObjects[player] then
        if ESPObjects[player].Billboard then ESPObjects[player].Billboard:Destroy() end
        if ESPObjects[player].Highlight then ESPObjects[player].Highlight:Destroy() end
        ESPObjects[player] = nil
    end
end

for _, p in ipairs(Players:GetPlayers()) do CreateESP(p) end
Players.PlayerAdded:Connect(CreateESP)
Players.PlayerRemoving:Connect(RemoveESP)

