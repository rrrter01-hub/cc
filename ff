-- =========================================================================
-- 4. NAVIGATION (SMOOTH ANTI-RUBBERBAND TWEEN)
-- =========================================================================
local function cancelTween()
    if State.ActiveTween then
        State.ActiveTween:Cancel()
        State.ActiveTween = nil
    end
end

local function smoothFly(targetPos, speed)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    speed = speed or Config.FlySpeed
    local distance = (hrp.Position - targetPos).Magnitude
    if distance < 6 then return true end

    local time = distance / speed
    local tweenInfo = TweenInfo.new(time, Enum.EasingStyle.Linear)

    cancelTween()
    State.ActiveTween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos)})
    hrp.Velocity = Vector3.zero
    State.ActiveTween:Play()

    local completed = false
    local conn
    conn = State.ActiveTween.Completed:Connect(function(status)
        if status == Enum.PlaybackState.Completed then completed = true end
        conn:Disconnect()
    end)

    while not completed and State.ActiveTween do
        if workspace:FindFirstChild("Enemies") and (workspace.Enemies:FindFirstChild("Sea Beast") or workspace.Enemies:FindFirstChild("Terror Shark")) then
            cancelTween()
            return true
        end
        task.wait(0.1)
    end

    if hrp then hrp.Velocity = Vector3.zero end
    return true
end

-- =========================================================================
-- 5. TARGET SCANNER & PRIORITY QUEUE
-- =========================================================================
local function scanAllSeaBosses()
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return nil, nil end

    local candidates = {}

    for _, enemy in ipairs(enemies:GetChildren()) do
        local name = string.lower(enemy.Name)
        local isSB = string.find(name, "sea")
        local isTerror = string.find(name, "terror")
        local isShip = string.find(name, "ship")
        local isPiranha = string.find(name, "piranha")

        local isValidTarget = (isSB and Config.HuntSeaBeast) or 
                              (isTerror and Config.HuntTerrorShark) or 
                              (isShip and Config.HuntGhostShip) or 
                              (isPiranha and Config.HuntPiranha)

        if isValidTarget then
            local hum = enemy:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local root = enemy:FindFirstChild("Head") or enemy:FindFirstChild("HumanoidRootPart") or enemy:FindFirstChildWhichIsA("BasePart")
                if root then
                    local pVal = 4
                    if isSB then pVal = 1
                    elseif isTerror then pVal = 2
                    elseif isShip then pVal = 3 end

                    table.insert(candidates, {
                        Entity = enemy,
                        Root = root,
                        Health = hum.Health,
                        Priority = pVal,
                        Type = isSB and "SeaBeast" or (isTerror and "TerrorShark" or "GhostShip")
                    })
                end
            end
        end
    end

    if #candidates == 0 then return nil, nil end

    table.sort(candidates, function(a, b)
        if a.Priority == b.Priority then return a.Health < b.Health end
        return a.Priority < b.Priority
    end)

    return candidates[1].Entity, candidates[1].Root, candidates[1].Type
end

