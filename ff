local function autoBuffs()
    local char = LocalPlayer.Character
    if not char then return end

    if Config.AutoBusoHaki and not char:FindFirstChild("HasBuso") then
        pcall(function() CommF:InvokeServer("Buso") end)
    end
    if Config.AutoRaceV3 then
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.T, false, game)
        task.wait(0.04)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.T, false, game)
    end
    if Config.AutoRaceV4 then
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Y, false, game)
        task.wait(0.04)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Y, false, game)
    end
end

-- =========================================================================
-- 4. NAVIGATION & TWEEN ENGINE
-- =========================================================================
local function cancelTween()
    if State.ActiveTween then
        State.ActiveTween:Cancel()
        State.ActiveTween = nil
    end
end

local function smoothFly(targetPos, speed)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    speed = speed or Config.FlySpeed
    local distance = (hrp.Position - targetPos).Magnitude
    if distance < 6 then return true end

    local time = distance / speed
    local tweenInfo = TweenInfo.new(time, Enum.EasingStyle.Linear)

    cancelTween()
    State.ActiveTween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos)})
    hrp.Velocity = Vector3.zero
    State.ActiveTween:Play()

    local completed = false
    local conn
    conn = State.ActiveTween.Completed:Connect(function(s)
        if s == Enum.PlaybackState.Completed then completed = true end
        conn:Disconnect()
    end)

    while not completed and State.ActiveTween do
        if workspace:FindFirstChild("Enemies") and (workspace.Enemies:FindFirstChild("Sea Beast") or workspace.Enemies:FindFirstChild("Terror Shark")) then
            cancelTween()
            return true
        end
        task.wait(0.1)
    end

    if hrp then hrp.Velocity = Vector3.zero end
    return true
end

