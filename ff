local function SetupBountyListener()
    local ls = LocalPlayer:WaitForChild("leaderstats", 10)
    if not ls then return end
    local bStat = ls:FindFirstChild("Bounty/Honor") or ls:FindFirstChild("Bounty") or ls:FindFirstChild("Honor")
    if bStat then
        bStat.Changed:Connect(function(newVal)
            local diff = newVal - Stats.CurrentBounty
            if diff > 0 then
                Stats.BountyGained = Stats.BountyGained + diff
                Stats.Kills = Stats.Kills + 1
            elseif diff < 0 then
                Stats.BountyLost = Stats.BountyLost + math.abs(diff)
                Stats.Deaths = Stats.Deaths + 1
            end
            Stats.CurrentBounty = newVal
            UpdateStatsDisplay()
        end)
    end
end
