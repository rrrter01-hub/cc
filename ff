-- =========================================================================
-- UNDERGROUND BUNKER RETREAT ENGINE (มุดดินหลบภัย 100% ปลอดภัย ไร้บัค)
-- =========================================================================
local function TriggerUndergroundRetreat()
    if AppState.IsUnderground then return end
    AppState.IsHunting = false
    AppState.IsRetreating = false
    AppState.IsUnderground = true
    AppState.SelectedPlayer = nil
    AppState.CurrentCombatStatus = "KILL CONFIRMED! Diving Underground (-65 Studs Bunker)..."

    task.spawn(function()
        local myChar = GetChar(LocalPlayer)
        local myRoot = GetRoot(myChar)
        local myHum = GetHum(myChar)
        if not myRoot or not myHum then return end

        ApplyPhysics(myRoot)
        EnsureKen()
        EnsureBuso()

        -- ดำดิ่งลงใต้ดินลึก 65 Studs ทันที
        local safeUndergroundPos = Vector3.new(myRoot.Position.X, myRoot.Position.Y - Config.UndergroundDepth, myRoot.Position.Z)
        
        local startDive = tick()
        while tick() - startDive < 1.0 do
            myChar = GetChar(LocalPlayer)
            myRoot = GetRoot(myChar)
            if not myRoot then break end
            
            local diff = safeUndergroundPos - myRoot.Position
            local bv = myRoot:FindFirstChild("BountyBV")
            if bv then
                bv.Velocity = diff.Unit * 120
            end
            task.wait(0.03)
        end

        local bv = myRoot and myRoot:FindFirstChild("BountyBV")
        if bv then bv.Velocity = Vector3.zero end
        if myRoot then myRoot.CFrame = CFrame.new(safeUndergroundPos) end

        AppState.CurrentCombatStatus = "SAFE BUNKER: Underground Active (-65 Studs) | Regenerating HP..."
    end)
end

