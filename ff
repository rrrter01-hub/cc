-- =========================================================================
-- UTILITIES & CHARACTER HELPERS
-- =========================================================================
local function GetChar(p) return p and p.Character end
local function GetRoot(c) return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso")) end
local function GetHum(c)  return c and c:FindFirstChildOfClass("Humanoid") end

local function GetPlayerBounty(player)
    local ls = player:FindFirstChild("leaderstats")
    if ls then
        local b = ls:FindFirstChild("Bounty/Honor") or ls:FindFirstChild("Bounty") or ls:FindFirstChild("Honor")
        if b then return b.Value end
    end
    return 0
end

Stats.StartBounty = GetPlayerBounty(LocalPlayer)
Stats.CurrentBounty = Stats.StartBounty

-- =========================================================================
-- STATUS CHECKER (PvP & SafeZone Detection)
-- =========================================================================
local function CheckTargetStatus(player)
    local st = {
        IsAlive = false,
        InSafeZone = false,
        PvPEnabled = true,
        Health = 0,
        MaxHealth = 100,
        Distance = 0,
        CanAttack = false
    }

    if not player or not player.Parent then return st end

    local char = GetChar(player)
    local myChar = GetChar(LocalPlayer)
    local hum = GetHum(char)
    local root = GetRoot(char)
    local myRoot = GetRoot(myChar)

    if not char or not hum or not root then return st end

    st.Health = math.floor(hum.Health)
    st.MaxHealth = math.floor(hum.MaxHealth)
    st.IsAlive = hum.Health > 0

    if myRoot and root then
        st.Distance = math.floor((root.Position - myRoot.Position).Magnitude)
    end

    if char:FindFirstChild("SafeZoneShield") or char:FindFirstChild("InSafeZone") then
        st.InSafeZone = true
    end

    if char:FindFirstChild("PvPDisabled") or player:GetAttribute("PvPDisabled") == true then
        st.PvPEnabled = false
    end

    st.CanAttack = st.IsAlive and st.PvPEnabled and not st.InSafeZone and (player.Team ~= LocalPlayer.Team)
    return st
end

-- =========================================================================
-- NOCLIP & ANTI-GRAVITY CONTROLLER (บินลื่น ไม่ติดแมพ)
-- =========================================================================
local function ApplyPhysicsBypass(myRoot)
    local bv = myRoot:FindFirstChild("BountyFlightBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "BountyFlightBV"
        bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        bv.Velocity = Vector3.zero
        bv.Parent = myRoot
    end

    local bg = myRoot:FindFirstChild("BountyFlightBG")
    if not bg then
        bg = Instance.new("BodyGyro")
        bg.Name = "BountyFlightBG"
        bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        bg.P = 10000
        bg.Parent = myRoot
    end
end

local function RemovePhysicsBypass(myRoot)
    if not myRoot then return end
    local bv = myRoot:FindFirstChild("BountyFlightBV")
    if bv then bv:Destroy() end
    local bg = myRoot:FindFirstChild("BountyFlightBG")
    if bg then bg:Destroy() end
end

