                    hrp.CFrame = eHRP.CFrame * CFrame.new(0, Settings.FarmDistance, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                    hrp.Velocity = Vector3.zero
                    equipSelectedWeapon(Settings.SelectedWeapon)
                    VirtualUser:CaptureController()
                    VirtualUser:Button1Down(Vector2.new(0, 0))
