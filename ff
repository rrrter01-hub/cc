RunService.Heartbeat:Connect(function(dt)
    if AppState.IsRetreating or AppState.IsWarping then return end
    if not AppState.IsHunting or not AppState.SelectedPlayer then return end

    local myChar = GetChar(LocalPlayer)
    local myRoot = GetRoot(myChar)
    local myHum = GetHum(myChar)

    if not myChar or not myRoot or not myHum or myHum.Health <= 0 then
        StopHunt("Player Dead")
        return
    end

    local currentHpPercent = (myHum.Health / math.max(1, myHum.MaxHealth)) * 100

    -- Emergency Sky Heal
    if Config.EmergencyEscape and (currentHpPercent <= Config.EmergencyHPThreshold or AppState.IsHealingInSky) then
        if currentHpPercent < Config.RecoveryHPThreshold then
            AppState.IsHealingInSky = true
            AppState.CurrentCombatStatus = string.format("EMERGENCY RETREAT: Sky Healing (%d%% HP)", math.floor(currentHpPercent))
            
            ApplyPhysics(myRoot)
            EnsureKen()
            EnsureBuso()
            
            local skyPos = Vector3.new(myRoot.Position.X, Config.MaxSkyAltitude, myRoot.Position.Z)
            local diff = skyPos - myRoot.Position
            local bv = myRoot:FindFirstChild("BountyBV")
            if bv then
                bv.Velocity = diff.Magnitude > 15 and diff.Unit * Config.FlySpeed or Vector3.zero
            end
            return
        else
            AppState.IsHealingInSky = false
        end
    end

    local targetChar = GetChar(AppState.SelectedPlayer)
    local targetHum = GetHum(targetChar)
    local targetRoot = GetRoot(targetChar)

    if not targetChar or not targetHum or targetHum.Health <= 0 or not targetChar.Parent then
        TriggerMaxSkyRetreat()
        return
    end

    local st = CheckTargetStatus(AppState.SelectedPlayer)
    if not st.CanAttack then
        if Config.AutoTarget then
            local nextTarget = FindBestTarget()
            if nextTarget then
                AppState.SelectedPlayer = nextTarget
                local nRoot = GetRoot(GetChar(nextTarget))
                if nRoot then PerformTacticalSkyWarp(nRoot) end
                return
            end
        end
        StopHunt("Disengaged: " .. st.Reason)
        return
    end

    if not targetRoot then return end

    -- เปิดฮาคิทั้งสองแบบต่อเนื่อง
    EnsureKen()
    EnsureBuso()
    ApplyPhysics(myRoot)

    -- ตรวจสอบระยะวาร์ปข้ามเกาะ
    local curDist = (targetRoot.Position - myRoot.Position).Magnitude
    if curDist > Config.WarpDistanceThreshold then
        PerformTacticalSkyWarp(targetRoot)
        return
    end

    -- คำนวณตำแหน่งดิ่งโจมตีและประกบหลัง
    local targetVel = targetRoot.AssemblyLinearVelocity or targetRoot.Velocity or Vector3.zero
    local predictedPos = targetRoot.Position + (targetVel * 0.12)
    local predictedCFrame = CFrame.new(predictedPos, predictedPos + targetRoot.CFrame.LookVector)
    local targetBlindspot = predictedCFrame * CFrame.new(0, Config.BlindspotHeight, Config.BlindspotDistance)

    local currentPos = myRoot.Position
    local dist = (targetBlindspot.Position - currentPos).Magnitude

    local bg = myRoot:FindFirstChild("BountyBG")
    if bg then
        bg.CFrame = CFrame.lookAt(myRoot.Position, targetRoot.Position)
    end

    if dist > 3.2 then
        AppState.CurrentCombatStatus = "Diving onto target (" .. math.floor(dist) .. "m)"
        local dir = (targetBlindspot.Position - currentPos).Unit
        local bv = myRoot:FindFirstChild("BountyBV")
        if bv then
            bv.Velocity = dir * math.min(Config.DiveSpeed, dist * 42)
        end
    else
        local bv = myRoot:FindFirstChild("BountyBV")
        if bv then bv.Velocity = Vector3.zero end
        
        if Config.EnableOneShotCombo and not AppState.IsComboExecuting then
            ExecuteApexOneShotChain()
        end
    end
end)

