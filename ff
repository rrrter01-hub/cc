-- =========================================================================
-- ANTI-STUCK DETECTION
-- =========================================================================
local function CheckStuck(myRoot)
    if not myRoot then return false end
    local currentPos = myRoot.Position
    if (currentPos - AppState.LastPos).Magnitude < Config.StuckThreshold then
        AppState.StuckTimer = AppState.StuckTimer + Config.StuckCheckInterval
        if AppState.StuckTimer >= 1.0 then
            return true
        end
    else
        AppState.StuckTimer = 0
    end
    AppState.LastPos = currentPos
    return false
end

local function Unstuck(myRoot)
    if not myRoot then return end
    pcall(function()
        local randDir = Vector3.new(
            math.random(-1, 1),
            1,
            math.random(-1, 1)
        ).Unit
        local bv = myRoot:FindFirstChild("BountyBV")
        if bv then
            bv.Velocity = randDir * (Config.FlySpeed + 200)
        end
        task.wait(0.15)
        if bv then bv.Velocity = Vector3.zero end
    end)
end

-- =========================================================================
-- POST-KILL MAXIMUM SKY RETREAT
-- =========================================================================
local function TriggerMaxSkyRetreat()
    if AppState.IsRetreating then return end
    AppState.IsHunting = false
    AppState.IsHealingInSky = false
    AppState.IsRetreating = true
    AppState.CurrentCombatStatus = string.format("TARGET ELIMINATED! Ascending to Max Sky (%dm)...", Config.MaxSkyAltitude)

    task.spawn(function()
        local startTime = tick()
        local reachedSky = false
        while (tick() - startTime < Config.PostKillSkyDuration) do
            local myChar = GetChar(LocalPlayer)
            local myRoot = GetRoot(myChar)
            local myHum = GetHum(myChar)
            if myRoot and myHum and myHum.Health > 0 then
                ApplyPhysics(myRoot)
                EnsureKen()
                EnsureBuso()
                local maxSkyPos = Vector3.new(myRoot.Position.X, Config.MaxSkyAltitude, myRoot.Position.Z)
                local diff = maxSkyPos - myRoot.Position
                local bv = myRoot:FindFirstChild("BountyBV")
                if bv then
                    if diff.Magnitude > 15 then
                        bv.Velocity = diff.Unit * (Config.FlySpeed + 150)
                    else
                        bv.Velocity = Vector3.zero
                        reachedSky = true
                    end
                end
                -- ตรวจสอบว่าติดอยู่ไหม ถ้าติด -> กระโดดขึ้น
                if CheckStuck(myRoot) then
                    Unstuck(myRoot)
                end
            end
            task.wait(0.03)
        end
        local myChar = GetChar(LocalPlayer)
        local myRoot = GetRoot(myChar)
        local bv = myRoot and myRoot:FindFirstChild("BountyBV")
        if bv then bv.Velocity = Vector3.zero end
        AppState.IsRetreating = false
        AppState.SelectedPlayer = nil
        AppState.StuckTimer = 0
        StopHunt("Elimination Safe (Ready for Next Target)")
    end)
end

-- =========================================================================
-- MAIN COMBAT & NAVIGATION ENGINE LOOP
-- =========================================================================
RunService.Heartbeat:Connect(function()
    if AppState.IsRetreating then return end
    if not AppState.IsHunting or not AppState.SelectedPlayer then return end

    local myChar = GetChar(LocalPlayer)
    local myRoot = GetRoot(myChar)
    local myHum = GetHum(myChar)

    if not myChar or not myRoot or not myHum or myHum.Health <= 0 then
        StopHunt("Player Dead")
        return
    end

    local currentHpPercent = (myHum.Health / math.max(1, myHum.MaxHealth)) * 100

    -- Emergency Sky Heal
    if Config.EmergencyEscape and (currentHpPercent <= Config.EmergencyHPThreshold or AppState.IsHealingInSky) then
        if currentHpPercent < Config.RecoveryHPThreshold then
            AppState.IsHealingInSky = true
            AppState.CurrentCombatStatus = string.format("EMERGENCY ESCAPE: Max Sky Healing (%d%% HP)", math.floor(currentHpPercent))
            ApplyPhysics(myRoot)
            EnsureKen()
            EnsureBuso()
            local skyPos = Vector3.new(myRoot.Position.X, Config.MaxSkyAltitude, myRoot.Position.Z)
            local diff = skyPos - myRoot.Position
            local bv = myRoot:FindFirstChild("BountyBV")
            if bv then
                bv.Velocity = diff.Magnitude > 15 and diff.Unit * Config.FlySpeed or Vector3.zero
            end
            if CheckStuck(myRoot) then Unstuck(myRoot) end
            return
        else
            AppState.IsHealingInSky = false
        end
    end

    local targetChar = GetChar(AppState.SelectedPlayer)
    local targetHum = GetHum(targetChar)
    local targetRoot = GetRoot(targetChar)

    -- เป้าหมายตาย -> บินขึ้นฟ้าทันที
    if not targetChar or not targetHum or targetHum.Health <= 0 or not targetChar.Parent then
        TriggerMaxSkyRetreat()
        return
    end

    local st = CheckTargetStatus(AppState.SelectedPlayer)
    if not st.CanAttack then
        StopHunt("Disengaged: " .. st.Reason)
        return
    end
    if not targetRoot then return end

    EnsureBuso()
    EnsureKen()
    TriggerRaceSkill()
    ApplyPhysics(myRoot)

    -- ANTI-STUCK: ถ้าติด -> สะดุดก่อน
    if CheckStuck(myRoot) then
        Unstuck(myRoot)
        return
    end

    -- คำนวณตำแหน่งโจมตี
    local dist = (targetRoot.Position - myRoot.Position).Magnitude

    local bg = myRoot:FindFirstChild("BountyBG")
    if bg then
        bg.CFrame = CFrame.lookAt(myRoot.Position, targetRoot.Position)
    end

    if dist > 25 then
        -- อยู่ไกล -> พุ่งไปหา
        AppState.CurrentCombatStatus = "Rushing to Target (" .. math.floor(dist) .. "m)"
        local targetPos = (targetRoot.CFrame * CFrame.new(0, Config.HeightOffset, Config.StickDistance)).Position
        local dir = (targetPos - myRoot.Position).Unit
        local bv = myRoot:FindFirstChild("BountyBV")
        if bv then
            bv.Velocity = dir * math.min(Config.FlySpeed, dist * 35)
        end
    else
        -- อยู่ใกล้ -> ORBIT STRAFE พร้อมโจมตีต่อเนื่อง
        local strafeTarget = Config.EnableStrafe
            and ComputeStrafePosition(targetRoot, myRoot)
            or  (targetRoot.CFrame * CFrame.new(0, Config.HeightOffset, Config.StickDistance)).Position

        local strafeDiff = strafeTarget - myRoot.Position
        local strafeMag = strafeDiff.Magnitude
        local bv = myRoot:FindFirstChild("BountyBV")
        if bv then
            if strafeMag > 0.5 then
                bv.Velocity = strafeDiff.Unit * math.min(Config.FlySpeed, strafeMag * 20)
            else
                bv.Velocity = Vector3.zero
            end
        end

