-- 6. FULL AUTO STATE ENGINE
-- =========================================================================
local function setState(newState)
    print(string.format("[Auto Sea Hunter] %s ➔ %s", State.Current, newState))
    State.Current = newState
    State.StateStartTime = os.time()
end

task.spawn(function()
    print("[+] 100% Full Auto Sea Beast Hunter Engine Active!")

    while task.wait(0.1) do
        if Config.Enabled then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChild("Humanoid")
                if not (hrp and hum and hum.Health > 0) then return end

                -- 1. Auto Low-HP Sky Heal
                local hpPercent = (hum.Health / hum.MaxHealth) * 100
                if Config.LowHPEscape and hpPercent <= Config.EscapeHPPercent then
                    State.IsHealing = true
                    hrp.CFrame = CFrame.new(hrp.Position.X, Config.EscapeHeight, hrp.Position.Z)
                    hrp.Velocity = Vector3.zero
                    return
                else
                    State.IsHealing = false
                end

                -- 2. Watchdog Recovery
                if (os.time() - State.StateStartTime) > Config.WatchdogTimeout then
                    if State.Current ~= "STAGE_3_COMBAT" then
                        warn("[Watchdog] Timeout detected. Refreshing patrol...")
                        cancelTween()
                        setState("STAGE_1_FLY_TO_ZONE")
                        return
                    end
                end

                local targetZonePos = ZONE_COORDINATES[Config.SelectedZone] or ZONE_COORDINATES["Zone 6"]

                -- STAGE 1: บินไปยังโซนที่เลือก
                if State.Current == "STAGE_1_FLY_TO_ZONE" then
                    local boss, root = scanZoneBosses()
                    if boss and root then
                        cancelTween()
                        State.TargetEntity = boss
                        State.TargetRootPart = root
                        setState("STAGE_3_COMBAT")
                        return
                    end

                    smoothFly(targetZonePos, Config.FlySpeed)
                    State.ZoneStartTime = os.time()
                    setState("STAGE_2_PATROL_ZONE")

                -- STAGE 2: ลาดตระเวนรอบโซนเพื่อ Trigger Spawn
                elseif State.Current == "STAGE_2_PATROL_ZONE" then
                    local boss, root = scanZoneBosses()
                    if boss and root then
                        cancelTween()
                        State.TargetEntity = boss
                        State.TargetRootPart = root
                        setState("STAGE_3_COMBAT")
                    else
                        local patrolOffset = Vector3.new(math.random(-350, 350), 0, math.random(-350, 350))
                        smoothFly(targetZonePos + patrolOffset, 160)
                        task.wait(1.5)
                    end

                -- STAGE 3: ล็อกเป้าและโจมตี
                elseif State.Current == "STAGE_3_COMBAT" then
                    local target = State.TargetEntity
                    local root = State.TargetRootPart
                    if target and target:FindFirstChild("Humanoid") and target.Humanoid.Health > 0 and root then
                        local hoverCFrame = CFrame.lookAt(root.Position + Vector3.new(0, Config.SafeCombatHeight, 0), root.Position)
                        hrp.CFrame = hoverCFrame
                        hrp.Velocity = Vector3.zero

                        executeCombatCombos(root)
                    else
                        -- อัปเดตสถิติ
                        if target then
                            local name = string.lower(target.Name)
                            if string.find(name, "sea") then Stats.SeaBeastsKilled = Stats.SeaBeastsKilled + 1
                            elseif string.find(name, "terror") then Stats.TerrorSharksKilled = Stats.TerrorSharksKilled + 1
                            elseif string.find(name, "ship") then Stats.GhostShipsKilled = Stats.GhostShipsKilled + 1 end
                        end

                        -- ตรวจสอบตัวถัดไป (Rumbling 3x)
                        local nextBoss, nextRoot = scanZoneBosses()
                        if nextBoss and nextRoot then
                            State.TargetEntity = nextBoss
                            State.TargetRootPart = nextRoot
                            State.StateStartTime = os.time()
                        else
                            task.wait(2) -- รอรับ Beli & Frag
                            State.TargetEntity = nil
                            State.TargetRootPart = nil
                            setState("STAGE_2_PATROL_ZONE")
                        end
                    end
                end
            end)
        end
    end
end)

