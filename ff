-- =========================================================================
-- APEX PRECISION ONE-SHOT COMBO ENGINE
-- =========================================================================
local function AimDirectlyAtTarget(targetRoot)
    if not targetRoot then return end
    local targetVel = targetRoot.AssemblyLinearVelocity or targetRoot.Velocity or Vector3.zero
    local aimPos = targetRoot.Position + (targetVel * Config.AimLeadPrediction)
    
    Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, aimPos)
    pcall(function()
        local screenPos, onScreen = Camera:WorldToViewportPoint(aimPos)
        if onScreen then
            VirtualInputManager:SendMouseMoveEvent(screenPos.X, screenPos.Y, game)
        end
    end)
end

local function ExecuteApexOneShotChain()
    if AppState.IsComboExecuting then return end
    if not AppState.IsHunting or not AppState.SelectedPlayer or AppState.IsHealingInSky or AppState.IsRetreating then return end

    local targetChar = GetChar(AppState.SelectedPlayer)
    local targetRoot = GetRoot(targetChar)
    local targetHum = GetHum(targetChar)
    if not targetChar or not targetRoot or not targetHum or targetHum.Health <= 0 then return end

    AppState.IsComboExecuting = true
    AppState.CurrentCombatStatus = "Executing Apex One-Shot Combo..."
    Stats.ComboExecutions = Stats.ComboExecutions + 1

    task.spawn(function()
        EnsureBuso()
        EnsureKen()
        TriggerRaceV3()
        TriggerRaceV4()

        for _, step in ipairs(Config.ComboSequence) do
            if not AppState.IsHunting or AppState.IsHealingInSky or AppState.IsRetreating then break end
            if not targetHum or targetHum.Health <= 0 or not targetChar.Parent then break end

            local tool = EquipWeapon(step.Weapon)
            task.wait(0.03)

            AimDirectlyAtTarget(targetRoot)

            pcall(function()
                VirtualInputManager:SendKeyEvent(true, step.Key, false, game)
                task.wait(step.Hold or 0.05)
                VirtualInputManager:SendKeyEvent(false, step.Key, false, game)
            end)

            if Config.M1ShredBurst then FireFastAttack() end
            task.wait(step.Delay or 0.15)
        end

        if targetHum and targetHum.Health > 0 then
            EquipWeapon("Melee")
            for i = 1, 6 do
                if not AppState.IsHunting or targetHum.Health <= 0 then break end
                AimDirectlyAtTarget(targetRoot)
                FireFastAttack()
                task.wait(0.03)
            end
        end

        AppState.IsComboExecuting = false
    end)
end

-- =========================================================================
-- TARGET EVALUATOR
-- =========================================================================
local function CheckTargetStatus(player)
    local st = {
        IsAlive = false,
        InSafeZone = false,
        PvPEnabled = true,
        Health = 0,
        MaxHealth = 100,
        Distance = 99999,
        Level = 1,
        Bounty = 0,
        CanAttack = false,
        Reason = "OK"
    }

    if not player or not player.Parent or player == LocalPlayer then 
        st.Reason = "Invalid Target"
        return st 
    end

    st.Level = GetPlayerLevel(player)
    st.Bounty = GetPlayerBounty(player)

    local char = GetChar(player)
    local myChar = GetChar(LocalPlayer)
    local hum = GetHum(char)
    local root = GetRoot(char)
    local myRoot = GetRoot(myChar)

    if not char or not hum or not root then 
        st.Reason = "Dead / No Character"
        return st 
    end

    st.Health = math.floor(hum.Health)
    st.MaxHealth = math.floor(hum.MaxHealth)
    st.IsAlive = hum.Health > 0

    if myRoot and root then
        st.Distance = math.floor((root.Position - myRoot.Position).Magnitude)
    end

    if char:FindFirstChild("SafeZoneShield") 
        or char:FindFirstChild("InSafeZone") 
        or char:FindFirstChild("ForceField")
        or char:FindFirstChild("SafeZone")
        or player:GetAttribute("InSafeZone") == true
        or player:GetAttribute("SafeZone") == true then
        st.InSafeZone = true
    end

    if char:FindFirstChild("PvPDisabled")
        or char:FindFirstChild("PVPDisabled")
        or player:FindFirstChild("PvPDisabled")
        or player:GetAttribute("PvPDisabled") == true
        or player:GetAttribute("PvP") == false then
        st.PvPEnabled = false
    end

    if LocalPlayer.Team and player.Team then
        if LocalPlayer.Team.Name == "Marines" and player.Team.Name == "Marines" then
            st.Reason = "Same Marine Team"
            return st
        end
    end

    if not st.IsAlive then
        st.Reason = "Dead"
    elseif st.InSafeZone then
        st.Reason = "In SafeZone"
    elseif not st.PvPEnabled then
        st.Reason = "PvP Disabled"
    else
        st.CanAttack = true
        st.Reason = "Ready for Combat"
    end

    return st
end

local function FindBestTarget()
    local candidates = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local st = CheckTargetStatus(p)
            if st.CanAttack then
                table.insert(candidates, { Player = p, Status = st })
            end
        end
    end

    if #candidates == 0 then return nil end

    table.sort(candidates, function(a, b)
        if Config.TargetPriority == "LowestHP" then
            return a.Status.Health < b.Status.Health
        elseif Config.TargetPriority == "Closest" then
            return a.Status.Distance < b.Status.Distance
        elseif Config.TargetPriority == "HighestBounty" then
            return a.Status.Bounty > b.Status.Bounty
        end
        return a.Status.Distance < b.Status.Distance
    end)

    return candidates[1].Player
end

