    local currentHpPercent = (myHum.Health / math.max(1, myHum.MaxHealth)) * 100

    -- =========================================================================
    -- STRATOSPHERE ORBIT ESCAPE (เลือดต่ำกว่า 35% ลอยขึ้นฟ้านอกโลก 2,200 Studs)
    -- =========================================================================
    if Config.EmergencyEscape and (currentHpPercent <= Config.EmergencyHPThreshold or AppState.IsHealingInSpace) then
        if currentHpPercent < Config.RecoveryHPThreshold then
            AppState.IsHealingInSpace = true
            AppState.CurrentCombatStatus = string.format("🌌 SPACE ORBIT RECOVERY (%d%% HP) [Altitude: %dm]", math.floor(currentHpPercent), math.floor(myRoot.Position.Y))
            
            ApplyPhysics(myRoot)
            EnsureKen()
            EnsureBuso()
            
            local spacePos = Vector3.new(myRoot.Position.X, Config.StratosphereAltitude, myRoot.Position.Z)
            local diff = spacePos - myRoot.Position
            local bv = myRoot:FindFirstChild("BountyBV")
            if bv then
                -- พุ่งขึ้นตรงสู่ชั้นอวกาศด้วยความเร็วสูง
                bv.Velocity = diff.Magnitude > 15 and diff.Unit * 420 or Vector3.zero
            end
            return
        else
            AppState.IsHealingInSpace = false
        end
    end

    local targetChar = GetChar(AppState.SelectedPlayer)
    local targetHum = GetHum(targetChar)
    local targetRoot = GetRoot(targetChar)

    -- ตรวจสอบการตายของเป้าหมาย -> คืนค่าการเดินปกติทันที 100% ไม่มียืนนิ่ง
    if not targetChar or not targetHum or targetHum.Health <= 0 or not targetChar.Parent then
        StopHunt("Target Eliminated! Movement 100% Free")
        return
    end

    -- ตรวจสอบ SafeZone / PvP
    local st = CheckTargetStatus(AppState.SelectedPlayer)
    if not st.CanAttack then
        StopHunt("Disengaged: " .. st.Reason)
        return
    end

    if not targetRoot then return end

    EnsureBuso()
    EnsureKen()
    TriggerRaceSkill()
    ApplyPhysics(myRoot)

    -- =========================================================================
    -- ZERO-GAP RELENTLESS PURSUIT (ล็อคประกบติดหลัง 1.2 Studs ไร้ช่องว่าง)
    -- =========================================================================
    local targetVel = targetRoot.AssemblyLinearVelocity
    local stickCFrame = targetRoot.CFrame * CFrame.new(0, Config.HeightOffset, Config.StickDistance)
    local targetPos = stickCFrame.Position
    local currentPos = myRoot.Position
    local diff = targetPos - currentPos
    local dist = diff.Magnitude

    local bg = myRoot:FindFirstChild("BountyBG")
    if bg then
        bg.CFrame = CFrame.lookAt(myRoot.Position, targetRoot.Position)
    end

    local bv = myRoot:FindFirstChild("BountyBV")
    if dist > 1.8 then
        -- ศัตรูพุ่ง/แดช/โซรูหนี -> พุ่งติดตามดูดติดทันทีด้วยความเร็วสูงสุด
        AppState.CurrentCombatStatus = "⚡ Zero-Gap Pursuing Target (" .. math.floor(dist) .. "m)"
        if bv then
            bv.Velocity = diff.Unit * math.min(Config.FlySpeed, dist * 40)
        end
    else
        -- ประชิดแนบเนื้อ -> ซิงค์ความเร็วและล็อคมุมมอง
        if bv then 
            bv.Velocity = targetVel 
        end
        myRoot.CFrame = CFrame.lookAt(targetPos, targetRoot.Position)
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetRoot.Position)
        AppState.CurrentCombatStatus = "💥 Clamped & Bursting: Auto M1 + 3-Weapon Combo"
        
        SendTauntMessage(AppState.SelectedPlayer)
    end
end)

