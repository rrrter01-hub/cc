    task.spawn(function()
        local myChar = GetChar(LocalPlayer)
        local myRoot = GetRoot(myChar)
        local myHum = GetHum(myChar)
        if not myChar or not myRoot or not myHum then return end

        AppState.IsRetreating = true
        AppState.IsHunting = false
        AppState.IsUnderground = false
        AppState.CurrentCombatStatus = string.format("Ascending to High Sky (Anti-Rollback)...")

        local travelAltitude = Config.TravelSkyAltitude
        local targetVec = typeof(targetPos) == "CFrame" and targetPos.Position or targetPos

        -- Phase 1: ลอยตัวขึ้นสู่ท้องฟ้าชั้นสูงตรงๆ
        local startLift = tick()
        while tick() - startLift < 2.2 do
            myChar = GetChar(LocalPlayer)
            myRoot = GetRoot(myChar)
            if not myRoot then break end
            
            ApplyPhysics(myRoot)
            EnsureKen()
            EnsureBuso()

            local skyLiftPos = Vector3.new(myRoot.Position.X, travelAltitude, myRoot.Position.Z)
            local diff = skyLiftPos - myRoot.Position
            if diff.Magnitude < 15 then break end

            local bv = myRoot:FindFirstChild("BountyBV")
            if bv then
                bv.Velocity = diff.Unit * Config.TravelFlySpeed
            end
            task.wait(0.03)
        end

        -- Phase 2: บินบนฟ้าชั้นบรรยากาศตรงไปยังปลายทาง
        local skyTargetPos = Vector3.new(targetVec.X, travelAltitude, targetVec.Z)
        while true do
            myChar = GetChar(LocalPlayer)
            myRoot = GetRoot(myChar)
            myHum = GetHum(myChar)
            if not myChar or not myRoot or not myHum or myHum.Health <= 0 then break end

            ApplyPhysics(myRoot)
            EnsureKen()
            EnsureBuso()

            local horizontalDist = (Vector3.new(myRoot.Position.X, 0, myRoot.Position.Z) - Vector3.new(targetVec.X, 0, targetVec.Z)).Magnitude
            AppState.CurrentCombatStatus = string.format("Flying to %s (%dm) [No Rollback]", destinationName or "Destination", math.floor(horizontalDist))

            if horizontalDist <= 20 then
                break
            end

            local dir = (skyTargetPos - myRoot.Position).Unit
            local bv = myRoot:FindFirstChild("BountyBV")
            local bg = myRoot:FindFirstChild("BountyBG")
            if bg then
                bg.CFrame = CFrame.lookAt(myRoot.Position, Vector3.new(targetVec.X, myRoot.Position.Y, targetVec.Z))
            end
            if bv then
                bv.Velocity = dir * Config.TravelFlySpeed
            end
            task.wait(0.03)
        end

        -- Phase 3: ร่อนลงสู่พื้นผิวปลายทางอย่างนุ่มนวล
        local descendStart = tick()
        AppState.CurrentCombatStatus = string.format("Soft Landing at %s...", destinationName or "Destination")
        while tick() - descendStart < 4.0 do
            myChar = GetChar(LocalPlayer)
            myRoot = GetRoot(myChar)
            if not myRoot then break end

            local diff = (targetVec + Vector3.new(0, 3, 0)) - myRoot.Position
            if diff.Magnitude <= 6 then break end

            local bv = myRoot:FindFirstChild("BountyBV")
            if bv then
                bv.Velocity = diff.Unit * math.min(Config.TravelFlySpeed, diff.Magnitude * 14)
            end
            task.wait(0.03)
        end

        myChar = GetChar(LocalPlayer)
        myRoot = GetRoot(myChar)
        local bv = myRoot and myRoot:FindFirstChild("BountyBV")
        if bv then bv.Velocity = Vector3.zero end

        AppState.IsRetreating = false
        AppState.SelectedPlayer = nil
        StopHunt(string.format("Arrived at %s (Safe)", destinationName or "Destination"))
        
        if onComplete then onComplete() end
    end)
end

-- =========================================================================
-- MAIN COMBAT ENGINE LOOP (OVERHEAD HELIX ORBIT)
-- =========================================================================
RunService.Heartbeat:Connect(function()
    if AppState.IsRetreating or AppState.IsUnderground then return end
    if not AppState.IsHunting or not AppState.SelectedPlayer then return end

    local myChar = GetChar(LocalPlayer)
    local myRoot = GetRoot(myChar)
    local myHum = GetHum(myChar)

    if not myChar or not myRoot or not myHum or myHum.Health <= 0 then
        StopHunt("Player Dead")
        return
    end

    local currentHpPercent = (myHum.Health / math.max(1, myHum.MaxHealth)) * 100

    -- Emergency Bunker Dive when low HP
    if Config.EmergencyEscape and (currentHpPercent <= Config.EmergencyHPThreshold) then
        TriggerUndergroundRetreat()
        return
    end

    local targetChar = GetChar(AppState.SelectedPlayer)
    local targetHum = GetHum(targetChar)
    local targetRoot = GetRoot(targetChar)

    -- ตรวจสอบการตายของเป้าหมาย -> มุดดินหลบภัยทันที
    if not targetChar or not targetHum or targetHum.Health <= 0 or not targetChar.Parent then
        TriggerUndergroundRetreat()
        return
    end

    -- ตรวจสอบ SafeZone / PvP
    local st = CheckTargetStatus(AppState.SelectedPlayer)
    if not st.CanAttack then
        StopHunt("Disengaged: " .. st.Reason)
        return
    end

    if not targetRoot then return end

    EnsureBuso()
    EnsureKen()
    TriggerRaceSkill()
    ApplyPhysics(myRoot)

    -- คำนวณตำแหน่งเหนือหัว + หมุนวนหลบสกิล (Helix Orbit)
    local orbitAngle = tick() * Config.OrbitSpeed
    local xOffset = math.cos(orbitAngle) * Config.OrbitRadius
    local zOffset = math.sin(orbitAngle) * Config.OrbitRadius
    
    local verticalJitter = Config.EnableEvasiveJitter and (math.sin(tick() * 8) * 1.2) or 0
    local targetHeight = Config.OverheadHeight + verticalJitter

    local targetOverheadPos = targetRoot.Position + Vector3.new(xOffset, targetHeight, zOffset)
    local currentPos = myRoot.Position
    local dist = (targetOverheadPos - currentPos).Magnitude

    local bg = myRoot:FindFirstChild("BountyBG")
    if bg then
        bg.CFrame = CFrame.lookAt(myRoot.Position, targetRoot.Position)
    end

    if dist > 4.5 then
        AppState.CurrentCombatStatus = "Rushing to Overhead Position (" .. math.floor(dist) .. "m)"
        local dir = (targetOverheadPos - currentPos).Unit
        local bv = myRoot:FindFirstChild("BountyBV")
        if bv then
            bv.Velocity = dir * math.min(Config.FlySpeed, dist * 32)
        end
    else
        local bv = myRoot:FindFirstChild("BountyBV")
        if bv then bv.Velocity = Vector3.zero end
        
        myRoot.CFrame = CFrame.lookAt(targetOverheadPos, targetRoot.Position)
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetRoot.Position)
        AppState.CurrentCombatStatus = "Overhead Burst: M1 + Skills (Z,X,C,V) Active"
    end
end)

