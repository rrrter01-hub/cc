-- 7. MAIN STATE MACHINE LOOP
-- =========================================================================
local function setHunterState(newState)
    print(string.format("[Sea Hunter Pro] Transition: %s ➔ %s", State.Current, newState))
    State.Current = newState
    State.StateStartTime = os.time()
end

task.spawn(function()
    print("[+] Ultimate Sea Beast Hunter Pro Initialized!")

    while task.wait(0.1) do
        if Config.Enabled then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChild("Humanoid")
                if not (hrp and hum and hum.Health > 0) then return end

                -- EMERGENCY LOW HP HEALING (บินขึ้นฟ้าหลบเพื่อรีเลือด)
                local hpPercent = (hum.Health / hum.MaxHealth) * 100
                if Config.LowHPSafeEscape and hpPercent <= Config.EscapeHPPercent then
                    State.IsHealing = true
                    hrp.CFrame = CFrame.new(hrp.Position.X, Config.EscapeHeight, hrp.Position.Z)
                    hrp.Velocity = Vector3.zero
                    return
                else
                    State.IsHealing = false
                end

                -- WATCHDOG TIMEOUT RECOVERY
                if (os.time() - State.StateStartTime) > Config.WatchdogTimeout then
                    if State.Current ~= "STAGE_3_COMBAT" then
                        warn("[Watchdog] Resetting state due to inactivity...")
                        cancelTween()
                        setHunterState("STAGE_4_RESET")
                        return
                    end
                end

                -- STAGE 1: บินตรงสู่ Danger Zone 6
                if State.Current == "STAGE_1_FLY_ZONE6" then
                    local boss, root = scanAllSeaBosses()
                    if boss and root then
                        cancelTween()
                        State.TargetEntity = boss
                        State.TargetRootPart = root
                        setHunterState("STAGE_3_COMBAT")
                        return
                    end

                    smoothFly(ZONE_6_TARGET, Config.FlySpeed)
                    State.SailingStartTime = os.time()
                    setHunterState("STAGE_2_PATROL_ZONE6")

                -- STAGE 2: ลอยตัววนรอบ Danger Zone 6
                elseif State.Current == "STAGE_2_PATROL_ZONE6" then
                    local boss, root = scanAllSeaBosses()
                    if boss and root then
                        cancelTween()
                        State.TargetEntity = boss
                        State.TargetRootPart = root
                        setHunterState("STAGE_3_COMBAT")
                    else
                        local patrolOffset = Vector3.new(math.random(-350, 350), 0, math.random(-350, 350))
                        smoothFly(ZONE_6_TARGET + patrolOffset, 160)
                        task.wait(1.5)
                    end

                -- STAGE 3: โหมดต่อสู้ล็อกเป้า (Combat Lock)
                elseif State.Current == "STAGE_3_COMBAT" then
                    local target = State.TargetEntity
                    local root = State.TargetRootPart
                    if target and target:FindFirstChild("Humanoid") and target.Humanoid.Health > 0 and root then
                        local hoverCFrame = CFrame.lookAt(root.Position + Vector3.new(0, Config.SafeCombatHeight, 0), root.Position)
                        hrp.CFrame = hoverCFrame
                        hrp.Velocity = Vector3.zero

                        executeCombatRotations(root)
                    else
                        if target then
                            local tName = string.lower(target.Name)
                            if string.find(tName, "sea") then Stats.SeaBeastsKilled = Stats.SeaBeastsKilled + 1
                            elseif string.find(tName, "terror") then Stats.TerrorSharksKilled = Stats.TerrorSharksKilled + 1
                            elseif string.find(tName, "ship") then Stats.GhostShipsKilled = Stats.GhostShipsKilled + 1 end
                        end

                        local nextBoss, nextRoot = scanAllSeaBosses()
                        if nextBoss and nextRoot then
                            State.TargetEntity = nextBoss
                            State.TargetRootPart = nextRoot
                            State.StateStartTime = os.time()
                        else
                            task.wait(2)
                            setHunterState("STAGE_4_RESET")
                        end
                    end

                -- STAGE 4: รับรางวัลและรีเซ็ตลูป
                elseif State.Current == "STAGE_4_RESET" then
                    State.TargetEntity = nil
                    State.TargetRootPart = nil
                    cancelTween()
                    setHunterState("STAGE_2_PATROL_ZONE6")
                end
            end)
        end
    end
end)

