-- =========================================================================
-- STATUS CHECKER (SafeZone, PvP Status, HP, Distance)
-- =========================================================================
local function CheckTargetStatus(player)
    local st = {
        IsAlive = false,
        InSafeZone = false,
        PvPEnabled = true,
        Health = 0,
        MaxHealth = 100,
        Distance = 0,
        CanAttack = false
    }

    if not player or not player.Parent then return st end

    local char = GetChar(player)
    local myChar = GetChar(LocalPlayer)
    local hum = GetHum(char)
    local root = GetRoot(char)
    local myRoot = GetRoot(myChar)

    if not char or not hum or not root then return st end

    st.Health = math.floor(hum.Health)
    st.MaxHealth = math.floor(hum.MaxHealth)
    st.IsAlive = hum.Health > 0

    if myRoot and root then
        st.Distance = math.floor((root.Position - myRoot.Position).Magnitude)
    end

    if char:FindFirstChild("SafeZoneShield") or char:FindFirstChild("InSafeZone") or char:FindFirstChild("ForceField") then
        st.InSafeZone = true
    end

    if char:FindFirstChild("PvPDisabled") or player:GetAttribute("PvPDisabled") == true then
        st.PvPEnabled = false
    end

    -- Marines ไม่สามารถตี Marines ด้วยกันได้ ส่วน Pirates ตีได้หมด
    local teamCheck = true
    if LocalPlayer.Team and player.Team then
        if LocalPlayer.Team.Name == "Marines" and player.Team.Name == "Marines" then
            teamCheck = false
        end
    end

    st.CanAttack = st.IsAlive and st.PvPEnabled and not st.InSafeZone and teamCheck
    return st
end

-- =========================================================================
-- SMART WEAPON EQUATION (ป้องกัน Equip ซ้ำซ้อนจนขัดจังหวะการตี)
-- =========================================================================
local lastEquippedType = ""
local function EnsureWeaponEquipped(preferredType)
    local char = GetChar(LocalPlayer)
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local hum = GetHum(char)
    if not char or not hum then return nil end

    local equipped = char:FindFirstChildOfClass("Tool")
    if equipped then
        local currentType = equipped.ToolTip ~= "" and equipped.ToolTip or equipped:GetAttribute("WeaponType")
        if not preferredType or currentType == preferredType or equipped.Name:find(preferredType or "") then
            return equipped
        end
    end

    if bp then
        if preferredType then
            for _, tool in ipairs(bp:GetChildren()) do
                if tool:IsA("Tool") then
                    local tType = tool.ToolTip ~= "" and tool.ToolTip or tool:GetAttribute("WeaponType")
                    if tType == preferredType or tool.Name:find(preferredType) then
                        hum:EquipTool(tool)
                        lastEquippedType = preferredType
                        return tool
                    end
                end
            end
        end

        for _, toolType in ipairs({"Melee", "Sword", "Blox Fruit", "Fruit", "Gun"}) do
            for _, tool in ipairs(bp:GetChildren()) do
                if tool:IsA("Tool") then
                    local tType = tool.ToolTip ~= "" and tool.ToolTip or tool:GetAttribute("WeaponType")
                    if tType == toolType or tool.Name:find(toolType) then
                        hum:EquipTool(tool)
                        lastEquippedType = toolType
                        return tool
                    end
                end
            end
        end

        local firstTool = bp:FindFirstChildOfClass("Tool")
        if firstTool then
            hum:EquipTool(firstTool)
            return firstTool
        end
    end

    return equipped
end

