-- AUTO BUFFS & WEAPON CONTROLLER
-- =========================================================================
local function EnsureBuso()
    if not Config.AutoBuso then return end
    local char = GetChar(LocalPlayer)
    if not char then return end
    if not char:FindFirstChild("HasBuso") then
        local rem = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
        if rem then pcall(function() rem:InvokeServer("Buso") end) end
    end
end

local function EnsureKen()
    if not Config.AutoKen then return end
    local char = GetChar(LocalPlayer)
    if not char then return end
    if not char:FindFirstChild("KenHaki") and not char:FindFirstChild("Observation") then
        local remF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
        if remF then pcall(function() remF:InvokeServer("Ken", true) end) end
    end
end

local lastRaceTick = 0
local function TriggerRaceSkill()
    if not Config.AutoRaceV3 then return end
    if tick() - lastRaceTick < 15 then return end
    lastRaceTick = tick()

    pcall(function()
        local rem = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
        if rem then rem:InvokeServer("ActivateAbility") end
    end)
end

local function EquipWeapon(weaponType)
    local char = GetChar(LocalPlayer)
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local hum = GetHum(char)
    if not char or not hum then return nil end

    local currentTool = char:FindFirstChildOfClass("Tool")
    if currentTool then
        local tType = currentTool.ToolTip ~= "" and currentTool.ToolTip or currentTool:GetAttribute("WeaponType")
        if not weaponType or (tType and tType == weaponType) or currentTool.Name:lower():find(weaponType:lower()) then
            return currentTool
        end
    end

    if bp then
        for _, tool in ipairs(bp:GetChildren()) do
            if tool:IsA("Tool") then
                local tType = tool.ToolTip ~= "" and tool.ToolTip or tool:GetAttribute("WeaponType")
                if not weaponType or (tType and tType == weaponType) or tool.Name:lower():find(weaponType:lower()) then
                    hum:EquipTool(tool)
                    return tool
                end
            end
        end
    end
    return currentTool
end

-- =========================================================================
-- COMBAT & FAST ATTACK ENGINE
-- =========================================================================
local Net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
local RegisterAttack = Net and (Net:FindFirstChild("RE/RegisterAttack") or Net:FindFirstChild("RegisterAttack"))
local RegisterHit = Net and (Net:FindFirstChild("RE/RegisterHit") or Net:FindFirstChild("RegisterHit"))

local function ExecuteM1Combo()
    local myChar = GetChar(LocalPlayer)
    local myHum = GetHum(myChar)
    local myRoot = GetRoot(myChar)
    if not myChar or not myHum or not myRoot or myHum.Health <= 0 then return end

    myHum.Sit = false

    local tool = myChar:FindFirstChildOfClass("Tool")
    if not tool or (Config.PrimaryWeapon and not tool.Name:lower():find(Config.PrimaryWeapon:lower()) and tool.ToolTip ~= Config.PrimaryWeapon) then
        tool = EquipWeapon(Config.PrimaryWeapon)
    end

    local targetPlayer = AppState.SelectedPlayer
    local st = targetPlayer and StatusCache[targetPlayer]
    if not st or not st.IsAlive or not st.Root then return end

    if RegisterAttack then
        pcall(function() RegisterAttack:FireServer(0) end)
    end

    if RegisterHit and st.Root then
        pcall(function()
            RegisterHit:FireServer(st.Root, { { st.Char, st.Root } })
        end)
    end

    if tool then
        pcall(function() tool:Activate() end)
    end
end

