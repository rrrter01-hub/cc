-- =========================================================================
local function equipSelectedWeapon()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    if not hum then return end

    local targetType = Config.SelectedWeapon
    for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            if targetType == "Melee" and tool.ToolTip == "Melee" then
                hum:EquipTool(tool)
                return
            elseif targetType == "Sword" and tool.ToolTip == "Sword" then
                hum:EquipTool(tool)
                return
            elseif targetType == "Fruit" and (tool.ToolTip == "Blox Fruit" or string.find(tool.Name, "Fruit")) then
                hum:EquipTool(tool)
                return
            end
        end
    end
end

local function executeCombatCombos(targetRoot)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (hrp and targetRoot) then return end

    hrp.CFrame = CFrame.lookAt(hrp.Position, targetRoot.Position)
    equipSelectedWeapon()
    autoBuffs()

    if Config.FastAttack then
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(0, 0))
    end

    local skillKeys = {
        {Key = Enum.KeyCode.Z, Enabled = Config.Skills.Z},
        {Key = Enum.KeyCode.X, Enabled = Config.Skills.X},
        {Key = Enum.KeyCode.C, Enabled = Config.Skills.C},
        {Key = Enum.KeyCode.V, Enabled = Config.Skills.V},
        {Key = Enum.KeyCode.F, Enabled = Config.Skills.F}
    }

    for _, s in ipairs(skillKeys) do
        if s.Enabled then
            VirtualInputManager:SendKeyEvent(true, s.Key, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, s.Key, false, game)
            task.wait(Config.SkillDelay)
        end
    end
end

local function scanZoneBosses()
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return nil, nil end

    local candidates = {}
    for _, enemy in ipairs(enemies:GetChildren()) do
        local name = string.lower(enemy.Name)
        local isSB = string.find(name, "sea")
        local isTerror = string.find(name, "terror")
        local isShip = string.find(name, "ship")
        local isPiranha = string.find(name, "piranha")

        local isValid = (isSB and Config.HuntSeaBeast) or 
                        (isTerror and Config.HuntTerrorShark) or 
                        (isShip and Config.HuntGhostShip) or 
                        (isPiranha and Config.HuntPiranha)

        if isValid then
            local hum = enemy:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local root = enemy:FindFirstChild("Head") or enemy:FindFirstChild("HumanoidRootPart") or enemy:FindFirstChildWhichIsA("BasePart")
                if root then
                    local pVal = isSB and 1 or (isTerror and 2 or 3)
                    table.insert(candidates, {
                        Entity = enemy,
                        Root = root,
                        Health = hum.Health,
                        Priority = pVal
                    })
                end
            end
        end
    end

    if #candidates == 0 then return nil, nil end
    table.sort(candidates, function(a, b)
        if a.Priority == b.Priority then return a.Health < b.Health end
        return a.Priority < b.Priority
    end)
    return candidates[1].Entity, candidates[1].Root
end

