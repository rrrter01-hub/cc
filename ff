RunService.RenderStepped:Connect(function()
    if not Config.EnableESP then
        for _, esp in pairs(ESPObjects) do
            esp.Billboard.Enabled = false
            esp.Highlight.Enabled = false
        end
        return
    end

    for player, esp in pairs(ESPObjects) do
        local char = GetChar(player)
        local root = GetRoot(char)
        local hum = GetHum(char)

        if char and root and hum and hum.Health > 0 and char.Parent then
            esp.Billboard.Adornee = root
            esp.Billboard.Enabled = true
            esp.Highlight.Adornee = char
            esp.Highlight.Enabled = true

            local st = CheckTargetStatus(player)
            local hpPercent = math.floor((hum.Health / math.max(1, hum.MaxHealth)) * 100)

            local statusColor = "#00FF7F"
            local highlightColor = Color3.fromRGB(0, 255, 127)
            local tag = "[READY]"

            if player == AppState.SelectedPlayer then
                statusColor = "#00E5FF"
                highlightColor = Color3.fromRGB(0, 229, 255)
                tag = "[🎯 LOCKED TARGET]"
            elseif st.InSafeZone then
                statusColor = "#FFD700"
                highlightColor = Color3.fromRGB(255, 215, 0)
                tag = "[SAFE ZONE]"
            elseif not st.PvPEnabled then
                statusColor = "#FF5555"
                highlightColor = Color3.fromRGB(255, 85, 85)
                tag = "[PVP OFF]"
            elseif not st.IsAlive then
                statusColor = "#888888"
                highlightColor = Color3.fromRGB(136, 136, 136)
                tag = "[DEAD]"
            end

            esp.Highlight.FillColor = highlightColor
            esp.Highlight.OutlineColor = highlightColor

            esp.Label.Text = string.format(
                "<font color='%s'><b>%s</b></font> <font color='#FFFFFF'>Lv.%d</font><br/>" ..
                "<font color='#00FF7F'>HP: %d%%</font> | <font color='#FFD700'>%dm</font><br/>" ..
                "<font color='%s'><b>%s</b></font>",
                statusColor, player.DisplayName, st.Level,
                hpPercent, st.Distance,
                statusColor, tag
            )
        else
            esp.Billboard.Enabled = false
            esp.Highlight.Enabled = false
        end
    end
end)

