-- Target Selector
local function GetClosestTarget()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = myChar.HumanoidRootPart.Position

    local bestTarget = nil
    local shortestDist = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character:FindFirstChild("HumanoidRootPart") then
            local hum = player.Character.Humanoid
            local hrp = player.Character.HumanoidRootPart
            
            if hum.Health > 0 then
                local dist = (hrp.Position - myPos).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    bestTarget = player
                end
            end
        end
    end
    return bestTarget
end

-- Tween Movement Engine
local function TweenToCFrame(targetCFrame, speed)
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    local hrp = myChar.HumanoidRootPart

    local distance = (targetCFrame.Position - hrp.Position).Magnitude
    local duration = distance / math.max(speed, 50)

    if State.ActiveTween then
        State.ActiveTween:Cancel()
    end

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    State.ActiveTween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    State.ActiveTween:Play()
    return State.ActiveTween
end

-- Auto Haki Helper
local function CheckHaki()
    local char = LocalPlayer.Character
    if not char then return end
    if State.AutoHaki and not char:FindFirstChild("HasBuso") then
        local remote = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes") and game:GetService("ReplicatedStorage").Remotes:FindFirstChild("CommF_")
        if remote then
            pcall(function() remote:InvokeServer("Buso") end)
        end
    end
end

-- Low HP Escape Watcher
local function SetupHealthMonitor(char)
    local hum = char:WaitForChild("Humanoid")
    hum.HealthChanged:Connect(function(hp)
        local hpPercent = (hp / hum.MaxHealth) * 100
        if State.SkyEscape and hpPercent <= State.EscapeHP and not State.IsEscaping and State.AutoBounty then
            State.IsEscaping = true
            State.CurrentTarget = nil
            
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local skyCFrame = CFrame.new(hrp.Position.X, hrp.Position.Y + 2500, hrp.Position.Z)
                TweenToCFrame(skyCFrame, 400)
            end
            
            -- Wait for regeneration
            task.spawn(function()
                while hum.Health < hum.MaxHealth * 0.85 do
                    task.wait(1)
                end
                State.IsEscaping = false
            end)
        end
    end)
end

if LocalPlayer.Character then
    SetupHealthMonitor(LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(SetupHealthMonitor)

-- Main Heartbeat Execution Loop
RunService.Heartbeat:Connect(function()
    if not State.AutoBounty or State.IsEscaping then return end

    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") or not myChar:FindFirstChild("Humanoid") then return end
    if myChar.Humanoid.Health <= 0 then return end

    -- Verify or acquire target
    if not State.CurrentTarget or not State.CurrentTarget.Character or not State.CurrentTarget.Character:FindFirstChild("Humanoid") or State.CurrentTarget.Character.Humanoid.Health <= 0 then
        State.CurrentTarget = GetClosestTarget()
        return
    end

    local targetHrp = State.CurrentTarget.Character:FindFirstChild("HumanoidRootPart")
    if not targetHrp then return end

    -- Maintain position above target
    local desiredPos = targetHrp.Position + Vector3.new(0, State.TargetDistance, 0)
    local targetCFrame = CFrame.new(desiredPos, targetHrp.Position)
    
    local myHrp = myChar.HumanoidRootPart
    if (myHrp.Position - desiredPos).Magnitude > 50 then
        TweenToCFrame(targetCFrame, State.FlySpeed)
    else
        myHrp.CFrame = targetCFrame
        myHrp.Velocity = Vector3.zero
    end

    -- Aim Lock
    if State.AimLock then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHrp.Position)
    end

    CheckHaki()
end)

