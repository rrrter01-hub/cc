-- Function to Render Player Row
local function RenderRadarRows()
    for _, child in ipairs(ScrollList:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local st = CheckTargetStatus(player)
            local pBounty = GetPlayerBounty(player)

            local Row = Instance.new("Frame")
            Row.Size = UDim2.new(1, -8, 0, 42)
            Row.BackgroundColor3 = (AppState.SelectedPlayer == player) and Color3.fromRGB(45, 60, 95) or Color3.fromRGB(19, 23, 33)
            Row.Parent = ScrollList
            Instance.new("UICorner", Row).CornerRadius = UDim.new(0, 6)

            local statusTag = st.InSafeZone and "<font color='#FFD700'>[SAFE ZONE]</font>"
                or (not st.PvPEnabled and "<font color='#888888'>[PVP OFF]</font>")
                or "<font color='#00FF7F'>[READY]</font>"

            local Info = Instance.new("TextLabel")
            Info.Size = UDim2.new(0.58, 0, 1, 0)
            Info.Position = UDim2.new(0, 8, 0, 0)
            Info.BackgroundTransparency = 1
            Info.RichText = true
            Info.Font = Enum.Font.Gotham
            Info.TextSize = IsMobile and 10 or 11
            Info.TextColor3 = Color3.fromRGB(240, 240, 240)
            Info.TextXAlignment = Enum.TextXAlignment.Left
            Info.Text = string.format("<b>%s</b> %s<br/>Bounty: %s | HP: %d%% | %dm", 
                player.DisplayName, statusTag, tostring(pBounty), math.floor((st.Health/math.max(1, st.MaxHealth))*100), st.Distance)
            Info.Parent = Row

            -- Spy Cam Button
            local SpyBtn = Instance.new("TextButton")
            SpyBtn.Size = UDim2.new(0, IsMobile and 46 or 52, 0, 26)
            SpyBtn.Position = UDim2.new(0.60, 0, 0.5, -13)
            SpyBtn.BackgroundColor3 = Color3.fromRGB(48, 85, 150)
            SpyBtn.Text = (AppState.IsSpectating and AppState.SelectedPlayer == player) and "UNSPY" or "SPY"
            SpyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            SpyBtn.Font = Enum.Font.GothamBold
            SpyBtn.TextSize = 10
            SpyBtn.Parent = Row
            Instance.new("UICorner", SpyBtn).CornerRadius = UDim.new(0, 4)

            SpyBtn.MouseButton1Click:Connect(function()
                if AppState.IsSpectating and AppState.SelectedPlayer == player then
                    Camera.CameraSubject = GetHum(GetChar(LocalPlayer))
                    AppState.IsSpectating = false
                    SpyBtn.Text = "SPY"
                else
                    local targetHum = GetHum(GetChar(player))
                    if targetHum then
                        Camera.CameraSubject = targetHum
                        AppState.IsSpectating = true
                        AppState.SelectedPlayer = player
                        SpyBtn.Text = "UNSPY"
                    end
                end
            end)

            -- Select Button
            local SelBtn = Instance.new("TextButton")
            SelBtn.Size = UDim2.new(0, IsMobile and 54 or 60, 0, 26)
            SelBtn.Position = UDim2.new(IsMobile and 0.77 or 0.80, 0, 0.5, -13)
            SelBtn.BackgroundColor3 = st.CanAttack and Color3.fromRGB(0, 160, 90) or Color3.fromRGB(70, 75, 85)
            SelBtn.Text = (AppState.SelectedPlayer == player) and "LOCKED" or "SELECT"
            SelBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            SelBtn.Font = Enum.Font.GothamBold
            SelBtn.TextSize = 10
            SelBtn.Parent = Row
            Instance.new("UICorner", SelBtn).CornerRadius = UDim.new(0, 4)

            SelBtn.MouseButton1Click:Connect(function()
                AppState.SelectedPlayer = player
                StatusLabel.Text = string.format("Target: %s (%s)", player.DisplayName, st.CanAttack and "Ready" or "Safe/Off")
                RenderRadarRows()
            end)
        end
    end
    ScrollList.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 10)
end

