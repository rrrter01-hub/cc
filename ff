-- 5. STATE MACHINE (MAIN HUNTER LOOP)
-- =========================================================================
local function setState(newState)
    print(string.format("[Sea Hunter] %s ➔ %s", State.Current, newState))
    State.Current = newState
    State.StateStartTime = os.time()
end

task.spawn(function()
    print("[+] Pure Sea Beast Hunter Active!")

    while task.wait(0.1) do
        if Config.Enabled then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChild("Humanoid")
                if not (hrp and hum and hum.Health > 0) then return end

                -- Watchdog Recovery (กันค้างเกิน 45 วิ)
                if (os.time() - State.StateStartTime) > Config.WatchdogTimeout then
                    if State.Current ~= "STAGE_5_COMBAT" then
                        warn("[Watchdog] State timeout! Triggering Emergency Reset...")
                        cancelTween()
                        setState("STAGE_6_RESET")
                        return
                    end
                end

                -- STAGE 1: ซื้อเรือที่เกาะ Tiki
                if State.Current == "STAGE_1_PREPARE" then
                    smoothMoveTo(WAYPOINTS.TikiPort + Vector3.new(0, 10, 0), 280)
                    task.wait(0.5)
                    pcall(function() CommF:InvokeServer("BuyBoat", Config.BoatType) end)
                    task.wait(1)
                    State.SailingStartTime = os.time()
                    setState("STAGE_2_TRANSIT")

                -- STAGE 2: เดินทางผ่าน Waypoints สู่ Danger Zone 6
                elseif State.Current == "STAGE_2_TRANSIT" then
                    local entity, root = scanSeaTargets()
                    if entity and root then
                        cancelTween()
                        State.TargetEntity = entity
                        State.TargetRootPart = root
                        setState("STAGE_5_COMBAT")
                        return
                    end

                    smoothMoveTo(WAYPOINTS.Zone1_Entry, Config.TweenSpeed)
                    smoothMoveTo(WAYPOINTS.Zone2_3, Config.TweenSpeed)
                    smoothMoveTo(WAYPOINTS.Zone4_5, Config.TweenSpeed)
                    smoothMoveTo(WAYPOINTS.Zone6_Apex, Config.TweenSpeed)
                    setState("STAGE_3_PATROL")

                -- STAGE 3: ลาดตระเวน Danger Zone 6
                elseif State.Current == "STAGE_3_PATROL" then
                    local entity, root = scanSeaTargets()
                    if entity and root then
                        cancelTween()
                        State.TargetEntity = entity
                        State.TargetRootPart = root
                        setState("STAGE_5_COMBAT")
                    else
                        local patrolOffset = Vector3.new(math.random(-400, 400), 0, math.random(-400, 400))
                        smoothMoveTo(WAYPOINTS.Zone6_Apex + patrolOffset, 160)
                        task.wait(1.5)
                    end

                -- STAGE 5: ลอยตัวล็อกเป้าสู้เจ้าทะเล
                elseif State.Current == "STAGE_5_COMBAT" then
                    local target = State.TargetEntity
                    local root = State.TargetRootPart
                    if target and target:FindFirstChild("Humanoid") and target.Humanoid.Health > 0 and root then
                        local safeHover = root.Position + Vector3.new(0, Config.SafeCombatHeight, 0)
                        hrp.CFrame = CFrame.lookAt(safeHover, root.Position)
                        hrp.Velocity = Vector3.zero
                        equipWeapon()
                        executeCombatCombo(root)
                    else
                        local nextEntity, nextRoot = scanSeaTargets()
                        if nextEntity and nextRoot then
                            State.TargetEntity = nextEntity
                            State.TargetRootPart = nextRoot
                            State.StateStartTime = os.time()
                        else
                            setState("STAGE_6_RESET")
                        end
                    end

                -- STAGE 6: รับรางวัลและรีเซ็ตลูป
                elseif State.Current == "STAGE_6_RESET" then
                    State.TargetEntity = nil
                    State.TargetRootPart = nil
                    cancelTween()
                    task.wait(2)
                    setState("STAGE_1_PREPARE")
                end
            end)
        end
    end
end)

