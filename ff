-- 5. SUBSYSTEM: COMBAT & AIM EXECUTION
-- =========================================================================
local function equipSelectedWeapon()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    if not hum then return end

    local targetType = Config.SelectedWeapon

    for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            if targetType == "Melee" and item.ToolTip == "Melee" then
                hum:EquipTool(item)
                return
            elseif targetType == "Sword" and item.ToolTip == "Sword" then
                hum:EquipTool(item)
                return
            elseif targetType == "Fruit" and (item.ToolTip == "Blox Fruit" or string.find(item.Name, "Fruit")) then
                hum:EquipTool(item)
                return
            end
        end
    end
end

local function executeCombatCombo(targetRoot)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (hrp and targetRoot) then return end

    -- 1. บังคับล็อกมุมมองก้มลงหาหัวเจ้าทะเล 90 องศา (Raycast Aim Lock)
    hrp.CFrame = CFrame.lookAt(hrp.Position, targetRoot.Position)

    -- 2. โจมตีธรรมดา (M1 Attack)
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))

    -- 3. สแปมสกิล Z, X, C, V (เว้นจังหวะ Cooldown)
    if Config.AutoSkills then
        local skills = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
        for _, key in ipairs(skills) do
            VirtualInputManager:SendKeyEvent(true, key, false, game)
            task.wait(0.06)
            VirtualInputManager:SendKeyEvent(false, key, false, game)
            task.wait(0.12)
        end
    end
end

-- =========================================================================
-- 6. STATE MACHINE ENGINE (MAIN LOOP & WATCHDOG)
-- =========================================================================
local function setState(newState)
    print(string.format("[Sea Hunter] Transition: %s ➔ %s", State.Current, newState))
    State.Current = newState
    State.StateStartTime = os.time()
end

task.spawn(function()
    print("[+] Zero-Bug Auto Sea Beast Hunter Engine v4.0 Active!")

    while task.wait(0.1) do
        if Config.Enabled then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChild("Humanoid")

                if not (hrp and hum and hum.Health > 0) then return end

                -- ---------------------------------------------------------
                -- WATCHDOG RECOVERY TIMER (ระบบกันติดลูป / ค้าง)
                -- ---------------------------------------------------------
                if (os.time() - State.StateStartTime) > Config.WatchdogTimeout then
                    if State.Current ~= "STAGE_5_COMBAT" then
                        warn("[Watchdog] State timeout! Triggering Emergency Reset...")
                        cancelCurrentTween()
                        setState("STAGE_6_RESET")
                        return
                    end
                end

                -- ---------------------------------------------------------
                -- STAGE 1: PREPARATION (เตรียมตัวที่ท่าเรือ Tiki)
                -- ---------------------------------------------------------
                if State.Current == "STAGE_1_PREPARE" then
                    smoothMoveTo(WAYPOINTS.TikiPort + Vector3.new(0, 10, 0), 280)
                    task.wait(0.5)

                    -- ซื้อเรือ
                    pcall(function()
                        CommF:InvokeServer("BuyBoat", Config.BoatType)
                    end)
                    task.wait(1)

                    setState("STAGE_2_TRANSIT")

                -- ---------------------------------------------------------
                -- STAGE 2: OCEAN TRANSIT (แล่นเรือผ่าน Waypoints สู่ Zone 6)
                -- ---------------------------------------------------------
                elseif State.Current == "STAGE_2_TRANSIT" then
                    local entity, root = scanSeaTargets()
                    if entity and root then
                        cancelCurrentTween()
                        State.TargetEntity = entity
                        State.TargetRootPart = root
                        setState("STAGE_5_COMBAT")
                        return
                    end

                    smoothMoveTo(WAYPOINTS.Zone1_Entry, Config.TweenSpeed)
                    smoothMoveTo(WAYPOINTS.Zone2_3, Config.TweenSpeed)
                    smoothMoveTo(WAYPOINTS.Zone4_5, Config.TweenSpeed)
                    smoothMoveTo(WAYPOINTS.Zone6_Apex, Config.TweenSpeed)

                    setState("STAGE_3_PATROL")

                -- ---------------------------------------------------------
                -- STAGE 3: PATROL & SPAWN (ลาดตระเวน Danger Zone 6)
                -- ---------------------------------------------------------
                elseif State.Current == "STAGE_3_PATROL" then
                    local entity, root = scanSeaTargets()
                    if entity and root then
                        cancelCurrentTween()
                        State.TargetEntity = entity
                        State.TargetRootPart = root
                        setState("STAGE_5_COMBAT")
                    else
                        local patrolOffset = Vector3.new(math.random(-400, 400), 0, math.random(-400, 400))
                        local targetPatrol = WAYPOINTS.Zone6_Apex + patrolOffset
                        smoothMoveTo(targetPatrol, 160)
                        task.wait(1.5)
                    end

                -- ---------------------------------------------------------
                -- STAGE 5: COMBAT EXECUTION (สู้และล็อกเป้าเจ้าทะเล)
                -- ---------------------------------------------------------
                elseif State.Current == "STAGE_5_COMBAT" then
                    local target = State.TargetEntity
                    local targetRoot = State.TargetRootPart

                    if target and target:FindFirstChild("Humanoid") and target.Humanoid.Health > 0 and targetRoot then
                        local safeHoverPos = targetRoot.Position + Vector3.new(0, Config.SafeCombatHeight, 0)
                        hrp.CFrame = CFrame.lookAt(safeHoverPos, targetRoot.Position)
                        hrp.Velocity = Vector3.zero

                        equipSelectedWeapon()
                        executeCombatCombo(targetRoot)
                    else
                        print("[Combat] เป้าหมายถูกกำจัดเรียบร้อย!")
                        
                        -- ตรวจสอบกรณีเกิด 3 ตัวพร้อมกัน (Rumbling Waters)
                        local nextEntity, nextRoot = scanSeaTargets()
                        if nextEntity and nextRoot then
                            print("[Combat] พบเจ้าทะเลตัวถัดไป! ทำการล็อกเป้าต่อทันที...")
                            State.TargetEntity = nextEntity
                            State.TargetRootPart = nextRoot
                            State.StateStartTime = os.time()
                        else
                            setState("STAGE_6_RESET")
                        end
                    end

                -- ---------------------------------------------------------
                -- STAGE 6: REWARD & RESET (รับรางวัลและรีเซ็ต)
                -- ---------------------------------------------------------
                elseif State.Current == "STAGE_6_RESET" then
                    State.TargetEntity = nil
                    State.TargetRootPart = nil
                    cancelCurrentTween()
                    task.wait(2) -- รอรับ Beli / Fragments

                    setState("STAGE_1_PREPARE")
                end
            end)
        end
    end
end)

