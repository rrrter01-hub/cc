-- MAIN STATE LOOP (NO BOAT REQUIRED)
-- =========================================================================
task.spawn(function()
    print("[+] No-Boat Direct Sea Hunter Started!")

    while task.wait(0.1) do
        if Config.Enabled then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChild("Humanoid")
                if not (hrp and hum and hum.Health > 0) then return end

                -- STAGE 1: บินตรงสู่ Danger Zone 6
                if State.Current == "STAGE_1_FLY_TO_ZONE6" then
                    local boss, root = scanSeaBoss()
                    if boss and root then
                        cancelTween()
                        State.TargetEntity = boss
                        State.TargetRootPart = root
                        State.Current = "STAGE_3_COMBAT"
                        return
                    end

                    smoothFly(ZONE_6_TARGET, Config.TweenSpeed)
                    State.SailingStartTime = os.time()
                    State.Current = "STAGE_2_PATROL_ZONE6"

                -- STAGE 2: ลอยตัววนรอบ Danger Zone 6 รอเกิด
                elseif State.Current == "STAGE_2_PATROL_ZONE6" then
                    local boss, root = scanSeaBoss()
                    if boss and root then
                        cancelTween()
                        State.TargetEntity = boss
                        State.TargetRootPart = root
                        State.Current = "STAGE_3_COMBAT"
                    else
                        -- ขยับวนไปมาเล็กน้อยในรัศมี 500 studs เพื่อ Trigger Spawn
                        local offset = Vector3.new(math.random(-300, 300), 0, math.random(-300, 300))
                        smoothFly(ZONE_6_TARGET + offset, 160)
                        task.wait(1.5)
                    end

                -- STAGE 3: สู้เจ้าทะเล
                elseif State.Current == "STAGE_3_COMBAT" then
                    local target = State.TargetEntity
                    local root = State.TargetRootPart
                    if target and target:FindFirstChild("Humanoid") and target.Humanoid.Health > 0 and root then
                        local safeHover = root.Position + Vector3.new(0, Config.SafeCombatHeight, 0)
                        hrp.CFrame = CFrame.lookAt(safeHover, root.Position)
                        hrp.Velocity = Vector3.zero
                        equipWeapon()
                        attackCombo(root)
                    else
                        -- ตรวจสอบตัวถัดไป (Rumbling Waters)
                        local nextBoss, nextRoot = scanSeaBoss()
                        if nextBoss and nextRoot then
                            State.TargetEntity = nextBoss
                            State.TargetRootPart = nextRoot
                        else
                            task.wait(2) -- รอรับ Beli
                            State.TargetEntity = nil
                            State.TargetRootPart = nil
                            State.Current = "STAGE_2_PATROL_ZONE6"
                        end
                    end
                end
            end)
        end
    end
end)

