-- =========================================================================
-- SMART BOUNTY ELIGIBILITY & YIELD ENGINE
-- =========================================================================
local function CheckBountyEligibility(player, myLevel, targetLevel, targetBounty)
    if not player or player == LocalPlayer then
        return false, 0, "Self"
    end

    -- 1. ตรวจสอบทีม Marine vs Marine (ทหารเรือฆ่าทหารเรือไม่ได้ค่าหัว)
    if LocalPlayer.Team and player.Team then
        if LocalPlayer.Team.Name == "Marines" and player.Team.Name == "Marines" then
            return false, 0, "Same Marine Team (0 Bounty)"
        end
    end

    -- 2. ตรวจสอบความต่างของเลเวล (Level Difference Check)
    -- กฎ Blox Fruits: ถ้าเลเวลเป้าหมายต่ำกว่าเลเวลเราเกิน 200 จะถือเป็น Suspicious Kill ไม่ได้ค่าหัว
    local minEligibleLevel = math.max(20, myLevel - Config.MaxLevelDiff)
    if targetLevel < minEligibleLevel then
        return false, 0, string.format("Level Too Low (Min: Lv.%d)", minEligibleLevel)
    end

    -- 3. ตรวจสอบระบบ 3/3 Kills Cooldown (ฆ่าซ้ำในเซิร์ฟเดิม)
    local history = PlayerKillHistory[player.UserId]
    if history then
        local timePassed = tick() - history.LastKillTick
        if timePassed < Config.TargetCooldownTime then
            if history.Kills >= Config.MaxKillsPerTarget then
                local remainingSec = math.ceil(Config.TargetCooldownTime - timePassed)
                return false, 0, string.format("Kill Limit (3/3) Cooldown (%ds)", remainingSec)
            end
        else
            -- พ้นระยะเวลา 15 นาที ให้รีเซ็ตประวัติการฆ่า
            PlayerKillHistory[player.UserId] = nil
        end
    end

    -- 4. คำนวณยอด Bounty โดยประมาณที่จะได้รับ (+Est. Bounty)
    -- มาตรฐาน Blox Fruits: จะได้ประมาณ 0.5% - 1.2% ของค่าหัวเป้าหมาย หรือคิดตามฐานเลเวล (เฉลี่ย 8,000 - 25,000 ต่อคิล)
    local estReward = 0
    if targetBounty and targetBounty > 0 then
        local rawReward = math.floor(targetBounty * 0.008)
        estReward = math.clamp(rawReward, 7500, 25000)
    else
        estReward = math.clamp(math.floor(targetLevel * 8), 5000, 15000)
    end

    return true, estReward, "Eligible"
end

-- =========================================================================
-- STATUS CACHE & TARGET VALIDATION
-- =========================================================================
local StatusCache = {}

local function RefreshTargetStatus(player)
    local myLevel = GetPlayerLevel(LocalPlayer)
    local targetLevel = GetPlayerLevel(player)
    local targetBounty = GetPlayerBounty(player)

    local isEligible, estBounty, bountyReason = CheckBountyEligibility(player, myLevel, targetLevel, targetBounty)

    local st = {
        IsAlive = false,
        InSafeZone = false,
        PvPEnabled = true,
        Health = 0,
        MaxHealth = 100,
        Distance = 0,
        Level = targetLevel,
        Bounty = targetBounty,
        WillGiveBounty = isEligible,
        EstBounty = estBounty,
        BountyReason = bountyReason,
        CanAttack = false,
        Reason = "OK",
        Char = nil,
        Root = nil,
        Hum = nil
    }

    if not player or not player.Parent then 
        st.Reason = "Invalid Target"
        StatusCache[player] = st
        return st 
    end

    local char = GetChar(player)
    local myChar = GetChar(LocalPlayer)
    local hum = GetHum(char)
    local root = GetRoot(char)
    local myRoot = GetRoot(myChar)

    st.Char = char
    st.Root = root
    st.Hum = hum

    if not char or not hum or not root or not char.Parent then 
        st.Reason = "Dead / No Character"
        StatusCache[player] = st
        return st 
    end

    st.Health = math.floor(hum.Health)
    st.MaxHealth = math.max(1, math.floor(hum.MaxHealth))
    st.IsAlive = hum.Health > 0

    if myRoot and root then
        st.Distance = math.floor((root.Position - myRoot.Position).Magnitude)
    end

    if char:FindFirstChild("SafeZoneShield") 
        or char:FindFirstChild("InSafeZone") 
        or char:FindFirstChild("ForceField")
        or char:FindFirstChild("SafeZone")
        or player:GetAttribute("InSafeZone") == true
        or player:GetAttribute("SafeZone") == true then
        st.InSafeZone = true
    end

    if char:FindFirstChild("PvPDisabled")
        or char:FindFirstChild("PVPDisabled")
        or player:FindFirstChild("PvPDisabled")
        or player:GetAttribute("PvPDisabled") == true
        or player:GetAttribute("PvP") == false then
        st.PvPEnabled = false
    end

    if not st.IsAlive then
        st.Reason = "Dead"
    elseif st.InSafeZone then
        st.Reason = "In SafeZone"
    elseif not st.PvPEnabled then
        st.Reason = "PvP Disabled"
    elseif not st.WillGiveBounty then
        st.Reason = st.BountyReason
        st.CanAttack = true -- ยังสามารถโจมตีได้ แต่ไม่มี Bounty
    else
        st.CanAttack = true
        st.Reason = "Ready for Bounty"
    end

    StatusCache[player] = st
    return st
end

task.spawn(function()
    while true do
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                RefreshTargetStatus(p)
            end
        end
        task.wait(Config.StatusCacheInterval)
    end
end)

-- =========================================================================
-- MODERN PHYSICS ENGINE (LinearVelocity & AlignOrientation)
-- =========================================================================
local function ApplyModernPhysics(myRoot)
    if not myRoot then return end
    
    local att = myRoot:FindFirstChild("BountyAtt") or Instance.new("Attachment")
    att.Name = "BountyAtt"
    att.Parent = myRoot

    local lv = myRoot:FindFirstChild("BountyLV") or Instance.new("LinearVelocity")
    lv.Name = "BountyLV"
    lv.Attachment0 = att
    lv.MaxForce = 1e7
    lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    lv.RelativeTo = Enum.ActuatorRelativeTo.World
    lv.VectorVelocity = Vector3.zero
    lv.Parent = myRoot

    local ao = myRoot:FindFirstChild("BountyAO") or Instance.new("AlignOrientation")
    ao.Name = "BountyAO"
    ao.Attachment0 = att
    ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
    ao.MaxTorque = 1e7
    ao.Responsiveness = 200
    ao.CFrame = myRoot.CFrame
    ao.Parent = myRoot
end

local function RemoveModernPhysics(myRoot)
    if not myRoot then return end
    if myRoot:FindFirstChild("BountyLV") then myRoot.BountyLV:Destroy() end
    if myRoot:FindFirstChild("BountyAO") then myRoot.BountyAO:Destroy() end
    if myRoot:FindFirstChild("BountyAtt") then myRoot.BountyAtt:Destroy() end
end

